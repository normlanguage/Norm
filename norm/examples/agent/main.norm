package agent

import openai.Agent
import openai.AgentSession
import openai.Client
import openai.ToolScope
import std.application.applicationDirectory
import std.application.arguments
import std.application.environmentVariable
import std.core.Exception
import std.io.print
import std.runtime.UpdateBatch
import std.runtime.UpdateOutcome
import std.runtime.RuntimeDiagnostic
import std.runtime.beginUpdate
import std.runtime.runtimeStatus

class RuntimeContext {
  String? previous = null

  String? context() {
    var status = runtimeStatus()
    String text = "Runtime status: published revision " + status.publishedRevision.toString()
      + "; active revision " + status.activeRevision.toString()
    for String location : status.pendingLocations { text = text + "\nPending: " + location }
    if previous == text { return null }
    previous = text
    return text
  }
}

class SourceUpdate implements ToolScope {
  UpdateBatch batch

  SourceUpdate() { this.batch = beginUpdate() }

  public String? complete() {
    var result = batch.commit()
    String outcome = switch result.outcome {
      case Published { break "Published" }
      case Unchanged { break "Unchanged" }
      case Rejected { break "Rejected" }
      case Failed { break "Failed" }
    }
    String feedback = "Runtime publication: " + outcome + "; revision " + result.revision.toString()
    for String location : result.pendingLocations { feedback = feedback + "\nPending: " + location }
    for RuntimeDiagnostic diagnostic : result.diagnostics {
      feedback = feedback + "\n" + diagnostic.severity + " " + diagnostic.code + " " + diagnostic.source
        + ":" + diagnostic.startOffset.toString() + " " + diagnostic.message
    }
    String? failure = result.failure
    if failure != null { feedback = feedback + "\n" + failure }
    return feedback
  }

  public Void close() { batch.close() }
}

ToolScope beginSourceUpdate() { return SourceUpdate() }

Void main() {
  String key = environmentVariable(name: "OPENAI_API_KEY") ?? throw Exception(message: "OPENAI_API_KEY is required")
  String model = environmentVariable(name: "OPENAI_MODEL") ?? throw Exception(message: "OPENAI_MODEL is required")
  String endpoint = environmentVariable(name: "OPENAI_BASE_URL") ?? "https://api.openai.com/v1/responses"
  var inputs = arguments()
  if inputs.isEmpty() { throw Exception(message: "Pass the task as the first application argument") }
  String directory = applicationDirectory().value
  String documentation = environmentVariable(name: "NORM_DOCUMENTATION_DIRECTORY") ?? directory + "/../../../docs/zh"
  String standardLibrary = environmentVariable(name: "NORM_STDLIB_DIRECTORY") ?? directory + "/../../stdlib/std"
  String instructions = "You are a Norm Agent running from " + directory + ". Your initial tools only read and write files. "
    + "Your own tool catalog is in tools.norm; main.norm owns your persistent conversation. Read these files before extending yourself. "
    + "Read Norm syntax at " + documentation + "/spec/language-spec.md and library references at " + documentation + "/stdlib/overview.md. "
    + "The actual standard library sources are at " + standardLibrary + ". Do not guess APIs or borrow syntax from other languages. "
    + "When a task needs a missing capability, implement an annotated Norm tool and add its function reference to tools(). "
    + "Add dependencies to module.norm and create their source under the application dependency directory when needed. "
    + "All writes from one response are published together. Runtime publication feedback follows tool outputs. "
    + "Fix rejected source using the diagnostics before using the new tool. A published revision may still have pending old continuations. "
    + "Continue until you invoke the capability you added and finish the task."
  var client = Client(apiKey: key, model: model, endpoint: endpoint)
  var runtime = RuntimeContext()
  var agent = Agent(client: client, instructions: instructions, toolProvider: tools.function,
    beginToolScope: beginSourceUpdate.function, contextProvider: runtime.context)
  var session = AgentSession()
  var response = agent.run(input: inputs[0], session: session, onText: (String text) { print(text: text) })
  printLine("")
}
