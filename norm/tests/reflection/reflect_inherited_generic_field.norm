import std.testing.expectedOutputLines

class Base<T> {
  T value

  Base(T initial) {
    value = initial
  }
}

class Child extends Base<String> {
  Integer rank

  Child(String initial, Integer initialRank) {
    super(initial: initial)
    rank = initialRank
  }
}

main() {
  for Field<Child, ?> field : Child.class.fields() {
    printLine(field.name())
    printLine(field.type().name())
    printLine(field.owner().name())
  }
  expectedOutputLines(["value", "String", "Child", "rank", "Integer", "Child"])
}
