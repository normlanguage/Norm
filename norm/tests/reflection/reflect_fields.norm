import std.annotation.FieldTarget
import std.annotation.RuntimeRetention
import std.testing.expectedOutputLines

annotation Label implements FieldTarget, RuntimeRetention {
  String text
}

value User {
  @Label(text: "user_name")
  String name
  Integer age
}

main() {
  User user = User(name: "Norm", age: 1)
  for Field<User, ?> field : User.class.fields() {
    printLine(field.name())
    printLine(field.type().name())
    printLine(field.annotation<Label>()?.text ?? "none")
  }
  printLine(User.name.field.read(receiver: user))
  printLine(User.age.field.read(receiver: user))
  expectedOutputLines([
    "name",
    "String",
    "user_name",
    "age",
    "Integer",
    "none",
    "Norm",
    "1"
  ])
}
