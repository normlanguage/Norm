import std.io.printLines
import std.testing.expectedOutputLines

Boolean longEnough(String? value) {
  return value != null && value.codePointSize() >= 3
}

Void main() {
  printLines([
    longEnough(value: null),
    longEnough(value: "abc")
  ])
  expectedOutputLines([
    "false",
    "true"
  ])
}
