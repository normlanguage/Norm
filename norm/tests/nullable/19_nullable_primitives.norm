import std.io.printLines
import std.testing.expectedOutputLines

Integer? integerIdentity(Integer? value) {
  return value
}

Boolean? booleanIdentity(Boolean? value) {
  return value
}

Void main() {
  Integer? integer = integerIdentity(null)
  Boolean? boolean = booleanIdentity(null)
  printLines([
    integer ?? 7,
    boolean ?? true
  ])
  expectedOutputLines([
    "7",
    "true"
  ])
}
