Integer? integerIdentity(Integer? value) {
  return value
}

Boolean? booleanIdentity(Boolean? value) {
  return value
}

Void main() {
  Integer? integer = integerIdentity(null)
  Boolean? boolean = booleanIdentity(null)
  printLine(integer ?? 7)
  printLine(boolean ?? true)
  expectedOutputLine("7")
  expectedOutputLine("true")
}
