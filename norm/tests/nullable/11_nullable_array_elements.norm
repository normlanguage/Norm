import std.io.printLines
import std.testing.expectedOutputLines

Void main() {
  Array<String?> values = ["first", null, "last"]
  printLines([
    values[0] ?? "missing",
    values[1] ?? "missing",
    values[2] ?? "missing"
  ])
  expectedOutputLines([
    "first",
    "missing",
    "last"
  ])
}
