import std.io.printLines
import std.testing.expectedOutputLines

class Address { String city }
class User { Address? address }

Void main() {
  User? missing = null
  User? noAddress = User(address: null)
  User? present = User(address: Address(city: "Paris"))
  printLines([
    missing?.address?.city ?? "none",
    noAddress?.address?.city ?? "none",
    present?.address?.city ?? "none"
  ])
  expectedOutputLines([
    "none",
    "none",
    "Paris"
  ])
}
