Void main() {
  Integer maximum = 9223372036854775807
  Integer minimum = -9223372036854775807
  Array<Integer> array = []
  List<String> list = List<String>()
  Map<String, Integer> map = Map<String, Integer>()
  Set<Integer> set = Set<Integer>()
  Range emptyRange = range(start: 4, end: 4)
  StringBuilder builder = StringBuilder()
  printLine(maximum)
  printLine(minimum)
  printLine("".byteSize())
  printLine("".codePointSize())
  printLine("".graphemeSize())
  printLine(array.size())
  printLine(list.size())
  printLine(map.size())
  printLine(set.size())
  printLine(emptyRange.size())
  printLine(builder.size())
  map.put(key: "edge", value: 9)
  for Pair<String, Integer> entry : map {
    printLine(entry.first)
    printLine(entry.second)
  }
  Stack<Integer> stack = Stack<Integer>()
  stack.push(3)
  stack.push(7)
  for Integer value : stack { printLine(value) }
  expectedOutputLine("9223372036854775807")
  expectedOutputLine("-9223372036854775807")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("edge")
  expectedOutputLine("9")
  expectedOutputLine("7")
  expectedOutputLine("3")
}
