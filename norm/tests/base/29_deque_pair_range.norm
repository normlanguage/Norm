import std.io.printLines
import std.testing.expectedOutputLines

main() {
  Deque<Integer> values = Deque<>()
  values.addLast(2)
  values.addFirst(1)
  values.addLast(3)
  printLines([values.removeFirst(), values.removeLast()])
  Pair<String, Integer> pair = Pair<>(first: "left", second: 9)
  printLine(pair.first)
  Range indices = Range(start: 0, end: 4)
  printLine(indices.size())
  expectedOutputLines(["1", "3", "left", "4"])
}
