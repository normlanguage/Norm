Void main() {
  Deque<Integer> values = Deque<Integer>()
  values.addLast(2)
  values.addFirst(1)
  values.addLast(3)
  printLine(values.removeFirst())
  printLine(values.removeLast())
  Pair<String, Integer> pair = Pair<String, Integer>(first: "left", second: 9)
  printLine(pair.first)
  Range indices = Range(start: 0, end: 4)
  printLine(indices.size())
  expectedOutputLine("1")
  expectedOutputLine("3")
  expectedOutputLine("left")
  expectedOutputLine("4")
}
