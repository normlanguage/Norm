Array<int> sort(Array<int> values) {
  for end : range(start: 0, end: values.size()) {
    for index : range(start: 0, end: values.size() - 1 - end) {
      if values[index] > values[index + 1] {
        int temporary = values[index]
        values[index] = values[index + 1]
        values[index + 1] = temporary
      }
    }
  }
  return values
}
void main() {
  Array<int> values = sort([5, 1, 8, 3])
  for int value : values { print(value) }
}

private void expectedOutput() {
  print("1")
  print("3")
  print("5")
  print("8")
}
