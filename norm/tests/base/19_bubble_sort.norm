import std.testing.expectedOutputLines

Array<Integer> sort(Array<Integer> values) {
  for end : range(start: 0, end: values.size()) {
    for index : range(start: 0, end: values.size() - 1 - end) {
      if values[index] > values[index + 1] {
        Integer temporary = values[index]
        values[index] = values[index + 1]
        values[index + 1] = temporary
      }
    }
  }
  return values
}
Void main() {
  Array<Integer> values = sort([5, 1, 8, 3])
  for Integer value : values { printLine(value) }
  expectedOutputLines([
    "1",
    "3",
    "5",
    "8"
  ])
}
