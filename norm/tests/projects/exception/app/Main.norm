package app

import app.errors.Failure
import app.errors.fail
import std.core.Exception

main() {
  try {
    fail(message: "specific")
  } catch Failure error {
    printLine(error.message)
  }
  try {
    fail(message: "root")
  } catch Exception error {
    printLine(error.message)
  }
  expectedOutputLine("specific")
  expectedOutputLine("root")
}
