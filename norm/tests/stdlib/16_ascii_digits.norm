Void main() {
  printLine('0'.isAsciiDigit())
  printLine('9'.isAsciiDigit())
  printLine('A'.isAsciiDigit())
  printLine('９'.isAsciiDigit())
  printLine('0'.asciiDigitValue())
  printLine('9'.asciiDigitValue())
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("false")
  expectedOutputLine("false")
  expectedOutputLine("0")
  expectedOutputLine("9")
}
