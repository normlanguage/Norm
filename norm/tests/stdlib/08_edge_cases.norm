import std.collections.listContains
import std.collections.listCount
import std.collections.toList
import std.math.abs
import std.math.clamp
import std.math.max
import std.math.min
import std.testing.equal
import std.text.join
import std.text.repeat

Void main() {
  List<Integer> empty = List<Integer>()
  List<String> single = List<String>()
  single.add("")
  printLine(equal(actual: min(left: -9223372036854775807, right: 9223372036854775807), expected: -9223372036854775807))
  printLine(equal(actual: max(left: -9223372036854775807, right: 9223372036854775807), expected: 9223372036854775807))
  printLine(equal(actual: abs(-9223372036854775807), expected: 9223372036854775807))
  printLine(equal(actual: clamp(value: 9, minimum: 4, maximum: 4), expected: 4))
  printLine(equal(actual: listContains(values: empty, target: 1), expected: false))
  printLine(equal(actual: listCount(values: empty, target: 1), expected: 0))
  printLine(equal(actual: empty.reversed().size(), expected: 0))
  printLine(equal(actual: toList<Integer>([]).size(), expected: 0))
  printLine(equal(actual: repeat(value: "Norm", count: 0), expected: ""))
  printLine(equal(actual: repeat(value: "", count: 3), expected: ""))
  printLine(equal(actual: join(values: single, separator: "anything"), expected: ""))
  printLine(equal(actual: join(values: toList<String>(["a", "b"]), separator: ""), expected: "ab"))
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
}
