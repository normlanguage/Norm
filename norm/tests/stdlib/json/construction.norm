import std.json.fromJson
import std.serialization.Serializable
import std.testing.expectedOutputLines
import std.validation.ConstraintViolation
import std.validation.Min

@Serializable()
value Score {
  @Min(value: 1)
  Integer value
}

main() {
  Score valid = "{\"value\":2}".fromJson<Score>()
  printLine(valid.value)
  try {
    "{\"value\":0}".fromJson<Score>()
  } catch ConstraintViolation error {
    printLine(error.code)
  }
  expectedOutputLines(["2", "min"])
}
