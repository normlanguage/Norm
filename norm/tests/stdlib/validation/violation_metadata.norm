import std.testing.expectedOutputLines
import std.validation.ConstraintLocation
import std.validation.ConstraintViolation
import std.validation.Negative

Void accept(@Negative() Integer amount) {
}

main() {
  try {
    accept(amount: 1)
  } catch ConstraintViolation error {
    printLine(error.location == ConstraintLocation.Parameter)
    printLine(error.parameterReference?.name() ?? "missing")
    printLine(error.functionReference?.name() ?? "missing")
    printLine(error.code)
    printLine(error.message)
  }
  expectedOutputLines(["true", "amount", "accept", "negative", "must be negative"])
}
