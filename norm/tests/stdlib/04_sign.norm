import std.math.sign
import std.testing.equal

Void main() {
  printLine(equal(actual: sign(-20), expected: -1))
  printLine(equal(actual: sign(0), expected: 0))
  printLine(equal(actual: sign(20), expected: 1))
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
}
