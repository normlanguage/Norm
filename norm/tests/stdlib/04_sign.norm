import std.io.printLines
import std.math.sign
import std.testing.equal
import std.testing.expectedOutputLines

main() {
  printLines(
    [
      equal(actual: sign(-20), expected: -1),
      equal(actual: sign(0), expected: 0),
      equal(actual: sign(20), expected: 1)
    ]
  )
  expectedOutputLines(["true", "true", "true"])
}
