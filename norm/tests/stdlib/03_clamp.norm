import std.math.clamp
import std.testing.equal

Void main() {
  printLine(equal(actual: clamp(value: -2, minimum: 0, maximum: 10), expected: 0))
  printLine(equal(actual: clamp(value: 4, minimum: 0, maximum: 10), expected: 4))
  printLine(equal(actual: clamp(value: 12, minimum: 0, maximum: 10), expected: 10))
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
}
