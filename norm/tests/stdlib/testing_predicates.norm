import std.io.printLines
import std.testing.equal
import std.testing.expectedOutputLines
import std.testing.isFalse
import std.testing.isTrue
import std.testing.notEqual

main() {
  printLines(
    [
      equal(actual: "Norm", expected: "Norm"),
      notEqual(actual: 2, expected: 3),
      isTrue(true),
      isFalse(false)
    ]
  )
  expectedOutputLines(["true", "true", "true", "true"])
}
