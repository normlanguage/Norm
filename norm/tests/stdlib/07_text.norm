import std.testing.equal
import std.text.join
import std.text.repeat

Void main() {
  printLine(equal(actual: repeat(value: "ab", count: 3), expected: "ababab"))
  List<String> values = List<String>()
  values.add("Norm")
  values.add("0.2")
  printLine(equal(actual: join(values: values, separator: " "), expected: "Norm 0.2"))
  printLine(equal(actual: join(values: List<String>(), separator: ","), expected: ""))
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
}
