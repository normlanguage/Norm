import std.io.printLines
import std.testing.expectedOutputLines

main() {
  Map<String, Integer> values = Map<>()
  values.put(key: "answer", value: 42)
  Integer? answer = values.get(key: "answer")
  Integer? missing = values.get(key: "missing")
  printLines([answer ?? -1, missing ?? -1])
  expectedOutputLines(["42", "-1"])
}
