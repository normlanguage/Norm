import std.collections.listContains
import std.collections.listCount
import std.collections.reversed
import std.collections.toList
import std.testing.equal

Void main() {
  List<Integer> values = List<Integer>()
  values.add(2)
  values.add(5)
  values.add(2)
  printLine(equal(actual: listContains(values: values, target: 5), expected: true))
  printLine(equal(actual: listCount(values: values, target: 2), expected: 2))
  List<Integer> backwards = reversed(values)
  printLine(equal(actual: backwards, expected: toList([2, 5, 2])))
  printLine(equal(actual: toList([4, 7]), expected: toList([4, 7])))
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
  expectedOutputLine("true")
}
