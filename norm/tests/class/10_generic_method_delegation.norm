import std.io.printLines
import std.testing.expectedOutputLines

class Box<T> {
  T value

  private T current() {
    return value
  }

  T replace(T next) {
    T previous = this.current()
    value = next
    return previous
  }
}

Void main() {
  Box<String> box = Box<>(value: "first")
  printLines([
    box.replace("second"),
    box.value
  ])
  expectedOutputLines([
    "first",
    "second"
  ])
}
