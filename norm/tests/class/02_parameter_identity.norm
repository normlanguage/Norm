class Counter {
  Integer value

  Void add(Integer amount) {
    value = value + amount
  }
}

Counter advance(Counter counter, Integer amount) {
  counter.add(amount)
  return counter
}

Void main() {
  Counter original = Counter(value: 1)
  Counter returned = advance(counter: original, amount: 4)
  printLine(original.value)
  printLine(original == returned)
  expectedOutputLine("5")
  expectedOutputLine("true")
}
