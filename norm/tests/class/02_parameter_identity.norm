import std.io.printLines
import std.testing.expectedOutputLines

class Counter {
  Integer value

  Void add(Integer amount) {
    value = value + amount
  }
}

Counter advance(Counter counter, Integer amount) {
  counter.add(amount)
  return counter
}

main() {
  Counter original = Counter(value: 1)
  Counter returned = advance(counter: original, amount: 4)
  printLines([original.value, original == returned])
  expectedOutputLines(["5", "true"])
}
