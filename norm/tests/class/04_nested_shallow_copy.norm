class Box {
  Integer value

  Void set(Integer next) {
    value = next
  }
}

class Holder {
  Box box
  Integer version
}

Void main() {
  Holder original = Holder(box: Box(value: 3), version: 1)
  Holder copied = original.copy()
  copied.box.set(8)
  copied.version = 2
  printLine(original.box.value)
  printLine(original.version)
  printLine(copied.version)
  expectedOutputLine("8")
  expectedOutputLine("1")
  expectedOutputLine("2")
}
