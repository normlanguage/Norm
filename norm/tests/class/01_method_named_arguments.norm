import std.io.printLines
import std.testing.expectedOutputLines

class Point {
  Integer x
  Integer y

  Void move(Integer dx, Integer dy) {
    x = x + dx
    y = y + dy
  }
}

Void main() {
  Point point = Point(x: 1, y: 2)
  point.move(dy: 4, dx: 3)
  printLines([
    point.x,
    point.y
  ])
  expectedOutputLines([
    "4",
    "6"
  ])
}
