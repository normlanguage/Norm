class Counter {
  Integer value

  private Void add(Integer amount) {
    value = value + amount
  }

  Void addTwice(Integer amount) {
    this.add(amount)
    this.add(amount)
  }

  Integer current() {
    return value
  }
}

Void main() {
  Counter counter = Counter(value: 1)
  counter.addTwice(4)
  printLine(counter.current())
  expectedOutputLine("9")
}
