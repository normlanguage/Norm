class Box {
  int value

  void set(int next) {
    value = next
  }
}

void main() {
  Box box = Box(value: 1)
  List<Box> first = List<Box>()
  first.add(box)

  List<Box> second = first
  second.add(Box(value: 2))

  Box fromSecond = second[0]
  fromSecond.set(7)
  Box fromFirst = first[0]

  print(first.size())
  print(second.size())
  print(fromFirst.value)
  print(fromFirst == fromSecond)
}

private void expectedOutput() {
  print("1")
  print("2")
  print("7")
  print("true")
}
