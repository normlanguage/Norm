class Box {
  Integer value

  Void set(Integer next) {
    value = next
  }
}

Void main() {
  Box box = Box(value: 1)
  List<Box> first = List<Box>()
  first.add(box)

  List<Box> second = first
  second.add(Box(value: 2))

  Box fromSecond = second[0]
  fromSecond.set(7)
  Box fromFirst = first[0]

  printLine(first.size())
  printLine(second.size())
  printLine(fromFirst.value)
  printLine(fromFirst == fromSecond)
  expectedOutputLine("1")
  expectedOutputLine("2")
  expectedOutputLine("7")
  expectedOutputLine("true")
}
