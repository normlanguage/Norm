import std.io.printLines
import std.testing.expectedOutputLines

class Box {
  Integer value

  Void set(Integer next) {
    value = next
  }
}

Void main() {
  Box box = Box(value: 1)
  List<Box> first = List<>()
  first.add(box)

  List<Box> second = first
  second.add(Box(value: 2))

  Box fromSecond = second[0]
  fromSecond.set(7)
  Box fromFirst = first[0]

  printLines([
    first.size(),
    second.size(),
    fromFirst.value,
    fromFirst == fromSecond
  ])
  expectedOutputLines([
    "1",
    "2",
    "7",
    "true"
  ])
}
