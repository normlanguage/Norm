class Box {
  int value

  void set(int next) {
    value = next
  }
}

void main() {
  Box box = Box(value: 1)
  List first = List()
  first.add(box)

  List second = first
  second.add(Box(value: 2))

  Box fromSecond = second[0]
  fromSecond.set(7)
  Box fromFirst = first[0]

  print(first.length)
  print(second.length)
  print(fromFirst.value)
  print(fromFirst == fromSecond)
}
