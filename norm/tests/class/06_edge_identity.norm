import std.io.printLines
import std.testing.expectedOutputLines

class Box {
  Long value
}

class Holder {
  Box box
}

Void main() {
  Box original = Box(value: 9223372036854775807)
  Box alias = original
  Box copied = original.copy()
  Holder holder = Holder(box: original)
  Holder holderCopy = holder.copy()
  List<Box> empty = List<>()
  printLines([
    alias == original,
    copied == original,
    holderCopy == holder,
    holderCopy.box == holder.box,
    empty.size()
  ])
  expectedOutputLines([
    "true",
    "false",
    "false",
    "true",
    "0"
  ])
}
