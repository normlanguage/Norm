class Box {
  Integer value
}

class Holder {
  Box box
}

Void main() {
  Box original = Box(value: 9223372036854775807)
  Box alias = original
  Box copied = original.copy()
  Holder holder = Holder(box: original)
  Holder holderCopy = holder.copy()
  List<Box> empty = List<Box>()
  printLine(alias == original)
  printLine(copied == original)
  printLine(holderCopy == holder)
  printLine(holderCopy.box == holder.box)
  printLine(empty.size())
  expectedOutputLine("true")
  expectedOutputLine("false")
  expectedOutputLine("false")
  expectedOutputLine("true")
  expectedOutputLine("0")
}
