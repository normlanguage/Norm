import std.io.printLines
import std.testing.expectedOutputLines

class Box {
  Integer value

  Void set(Integer next) {
    value = next
  }
}

main() {
  Box original = Box(value: 4)
  Box copied = original.copy()
  copied.set(9)
  printLines([original.value, copied.value, original == copied, original != copied])
  expectedOutputLines(["4", "9", "false", "true"])
}
