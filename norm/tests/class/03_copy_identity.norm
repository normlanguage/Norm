class Box {
  Integer value

  Void set(Integer next) {
    value = next
  }
}

Void main() {
  Box original = Box(value: 4)
  Box copied = original.copy()
  copied.set(9)
  printLine(original.value)
  printLine(copied.value)
  printLine(original == copied)
  printLine(original != copied)
  expectedOutputLine("4")
  expectedOutputLine("9")
  expectedOutputLine("false")
  expectedOutputLine("true")
}
