import std.annotation.FieldInterceptor
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

annotation Wrap implements FieldInterceptor<String>, SourceRetention {
  String before(FieldContext context, String value) {
    printLine(context.field().name())
    return "[" + value + "]"
  }
}

class Base {
  @Wrap()
  String name

  Base(String initial) {
    name = initial
  }
}

class Child extends Base {
  @Wrap()
  String detail

  Child(String initial) {
    super(initial: initial)
    detail = initial
  }
}

main() {
  Child child = Child(initial: "created")
  printLine(child.name)
  printLine(child.detail)
  child.name = "assigned"
  printLine(child.name)
  expectedOutputLines([
    "name", "detail", "[created]", "[created]",
    "name", "[assigned]"
  ])
}
