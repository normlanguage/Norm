import std.annotation.FunctionTarget
import std.annotation.SourceRetention
import std.core.Exception
import std.testing.expectedOutputLines

class Failure extends Exception {
  Failure(String message) {
    super(message: message)
  }
}

annotation Trace implements FunctionTarget, SourceRetention {
  Void after(FunctionContext context, FunctionCompletion completion) {
    throw Failure(message: "after-failed")
  }
}

@Trace()
Void run() {
  printLine("body")
  throw Failure(message: "body-failed")
}

main() {
  try {
    run()
  } catch Failure error {
    printLine(error.message)
  }
  expectedOutputLines(["body", "after-failed"])
}

