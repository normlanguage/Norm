import std.annotation.ParameterInterceptor
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

annotation Mark implements ParameterInterceptor<String>, SourceRetention {
  String before(ParameterContext context, String value) {
    printLine(context.parameter().function().name())
    printLine(context.parameter().name())
    return "[" + value + "]"
  }

  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine(context.parameter().name())
    printLine(completion.succeeded())
  }
}

String echo(@Mark() String value) {
  printLine(value)
  return value
}

main() {
  printLine(echo(value: "parameter"))
  expectedOutputLines(["echo", "value", "[parameter]", "value", "true", "[parameter]"])
}
