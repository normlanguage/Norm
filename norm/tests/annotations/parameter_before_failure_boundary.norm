import std.annotation.ParameterInterceptor
import std.annotation.SourceRetention
import std.core.Exception
import std.testing.expectedOutputLines

class Failure extends Exception {
  Failure(String message) {
    super(message: message)
  }
}

annotation Outer implements ParameterInterceptor<String>, SourceRetention {
  String before(ParameterContext context, String value) {
    printLine("outer before")
    return value
  }

  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine("outer after")
    printLine(completion.succeeded())
  }
}

annotation Reject implements ParameterInterceptor<String>, SourceRetention {
  String before(ParameterContext context, String value) {
    printLine("reject before")
    throw Failure(message: value)
  }

  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine("reject after")
  }
}

Void run(@Outer() @Reject() String value) {
  printLine("body")
}

main() {
  try {
    run(value: "failed")
  } catch Failure error {
    printLine(error.message)
  }
  expectedOutputLines(["outer before", "reject before", "outer after", "false", "failed"])
}
