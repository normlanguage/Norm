import std.annotation.BinaryRetention
import std.annotation.FieldInterceptor
import std.testing.expectedOutputLines

annotation Mark implements FieldInterceptor<String>, BinaryRetention {
  String before(FieldContext context, String value) {
    printLine(context.field().name())
    return "[" + value + "]"
  }

  Void after(FieldContext context, FunctionCompletion completion) {
    printLine(completion.succeeded())
  }
}

class Box {
  @Mark()
  String value
}

main() {
  Box box = Box(value: "initial")
  printLine(box.value)
  box.value = "assigned"
  printLine(box.value)
  ref<String> location = &box.value
  *location = "referenced"
  printLine(box.value)
  expectedOutputLines([
    "value", "true", "[initial]",
    "value", "true", "[assigned]",
    "value", "true", "[referenced]"
  ])
}
