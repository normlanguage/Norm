import std.annotation.FunctionInterceptor
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

annotation Trace implements FunctionInterceptor, SourceRetention {
  Void before(FunctionContext context) {
    printLine("before " + context.function().name())
  }
}

class Service {
  @Trace()
  String read() {
    return "value"
  }
}

main() {
  printLine(Service().read())
  expectedOutputLines(["before read", "value"])
}
