import std.annotation.FunctionInterceptor
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

annotation Trace implements FunctionInterceptor, SourceRetention {
  Void before(FunctionContext context) {
    printLine("trace " + context.function().name())
  }
}

@Trace()
String read() {
  return "value"
}

main() {
  Function<String()> reference = read
  printLine(reference())
  expectedOutputLines(["trace read", "value"])
}
