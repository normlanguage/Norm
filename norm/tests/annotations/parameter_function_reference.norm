import std.annotation.ParameterInterceptor
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

annotation Wrap implements ParameterInterceptor<String>, SourceRetention {
  String before(ParameterContext context, String value) {
    return "[" + value + "]"
  }
}

String echo(@Wrap() String value) {
  return value
}

main() {
  Function<String(String)> reference = echo
  printLine(reference("reference"))
  expectedOutputLines(["[reference]"])
}
