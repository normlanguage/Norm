import std.annotation.RuntimeRetention
import std.annotation.TypeTarget
import std.testing.expectedOutputLines

interface ModelTarget extends TypeTarget {
}

annotation Label implements ModelTarget, RuntimeRetention {
  String text
}

@Label(text: "model")
value Model {
}

main() {
  printLine(Model.class.annotation<Label>()?.text ?? "missing")
  expectedOutputLines(["model"])
}
