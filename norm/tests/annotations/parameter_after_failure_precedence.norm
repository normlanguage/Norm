import std.annotation.ParameterTarget
import std.annotation.SourceRetention
import std.core.Exception
import std.testing.expectedOutputLines

class Failure extends Exception {
  Failure(String message) {
    super(message: message)
  }
}

annotation Outer implements ParameterTarget<String>, SourceRetention {
  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine("outer")
    printLine(completion.succeeded())
  }
}

annotation FailAfter implements ParameterTarget<String>, SourceRetention {
  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine("inner")
    printLine(completion.succeeded())
    throw Failure(message: "after-failed")
  }
}

Void run(@Outer() @FailAfter() String value) {
  printLine(value)
}

main() {
  try {
    run(value: "body")
  } catch Failure error {
    printLine(error.message)
  }
  expectedOutputLines(["body", "inner", "true", "outer", "false", "after-failed"])
}
