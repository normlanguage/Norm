import std.annotation.RuntimeRetention
import std.annotation.TypeTarget
import std.testing.expectedOutputLines

annotation Label implements TypeTarget, RuntimeRetention {
  String text

  String display() {
    return "[" + text + "]"
  }
}

main() {
  Label label = Label(text: "direct")
  printLine(label.display())
  expectedOutputLines(["[direct]"])
}

