import std.annotation.ParameterTarget
import std.annotation.SourceRetention
import std.testing.expectedOutputLines

interface Normalize<T, State> extends ParameterTarget<T> {
}

annotation Keep implements Normalize<String, Integer>, SourceRetention {
}

String echo(@Keep() String value) {
  return value
}

main() {
  printLine(echo(value: "generic"))
  expectedOutputLines(["generic"])
}
