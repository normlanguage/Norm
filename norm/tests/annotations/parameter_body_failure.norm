import std.annotation.ParameterInterceptor
import std.annotation.SourceRetention
import std.core.Exception
import std.testing.expectedOutputLines

class Failure extends Exception {
  Failure(String message) {
    super(message: message)
  }
}

annotation Observe implements ParameterInterceptor<String>, SourceRetention {
  Void after(ParameterContext context, FunctionCompletion completion) {
    printLine(context.parameter().name())
    printLine(completion.succeeded())
  }
}

Void fail(@Observe() String value) {
  throw Failure(message: value)
}

main() {
  try {
    fail(value: "failed")
  } catch Failure error {
    printLine(error.message)
  }
  expectedOutputLines(["value", "false", "failed"])
}
