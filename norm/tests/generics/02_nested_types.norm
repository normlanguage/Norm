import std.io.printLines
import std.testing.expectedOutputLines

class Box<T> {
  T value
}

main() {
  List<Pair<Integer, String>> values = List<>()
  values.add(Pair<>(first: 7, second: "seven"))
  Box<List<Pair<Integer, String>>> box = Box<>(value: values)
  printLines([box.value.size(), box.value[0].first, box.value[0].second])
  expectedOutputLines(["1", "7", "seven"])
}
