class Box<T> {
  T value
}

Void main() {
  List<Pair<Integer, String>> values = List<Pair<Integer, String>>()
  values.add(Pair<Integer, String>(first: 7, second: "seven"))
  Box<List<Pair<Integer, String>>> box = Box<List<Pair<Integer, String>>>(value: values)
  printLine(box.value.size())
  printLine(box.value[0].first)
  printLine(box.value[0].second)
  expectedOutputLine("1")
  expectedOutputLine("7")
  expectedOutputLine("seven")
}
