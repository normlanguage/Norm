class Box<T> {
  T value
}

void main() {
  List<Pair<int, String>> values = List<Pair<int, String>>()
  values.add(Pair<int, String>(first: 7, second: "seven"))
  Box<List<Pair<int, String>>> box = Box<List<Pair<int, String>>>(value: values)
  print(box.value.size())
  print(box.value[0].first)
  print(box.value[0].second)
}

private void expectedOutput() {
  print("1")
  print("7")
  print("seven")
}
