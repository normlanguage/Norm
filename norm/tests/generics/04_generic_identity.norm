import std.io.printLines
import std.testing.expectedOutputLines

class Cell<T> {
  T value

  Void set(T next) {
    value = next
  }
}

Void main() {
  Cell<Long> original = Cell<>(value: -9223372036854775807)
  Cell<Long> alias = original
  Cell<Long> copied = original.copy()
  alias.set(9223372036854775807)
  printLines([
    original.value,
    alias == original,
    copied.value,
    copied == original
  ])
  expectedOutputLines([
    "9223372036854775807",
    "true",
    "-9223372036854775807",
    "false"
  ])
}
