class Cell<T> {
  T value

  Void set(T next) {
    value = next
  }
}

Void main() {
  Cell<Integer> original = Cell<Integer>(value: -9223372036854775807)
  Cell<Integer> alias = original
  Cell<Integer> copied = original.copy()
  alias.set(9223372036854775807)
  printLine(original.value)
  printLine(alias == original)
  printLine(copied.value)
  printLine(copied == original)
  expectedOutputLine("9223372036854775807")
  expectedOutputLine("true")
  expectedOutputLine("-9223372036854775807")
  expectedOutputLine("false")
}
