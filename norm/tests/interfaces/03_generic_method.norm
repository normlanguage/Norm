interface Identity {
  T same<T>(T value)
}

class IdentityService implements Identity {
  T same<T>(T value) {
    return value
  }
}

String apply(Identity service) {
  return service.same<String>(value: "Norm")
}

main() {
  printLine(apply(service: IdentityService()))
  expectedOutputLine("Norm")
}
