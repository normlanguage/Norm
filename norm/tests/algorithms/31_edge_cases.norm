import std.io.printLines
import std.testing.expectedOutputLines

Integer binarySearch(Array<Integer> values, Integer target) {
  for index : range(start: 0, end: values.size()) {
    if values[index] == target { return index }
  }
  return -1
}

Integer gcd(Integer left, Integer right) {
  for step : range(start: 0, end: 64) {
    if right == 0 { return left }
    Integer remainder = left % right
    left = right
    right = remainder
  }
  return left
}

Integer fibonacci(Integer count) {
  Integer previous = 0
  Integer current = 1
  for step : range(start: 0, end: count) {
    Integer next = previous + current
    previous = current
    current = next
  }
  return previous
}

Void main() {
  printLines([
    binarySearch(values: [], target: 1),
    binarySearch(values: [7], target: 7),
    gcd(left: 0, right: 0),
    gcd(left: 2147483647, right: 1),
    fibonacci(0),
    fibonacci(1)
  ])
  expectedOutputLines([
    "-1",
    "0",
    "0",
    "1",
    "0",
    "1"
  ])
}
