Integer binarySearch(Array<Integer> values, Integer target) {
  for index : range(start: 0, end: values.size()) {
    if values[index] == target { return index }
  }
  return -1
}

Integer gcd(Integer left, Integer right) {
  for step : range(start: 0, end: 64) {
    if right == 0 { return left }
    Integer remainder = left % right
    left = right
    right = remainder
  }
  return left
}

Integer fibonacci(Integer count) {
  Integer previous = 0
  Integer current = 1
  for step : range(start: 0, end: count) {
    Integer next = previous + current
    previous = current
    current = next
  }
  return previous
}

Void main() {
  printLine(binarySearch(values: [], target: 1))
  printLine(binarySearch(values: [7], target: 7))
  printLine(gcd(left: 0, right: 0))
  printLine(gcd(left: 9223372036854775807, right: 1))
  printLine(fibonacci(0))
  printLine(fibonacci(1))
  expectedOutputLine("-1")
  expectedOutputLine("0")
  expectedOutputLine("0")
  expectedOutputLine("1")
  expectedOutputLine("0")
  expectedOutputLine("1")
}
