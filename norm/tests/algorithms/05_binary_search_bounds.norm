import std.io.printLines
import std.testing.expectedOutputLines

Integer lowerBound(Array<Integer> values, Integer target) {
  Integer low = 0
  Integer high = values.size()
  for low < high {
    Integer middle = low + (high - low) / 2
    if values[middle] < target {
      low = middle + 1
    } else {
      high = middle
    }
  }
  if low < values.size() && values[low] == target {
    return low
  }
  return -1
}

Integer upperBound(Array<Integer> values, Integer target) {
  Integer low = 0
  Integer high = values.size()
  for low < high {
    Integer middle = low + (high - low) / 2
    if values[middle] <= target {
      low = middle + 1
    } else {
      high = middle
    }
  }
  if low > 0 && values[low - 1] == target {
    return low - 1
  }
  return -1
}

main() {
  Array<Integer> values = [1, 2, 2, 2, 5, 8]
  printLines(
    [lowerBound(values, target: 2), upperBound(values, target: 2), lowerBound(values, target: 7)]
  )
  expectedOutputLines(["1", "3", "-1"])
}
