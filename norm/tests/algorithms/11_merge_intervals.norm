import std.math.max

class Interval {
  Integer start
  Integer end
}

List<Interval> sortIntervals(List<Interval> intervals) {
  for index : range(start: 1, end: intervals.size()) {
    Interval key = intervals[index]
    Integer position = index
    for step : range(start: 0, end: index) {
      if position > 0 {
        Interval previous = intervals[position - 1]
        if previous.start > key.start {
          intervals[position] = previous
          position = position - 1
        } else {
          break
        }
      } else {
        break
      }
    }
    intervals[position] = key
  }
  return intervals
}

List<Interval> mergeIntervals(List<Interval> intervals) {
  intervals = sortIntervals(intervals)
  List<Interval> merged = List<Interval>()
  for Interval current : intervals {
    if merged.isEmpty() {
      merged.add(current)
    } else {
      Interval previous = merged[merged.size() - 1]
      if current.start <= previous.end {
        merged.removeAt(merged.size() - 1)
        merged.add(
          Interval(
            start: previous.start,
            end: max(left: previous.end, right: current.end)
          )
        )
      } else {
        merged.add(current)
      }
    }
  }
  return merged
}

Void main() {
  List<Interval> intervals = List<Interval>()
  intervals.add(Interval(start: 8, end: 10))
  intervals.add(Interval(start: 1, end: 3))
  intervals.add(Interval(start: 15, end: 18))
  intervals.add(Interval(start: 2, end: 6))
  for Interval interval : mergeIntervals(intervals) {
    printLine(interval.start)
    printLine(interval.end)
  }
  expectedOutputLine("1")
  expectedOutputLine("6")
  expectedOutputLine("8")
  expectedOutputLine("10")
  expectedOutputLine("15")
  expectedOutputLine("18")
}
