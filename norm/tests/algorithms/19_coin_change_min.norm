import std.io.printLines
import std.math.min
import std.testing.expectedOutputLines

Integer minimumCoins(Array<Integer> coins, Integer amount) {
  List<Integer> best = List<>()
  for value : range(start: 0, end: amount + 1) { best.add(amount + 1) }
  best[0] = 0
  for value : range(start: 1, end: amount + 1) {
    for Integer coin : coins {
      if coin <= value { best[value] = min(left: best[value], right: best[value - coin] + 1) }
    }
  }
  if best[amount] > amount { return -1 }
  return best[amount]
}

Void main() {
  printLines([
    minimumCoins(coins: [1, 2, 5], amount: 11),
    minimumCoins(coins: [2], amount: 3)
  ])
  expectedOutputLines([
    "3",
    "-1"
  ])
}
