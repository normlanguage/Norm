Array<Integer> reverse(Array<Integer> values, Integer start) {
  Integer swaps = (values.size() - start) / 2
  for offset : range(start: 0, end: swaps) {
    Integer left = start + offset
    Integer right = values.size() - 1 - offset
    Integer temporary = values[left]
    values[left] = values[right]
    values[right] = temporary
  }
  return values
}

Array<Integer> nextPermutation(Array<Integer> values) {
  Integer pivot = -1
  for step : range(start: 0, end: values.size() - 1) {
    Integer index = values.size() - 2 - step
    if values[index] < values[index + 1] {
      pivot = index
      break
    }
  }
  if pivot < 0 { return reverse(values, start: 0) }
  Integer successor = values.size() - 1
  for step : range(start: 0, end: values.size()) {
    Integer index = values.size() - 1 - step
    if values[index] > values[pivot] {
      successor = index
      break
    }
  }
  Integer temporary = values[pivot]
  values[pivot] = values[successor]
  values[successor] = temporary
  return reverse(values, start: pivot + 1)
}

Void printArray(Array<Integer> values) {
  for Integer value : values { printLine(value) }
}

Void main() {
  printArray(nextPermutation([1, 2, 3]))
  printArray(nextPermutation([3, 2, 1]))
  expectedOutputLine("1")
  expectedOutputLine("3")
  expectedOutputLine("2")
  expectedOutputLine("1")
  expectedOutputLine("2")
  expectedOutputLine("3")
}
