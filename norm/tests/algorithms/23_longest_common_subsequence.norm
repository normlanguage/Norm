import std.math.max

Integer longestCommonSubsequence(Array<Integer> left, Array<Integer> right) {
  List<Integer> previous = List.filled(size: right.size() + 1, value: 0)
  for i : range(start: 1, end: left.size() + 1) {
    List<Integer> current = List.filled(size: right.size() + 1, value: 0)
    for j : range(start: 1, end: right.size() + 1) {
      if left[i - 1] == right[j - 1] {
        current[j] = previous[j - 1] + 1
      } else {
        current[j] = max(left: previous[j], right: current[j - 1])
      }
    }
    previous = current
  }
  return previous[right.size()]
}

Void main() {
  printLine(longestCommonSubsequence(left: [1, 2, 3, 4, 1], right: [3, 4, 1, 2, 1, 3]))
  printLine(longestCommonSubsequence(left: [1, 2], right: [3, 4]))
  expectedOutputLine("3")
  expectedOutputLine("0")
}
