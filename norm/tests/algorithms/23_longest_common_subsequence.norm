List zeros(int size) {
  List values = List()
  for index : range(start: 0, end: size) { values.add(0) }
  return values
}

int longestCommonSubsequence(Array left, Array right) {
  List previous = zeros(right.length + 1)
  for i : range(start: 1, end: left.length + 1) {
    List current = zeros(right.length + 1)
    for j : range(start: 1, end: right.length + 1) {
      if left[i - 1] == right[j - 1] {
        current[j] = previous[j - 1] + 1
      } else {
        current[j] = max(left: previous[j], right: current[j - 1])
      }
    }
    previous = current
  }
  return previous[right.length]
}

void main() {
  print(longestCommonSubsequence(left: [1, 2, 3, 4, 1], right: [3, 4, 1, 2, 1, 3]))
  print(longestCommonSubsequence(left: [1, 2], right: [3, 4]))
}
