import std.io.printLines
import std.testing.expectedOutputLines

Integer josephus(Integer people, Integer step) {
  Integer survivor = 0
  for size : range(start: 2, end: people + 1) {
    survivor = (survivor + step) % size
  }
  return survivor
}

main() {
  printLines([josephus(people: 7, step: 3), josephus(people: 1, step: 9)])
  expectedOutputLines(["3", "0"])
}
