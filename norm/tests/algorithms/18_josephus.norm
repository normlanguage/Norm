Integer josephus(Integer people, Integer step) {
  Integer survivor = 0
  for size : range(start: 2, end: people + 1) { survivor = (survivor + step) % size }
  return survivor
}

Void main() {
  printLine(josephus(people: 7, step: 3))
  printLine(josephus(people: 1, step: 9))
  expectedOutputLine("3")
  expectedOutputLine("0")
}
