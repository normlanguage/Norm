Pair<Integer, Integer> primeSummary(Integer limit) {
  List<Boolean> prime = List.filled(size: limit + 1, value: true)
  prime[0] = false
  prime[1] = false
  Integer candidate = 2
  for candidate * candidate <= limit {
    if prime[candidate] {
      for factor : range(start: candidate, end: limit / candidate + 1) {
        prime[candidate * factor] = false
      }
    }
    candidate = candidate + 1
  }
  Integer count = 0
  Integer last = -1
  for value : range(start: 2, end: limit + 1) {
    if prime[value] {
      count = count + 1
      last = value
    }
  }
  return Pair<Integer, Integer>(first: count, second: last)
}

Void main() {
  Pair<Integer, Integer> result = primeSummary(30)
  printLine(result.first)
  printLine(result.second)
  expectedOutputLine("10")
  expectedOutputLine("29")
}
