enum Kind { Number, Add, Subtract, Multiply, Left, Right }

class Token {
  Kind kind
  int value
}

int precedence(Kind kind) {
  if kind == Kind.Multiply { return 2 }
  if kind == Kind.Add || kind == Kind.Subtract { return 1 }
  return 0
}

Pair applyTop(Stack values, Stack operators) {
  int right = values.pop()
  int left = values.pop()
  Token operator = operators.pop()
  if operator.kind == Kind.Add { values.push(left + right) }
  if operator.kind == Kind.Subtract { values.push(left - right) }
  if operator.kind == Kind.Multiply { values.push(left * right) }
  return Pair(first: values, second: operators)
}

int evaluate(List tokens) {
  Stack values = Stack()
  Stack operators = Stack()
  for Token token : tokens {
    if token.kind == Kind.Number {
      values.push(token.value)
    } else if token.kind == Kind.Left {
      operators.push(token)
    } else if token.kind == Kind.Right {
      for step : range(start: 0, end: tokens.length) {
        Token top = operators.peek()
        if top.kind == Kind.Left { break }
        Pair state = applyTop(values, operators)
        values = state.first
        operators = state.second
      }
      operators.pop()
    } else {
      for step : range(start: 0, end: tokens.length) {
        if operators.isEmpty() { break }
        Token top = operators.peek()
        if top.kind == Kind.Left || precedence(top.kind) < precedence(token.kind) { break }
        Pair state = applyTop(values, operators)
        values = state.first
        operators = state.second
      }
      operators.push(token)
    }
  }
  for step : range(start: 0, end: tokens.length) {
    if operators.isEmpty() { break }
    Pair state = applyTop(values, operators)
    values = state.first
    operators = state.second
  }
  return values.pop()
}

void main() {
  List first = List()
  first.add(Token(kind: Kind.Number, value: 3))
  first.add(Token(kind: Kind.Add, value: 0))
  first.add(Token(kind: Kind.Number, value: 2))
  first.add(Token(kind: Kind.Multiply, value: 0))
  first.add(Token(kind: Kind.Number, value: 7))
  print(evaluate(first))

  List second = List()
  second.add(Token(kind: Kind.Left, value: 0))
  second.add(Token(kind: Kind.Number, value: 8))
  second.add(Token(kind: Kind.Subtract, value: 0))
  second.add(Token(kind: Kind.Number, value: 3))
  second.add(Token(kind: Kind.Right, value: 0))
  second.add(Token(kind: Kind.Multiply, value: 0))
  second.add(Token(kind: Kind.Number, value: 4))
  print(evaluate(second))
}
