List merge(List left, List right) {
  List result = List()
  int i = 0
  int j = 0
  for step : range(start: 0, end: left.length + right.length) {
    if i >= left.length {
      result.add(right[j])
      j = j + 1
    } else if j >= right.length {
      result.add(left[i])
      i = i + 1
    } else if left[i] <= right[j] {
      result.add(left[i])
      i = i + 1
    } else {
      result.add(right[j])
      j = j + 1
    }
  }
  return result
}

List mergeSort(List values) {
  if values.length <= 1 { return values }
  int middle = values.length / 2
  List left = List()
  List right = List()
  for index : range(start: 0, end: values.length) {
    if index < middle { left.add(values[index]) } else { right.add(values[index]) }
  }
  return merge(left: mergeSort(left), right: mergeSort(right))
}

void main() {
  List values = List()
  for int value : [7, 2, 9, 1, 5, 3] { values.add(value) }
  for int value : mergeSort(values) { print(value) }
}
