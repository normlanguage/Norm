List<int> merge(List<int> left, List<int> right) {
  List<int> result = List<int>()
  int i = 0
  int j = 0
  for step : range(start: 0, end: left.size() + right.size()) {
    if i >= left.size() {
      result.add(right[j])
      j = j + 1
    } else if j >= right.size() {
      result.add(left[i])
      i = i + 1
    } else if left[i] <= right[j] {
      result.add(left[i])
      i = i + 1
    } else {
      result.add(right[j])
      j = j + 1
    }
  }
  return result
}

List<int> mergeSort(List<int> values) {
  if values.size() <= 1 { return values }
  int middle = values.size() / 2
  List<int> left = List<int>()
  List<int> right = List<int>()
  for index : range(start: 0, end: values.size()) {
    if index < middle { left.add(values[index]) } else { right.add(values[index]) }
  }
  return merge(left: mergeSort(left), right: mergeSort(right))
}

void main() {
  List<int> values = List<int>()
  for int value : [7, 2, 9, 1, 5, 3] { values.add(value) }
  for int value : mergeSort(values) { print(value) }
}

private void expectedOutput() {
  print("1")
  print("2")
  print("3")
  print("5")
  print("7")
  print("9")
}
