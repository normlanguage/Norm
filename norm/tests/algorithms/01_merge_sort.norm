import std.testing.expectedOutputLines

List<Integer> merge(List<Integer> left, List<Integer> right) {
  List<Integer> result = List<>()
  Integer i = 0
  Integer j = 0
  for step : range(start: 0, end: left.size() + right.size()) {
    if i >= left.size() {
      result.add(right[j])
      j = j + 1
    } else if j >= right.size() {
      result.add(left[i])
      i = i + 1
    } else if left[i] <= right[j] {
      result.add(left[i])
      i = i + 1
    } else {
      result.add(right[j])
      j = j + 1
    }
  }
  return result
}

List<Integer> mergeSort(List<Integer> values) {
  if values.size() <= 1 { return values }
  Integer middle = values.size() / 2
  List<Integer> left = List<>()
  List<Integer> right = List<>()
  for index : range(start: 0, end: values.size()) {
    if index < middle { left.add(values[index]) } else { right.add(values[index]) }
  }
  return merge(left: mergeSort(left), right: mergeSort(right))
}

Void main() {
  List<Integer> values = List<>()
  for Integer value : [7, 2, 9, 1, 5, 3] { values.add(value) }
  for Integer value : mergeSort(values) { printLine(value) }
  expectedOutputLines([
    "1",
    "2",
    "3",
    "5",
    "7",
    "9"
  ])
}
