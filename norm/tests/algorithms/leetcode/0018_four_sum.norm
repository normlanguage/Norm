List<Array<Integer>> fourSum(Array<Integer> values, Integer target) {
  List<Array<Integer>> result = List<Array<Integer>>()
  Set<Array<Integer>> unique = Set<Array<Integer>>()
  for a : range(start: 0, end: values.size()) {
    for b : range(start: a + 1, end: values.size()) {
      for c : range(start: b + 1, end: values.size()) {
        for d : range(start: c + 1, end: values.size()) {
          if values[a] + values[b] + values[c] + values[d] == target {
            Array<Integer> item = [values[a], values[b], values[c], values[d]]
            for pass : range(start: 0, end: 4) {
              for index : range(start: 0, end: 3) {
                if item[index] > item[index + 1] {
                  Integer temporary = item[index]
                  item[index] = item[index + 1]
                  item[index + 1] = temporary
                }
              }
            }
            if unique.add(item) { result.add(item) }
          }
        }
      }
    }
  }
  return result
}

Void main() {
  List<Array<Integer>> answer = fourSum(values: [1, 0, -1, 0, -2, 2], target: 0)
  printLine(answer.size())
  expectedOutputLine("3")
}
