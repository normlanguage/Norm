Integer uniquePaths(Integer rows, Integer columns) {
  List<Integer> paths = List<Integer>()
  for column : range(start: 0, end: columns) { paths.add(1) }
  for row : range(start: 1, end: rows) {
    for column : range(start: 1, end: columns) { paths[column] = paths[column] + paths[column - 1] }
  }
  return paths[columns - 1]
}

Void main() {
  printLine(uniquePaths(rows: 3, columns: 7))
  expectedOutputLine("28")
}
