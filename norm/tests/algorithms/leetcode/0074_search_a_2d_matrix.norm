Boolean searchMatrix(List<Array<Integer>> matrix, Integer target) {
  Integer columns = matrix[0].size()
  Integer left = 0
  Integer right = matrix.size() * columns - 1
  for step : range(start: 0, end: right + 2) {
    if left > right { break }
    Integer middle = left + (right - left) / 2
    Integer value = matrix[middle / columns][middle % columns]
    if value == target { return true }
    if value < target { left = middle + 1 } else { right = middle - 1 }
  }
  return false
}

Void main() {
  List<Array<Integer>> matrix = List<Array<Integer>>()
  matrix.add([1,3,5,7])
  matrix.add([10,11,16,20])
  matrix.add([23,30,34,60])
  printLine(searchMatrix(matrix, target: 3))
  expectedOutputLine("true")
}
