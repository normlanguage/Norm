String countAndSay(Integer n) {
  String current = "1"
  for turn : range(start: 1, end: n) {
    Array<CodePoint> points = current.codePoints()
    StringBuilder next = StringBuilder()
    Integer index = 0
    for step : range(start: 0, end: points.size()) {
      if index >= points.size() { break }
      Integer end = index + 1
      for scan : range(start: index + 1, end: points.size()) {
        if points[scan] != points[index] { break }
        end = scan + 1
      }
      next.append(end - index)
      next.append(points[index])
      index = end
    }
    current = next.toString()
  }
  return current
}

Void main() {
  printLine(countAndSay(4))
  expectedOutputLine("1211")
}
