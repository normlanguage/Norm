List<Integer> removeElement(Array<Integer> values, Integer removed) {
  List<Integer> result = List<Integer>()
  for Integer value : values {
    if value != removed { result.add(value) }
  }
  return result
}

Void main() {
  for Integer value : removeElement(values: [3, 2, 2, 3], removed: 3) { printLine(value) }
  expectedOutputLine("2")
  expectedOutputLine("2")
}
