Boolean isValid(String value) {
  Stack<CodePoint> openings = Stack<CodePoint>()
  for CodePoint token : value.codePoints() {
    if token == '(' || token == '[' || token == '{' {
      openings.push(token)
    } else {
      if openings.isEmpty() { return false }
      CodePoint opening = openings.pop()
      if token == ')' && opening != '(' || token == ']' && opening != '[' || token == '}' && opening != '{' { return false }
    }
  }
  return openings.isEmpty()
}

Void main() {
  printLine(isValid("([])"))
  printLine(isValid("([)]"))
  expectedOutputLine("true")
  expectedOutputLine("false")
}
