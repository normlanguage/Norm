List<Array<Integer>> insert(List<Array<Integer>> intervals, Array<Integer> added) {
  List<Array<Integer>> result = List<Array<Integer>>()
  Boolean placed = false
  for Array<Integer> interval : intervals {
    if interval[1] < added[0] {
      result.add(interval)
    } else if added[1] < interval[0] {
      if !placed {
        result.add(added)
        placed = true
      }
      result.add(interval)
    } else {
      if interval[0] < added[0] { added[0] = interval[0] }
      if interval[1] > added[1] { added[1] = interval[1] }
    }
  }
  if !placed { result.add(added) }
  return result
}

Void main() {
  List<Array<Integer>> intervals = List<Array<Integer>>()
  intervals.add([1,3])
  intervals.add([6,9])
  for Array<Integer> interval : insert(intervals, added: [2,5]) {
    printLine(interval[0])
    printLine(interval[1])
  }
  expectedOutputLine("1")
  expectedOutputLine("5")
  expectedOutputLine("6")
  expectedOutputLine("9")
}
