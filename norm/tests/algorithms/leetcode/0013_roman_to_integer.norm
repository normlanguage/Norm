Integer romanValue(CodePoint symbol) {
  if symbol == 'I' {
    return 1
  }
  if symbol == 'V' {
    return 5
  }
  if symbol == 'X' {
    return 10
  }
  if symbol == 'L' {
    return 50
  }
  if symbol == 'C' {
    return 100
  }
  if symbol == 'D' {
    return 500
  }
  return 1000
}

Integer romanToInt(String value) {
  Array<CodePoint> symbols = value.codePoints()
  Integer result = 0
  for index : range(start: 0, end: symbols.size()) {
    Integer current = romanValue(symbols[index])
    if index + 1 < symbols.size() && current < romanValue(symbols[index + 1]) {
      result = result - current
    } else {
      result = result + current
    }
  }
  return result
}

main() {
  printLine(romanToInt("MCMXCIV"))
  expectedOutputLine("1994")
}
