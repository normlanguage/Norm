import std.io.printLines
import std.testing.expectedOutputLines

Boolean matches(String textValue, String patternValue) {
  Array<CodePoint> text = textValue.codePoints()
  Array<CodePoint> pattern = patternValue.codePoints()
  List<Boolean> previous = List<>()
  List<Boolean> current = List.filled(size: text.size() + 1, value: false)
  current[0] = true
  for patternIndex : range(start: 0, end: pattern.size()) {
    List<Boolean> next = List.filled(size: text.size() + 1, value: false)
    if pattern[patternIndex] == '*' && patternIndex > 0 {
      next[0] = previous[0]
      for textIndex : range(start: 1, end: text.size() + 1) {
        Boolean same = pattern[patternIndex - 1] == '.' || pattern[patternIndex - 1] == text[textIndex - 1]
        next[textIndex] = previous[textIndex] || (same && next[textIndex - 1])
      }
    } else {
      for textIndex : range(start: 1, end: text.size() + 1) {
        Boolean same = pattern[patternIndex] == '.' || pattern[patternIndex] == text[textIndex - 1]
        next[textIndex] = same && current[textIndex - 1]
      }
    }
    previous = current
    current = next
  }
  return current[text.size()]
}

Void main() {
  printLines([
    matches(textValue: "aa", patternValue: "a*"),
    matches(textValue: "ab", patternValue: ".*")
  ])
  expectedOutputLines([
    "true",
    "true"
  ])
}
