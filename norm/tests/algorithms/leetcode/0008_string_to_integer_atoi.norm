Integer myAtoi(Array<Integer> input) {
  Integer index = 0
  for step : range(start: 0, end: input.size()) {
    if index >= input.size() || input[index] != -3 { break }
    index = index + 1
  }
  Integer sign = 1
  if index < input.size() && input[index] == -1 {
    sign = -1
    index = index + 1
  } else if index < input.size() && input[index] == -2 {
    index = index + 1
  }
  Integer value = 0
  for step : range(start: 0, end: input.size()) {
    if index >= input.size() || input[index] < 0 || input[index] > 9 { break }
    Integer digit = input[index]
    if value > 214748364 || (value == 214748364 && digit > 7) {
      if sign == 1 { return 2147483647 }
      return -2147483648
    }
    value = value * 10 + digit
    index = index + 1
  }
  return value * sign
}

Void main() {
  printLine(myAtoi([-3, -3, -1, 4, 2]))
  printLine(myAtoi([4, 1, 9, 3, 0, 0, 0, 0, 0, 0]))
  expectedOutputLine("-42")
  expectedOutputLine("2147483647")
}
