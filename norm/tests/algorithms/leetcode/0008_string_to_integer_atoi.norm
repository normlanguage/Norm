import std.io.printLines
import std.testing.expectedOutputLines

Integer myAtoi(String inputValue) {
  Array<CodePoint> input = inputValue.codePoints()
  Integer index = 0
  for index < input.size() && input[index] == ' ' {
    index = index + 1
  }
  Integer sign = 1
  if index < input.size() && input[index] == '-' {
    sign = -1
    index = index + 1
  } else if index < input.size() && input[index] == '+' {
    index = index + 1
  }
  Integer value = 0
  for index < input.size() && input[index].isAsciiDigit() {
    Integer digit = input[index].asciiDigitValue()
    if value > 214748364 || value == 214748364 && digit > 7 {
      if sign == 1 {
        return 2147483647
      }
      return -2147483648
    }
    value = value * 10 + digit
    index = index + 1
  }
  return value * sign
}

main() {
  printLines([myAtoi("  -42"), myAtoi("4193000000")])
  expectedOutputLines(["-42", "2147483647"])
}
