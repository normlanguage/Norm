import std.testing.expectedOutputLines

List<Integer> removeDuplicatesTwice(Array<Integer> values) {
  List<Integer> result = List<>()
  for Integer value : values {
    if result.size() < 2 || result[result.size() - 2] != value {
      result.add(value)
    }
  }
  return result
}

main() {
  for Integer value : removeDuplicatesTwice([0, 0, 1, 1, 1, 1, 2, 3, 3]) {
    printLine(value)
  }
  expectedOutputLines(["0", "0", "1", "1", "2", "3", "3"])
}
