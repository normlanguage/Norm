import std.testing.expectedOutputLines

List<Integer> addTwoNumbers(Array<Integer> left, Array<Integer> right) {
  List<Integer> result = List<>()
  Integer carry = 0
  Integer size = left.size()
  if right.size() > size {
    size = right.size()
  }
  for index : range(start: 0, end: size) {
    Integer sum = carry
    if index < left.size() {
      sum = sum + left[index]
    }
    if index < right.size() {
      sum = sum + right[index]
    }
    result.add(sum % 10)
    carry = sum / 10
  }
  if carry > 0 {
    result.add(carry)
  }
  return result
}

main() {
  for Integer value : addTwoNumbers(left: [2, 4, 3], right: [5, 6, 4]) {
    printLine(value)
  }
  expectedOutputLines(["7", "0", "8"])
}
