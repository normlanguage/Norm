class Combinations {
  List<List<Integer>> values
}

Void searchCombination(
  Array<Integer> candidates,
  Integer target,
  Integer start,
  List<Integer> current,
  Combinations result
) {
  if target == 0 {
    result.values.add(current)
    return
  }
  for index : range(start: start, end: candidates.size()) {
    if candidates[index] <= target {
      List<Integer> next = current
      next.add(candidates[index])
      searchCombination(
        candidates,
        target: target - candidates[index],
        start: index,
        current: next,
        result
      )
    }
  }
}

List<List<Integer>> combinationSum(Array<Integer> candidates, Integer target) {
  Combinations result = Combinations(values: List<>())
  searchCombination(candidates, target, start: 0, current: List<>(), result)
  return result.values
}

main() {
  List<List<Integer>> answer = combinationSum(candidates: [2, 3, 6, 7], target: 7)
  printLine(answer.size())
  expectedOutputLine("2")
}
