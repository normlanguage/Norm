Boolean isMatch(String textValue, String patternValue) {
  Array<CodePoint> text = textValue.codePoints()
  Array<CodePoint> pattern = patternValue.codePoints()
  List<Boolean> dp = List.filled(size: text.size() + 1, value: false)
  dp[0] = true
  for CodePoint token : pattern {
    List<Boolean> next = List.filled(size: text.size() + 1, value: false)
    if token == '*' { next[0] = dp[0] }
    for index : range(start: 1, end: text.size() + 1) {
      if token == '*' {
        next[index] = dp[index] || next[index - 1]
      } else {
        next[index] = dp[index - 1] && (token == '?' || token == text[index - 1])
      }
    }
    dp = next
  }
  return dp[text.size()]
}

Void main() {
  printLine(isMatch(textValue: "adceb", patternValue: "*a*b"))
  expectedOutputLine("true")
}
