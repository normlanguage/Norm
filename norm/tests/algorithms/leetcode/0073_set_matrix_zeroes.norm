List<List<Integer>> setZeroes(List<List<Integer>> matrix) {
  Set<Integer> rows = Set<Integer>()
  Set<Integer> columns = Set<Integer>()
  for row : range(start: 0, end: matrix.size()) {
    for column : range(start: 0, end: matrix[0].size()) {
      if matrix[row][column] == 0 {
        rows.add(row)
        columns.add(column)
      }
    }
  }
  for row : range(start: 0, end: matrix.size()) {
    List<Integer> current = matrix[row]
    for column : range(start: 0, end: current.size()) {
      if rows.contains(row) || columns.contains(column) { current[column] = 0 }
    }
    matrix[row] = current
  }
  return matrix
}

Void main() {
  List<List<Integer>> matrix = List<List<Integer>>()
  List<Integer> first = List<Integer>()
  for Integer value : [1,1,1] { first.add(value) }
  List<Integer> second = List<Integer>()
  for Integer value : [1,0,1] { second.add(value) }
  List<Integer> third = List<Integer>()
  for Integer value : [1,1,1] { third.add(value) }
  matrix.add(first)
  matrix.add(second)
  matrix.add(third)
  List<List<Integer>> result = setZeroes(matrix)
  printLine(result[0][1])
  printLine(result[1][0])
  expectedOutputLine("0")
  expectedOutputLine("0")
}
