Integer numTrees(Integer size) {
  List<Integer> counts = List<>()
  counts.add(1)
  for nodes : range(start: 1, end: size + 1) {
    Integer total = 0
    for root : range(start: 1, end: nodes + 1) {
      total = total + counts[root - 1] * counts[nodes - root]
    }
    counts.add(total)
  }
  return counts[size]
}

main() {
  printLine(numTrees(3))
  expectedOutputLine("5")
}
