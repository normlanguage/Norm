Integer prefixLength(Array<CodePoint> left, Array<CodePoint> right, Integer limit) {
  Integer length = limit
  if right.size() < length {
    length = right.size()
  }
  for index : range(start: 0, end: length) {
    if left[index] != right[index] {
      return index
    }
  }
  return length
}

String longestCommonPrefix(List<String> words) {
  if words.isEmpty() {
    return ""
  }
  Array<CodePoint> first = words[0].codePoints()
  Integer length = first.size()
  for index : range(start: 1, end: words.size()) {
    length = prefixLength(left: first, right: words[index].codePoints(), limit: length)
  }
  return words[0].sliceCodePoints(start: 0, end: length)
}

main() {
  List<String> words = List<>()
  words.add("flower")
  words.add("flow")
  words.add("flight")
  printLine(longestCommonPrefix(words))
  expectedOutputLine("fl")
}
