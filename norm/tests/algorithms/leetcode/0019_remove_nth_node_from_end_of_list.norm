import std.testing.expectedOutputLines

List<Integer> removeNthFromEnd(Array<Integer> values, Integer n) {
  List<Integer> result = List<>()
  Integer removed = values.size() - n
  for index : range(start: 0, end: values.size()) {
    if index != removed {
      result.add(values[index])
    }
  }
  return result
}

main() {
  for Integer value : removeNthFromEnd(values: [1, 2, 3, 4, 5], n: 2) {
    printLine(value)
  }
  expectedOutputLines(["1", "2", "3", "5"])
}
