Integer mySqrt(Integer value) {
  Integer left = 0
  Integer right = value
  for step : range(start: 0, end: 64) {
    if left > right { break }
    Integer middle = left + (right - left) / 2
    if middle <= value / middle {
      if middle + 1 > value / (middle + 1) { return middle }
      left = middle + 1
    } else {
      right = middle - 1
    }
  }
  return 0
}

Void main() {
  printLine(mySqrt(8))
  expectedOutputLine("2")
}
