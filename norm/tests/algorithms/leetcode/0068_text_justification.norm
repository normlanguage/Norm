List<String> fullJustify(List<String> words, Integer width) {
  List<String> lines = List<String>()
  Integer start = 0
  for step : range(start: 0, end: words.size()) {
    if start >= words.size() { break }
    Integer end = start
    Integer letters = 0
    for scan : range(start: start, end: words.size()) {
      if letters + words[scan].codePointSize() + scan - start > width { break }
      letters = letters + words[scan].codePointSize()
      end = scan + 1
    }
    Integer gaps = end - start - 1
    StringBuilder line = StringBuilder()
    for word : range(start: start, end: end) {
      line.append(words[word])
      if word + 1 < end {
        Integer spaces = 1
        if end < words.size() && gaps > 0 {
          spaces = (width - letters) / gaps
          if word - start < (width - letters) % gaps { spaces = spaces + 1 }
        }
        for space : range(start: 0, end: spaces) { line.append(" ") }
      }
    }
    for space : range(start: line.size(), end: width) { line.append(" ") }
    lines.add(line.toString())
    start = end
  }
  return lines
}

Void main() {
  List<String> words = List<String>()
  words.add("This")
  words.add("is")
  words.add("text")
  for String line : fullJustify(words, width: 8) { printLine(line) }
  expectedOutputLine("This  is")
  expectedOutputLine("text    ")
}
