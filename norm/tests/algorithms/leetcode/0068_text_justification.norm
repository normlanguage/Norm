import std.testing.expectedOutputLines

List<String> fullJustify(List<String> words, Integer width) {
  List<String> lines = List<>()
  Integer start = 0
  for start < words.size() {
    Integer end = start
    Integer letters = 0
    for scan : range(start: start, end: words.size()) {
      if letters + words[scan].codePointSize() + scan - start > width {
        break
      }
      letters = letters + words[scan].codePointSize()
      end = scan + 1
    }
    Integer gaps = end - start - 1
    StringBuilder line = StringBuilder()
    for word : range(start: start, end: end) {
      line.append(words[word])
      if word + 1 < end {
        Integer spaces = 1
        if end < words.size() && gaps > 0 {
          spaces = (width - letters) / gaps
          if word - start < (width - letters) % gaps {
            spaces = spaces + 1
          }
        }
        for space : range(start: 0, end: spaces) {
          line.append(" ")
        }
      }
    }
    for space : range(start: line.size(), end: width) {
      line.append(" ")
    }
    lines.add(line.toString())
    start = end
  }
  return lines
}

main() {
  List<String> words = List<>()
  words.add("This")
  words.add("is")
  words.add("text")
  for String line : fullJustify(words, width: 8) {
    printLine(line)
  }
  expectedOutputLines(["This  is", "text    "])
}
