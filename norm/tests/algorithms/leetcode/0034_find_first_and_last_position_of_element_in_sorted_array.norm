Integer boundary(Array<Integer> values, Integer target, Boolean upper) {
  Integer left = 0
  Integer right = values.size()
  for step : range(start: 0, end: values.size() + 1) {
    if left >= right { break }
    Integer middle = left + (right - left) / 2
    if values[middle] < target || (upper && values[middle] == target) { left = middle + 1 } else { right = middle }
  }
  return left
}

Array<Integer> searchRange(Array<Integer> values, Integer target) {
  Integer first = boundary(values, target, upper: false)
  if first == values.size() || values[first] != target { return [-1, -1] }
  return [first, boundary(values, target, upper: true) - 1]
}

Void main() {
  for Integer value : searchRange(values: [5, 7, 7, 8, 8, 10], target: 8) { printLine(value) }
  expectedOutputLine("3")
  expectedOutputLine("4")
}
