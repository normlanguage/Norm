import std.io.printLines
import std.testing.expectedOutputLines

Integer divide(Integer dividend, Integer divisor) {
  if dividend == -2147483648 && divisor == -1 { return 2147483647 }
  Integer sign = 1
  if dividend < 0 {
    sign = -sign
    dividend = -dividend
  }
  if divisor < 0 {
    sign = -sign
    divisor = -divisor
  }
  Integer quotient = 0
  for bit : range(start: 0, end: 31) {
    Integer shifted = divisor
    Integer power = 1
    for shifted <= dividend / 2 {
      shifted = shifted + shifted
      power = power + power
    }
    if shifted <= dividend {
      dividend = dividend - shifted
      quotient = quotient + power
    }
  }
  return quotient * sign
}

Void main() {
  printLines([
    divide(dividend: 10, divisor: 3),
    divide(dividend: 7, divisor: -3)
  ])
  expectedOutputLines([
    "3",
    "-2"
  ])
}
