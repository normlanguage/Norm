Boolean matchesWords(Array<CodePoint> text, Integer start, List<String> words) {
  Integer width = words[0].codePointSize()
  List<Boolean> used = List.filled(size: words.size(), value: false)
  for position : range(start: 0, end: words.size()) {
    Boolean found = false
    for word : range(start: 0, end: words.size()) {
      if !used[word] {
        Array<CodePoint> candidate = words[word].codePoints()
        Boolean same = true
        for offset : range(start: 0, end: width) {
          if text[start + position * width + offset] != candidate[offset] {
            same = false
            break
          }
        }
        if same {
          used[word] = true
          found = true
          break
        }
      }
    }
    if !found { return false }
  }
  return true
}

List<Integer> findSubstring(String value, List<String> words) {
  Array<CodePoint> text = value.codePoints()
  List<Integer> result = List<Integer>()
  Integer length = words.size() * words[0].codePointSize()
  for start : range(start: 0, end: text.size() - length + 1) {
    if matchesWords(text, start, words) { result.add(start) }
  }
  return result
}

Void main() {
  List<String> words = List<String>()
  words.add("foo")
  words.add("bar")
  for Integer index : findSubstring(value: "barfoothefoobarman", words) { printLine(index) }
  expectedOutputLine("0")
  expectedOutputLine("9")
}
