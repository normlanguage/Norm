Integer subsetsWithDup(Array<Integer> values) {
  Set<List<Integer>> result = Set<>()
  result.add(List<>())
  for Integer value : values {
    List<List<Integer>> additions = List<>()
    for List<Integer> subset : result {
      List<Integer> next = subset
      next.add(value)
      additions.add(next)
    }
    for List<Integer> subset : additions { result.add(subset) }
  }
  return result.size()
}

Void main() {
  printLine(subsetsWithDup([1,2,2]))
  expectedOutputLine("6")
}
