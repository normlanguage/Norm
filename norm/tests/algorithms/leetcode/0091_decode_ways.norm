Integer numDecodings(String value) {
  Array<CodePoint> points = value.codePoints()
  if points.size() == 0 || points[0] == '0' {
    return 0
  }
  Integer previous = 1
  Integer current = 1
  for index : range(start: 1, end: points.size()) {
    Integer next = 0
    if points[index] != '0' {
      next = current
    }
    Integer pair = points[index - 1].asciiDigitValue() * 10 + points[index].asciiDigitValue()
    if pair >= 10 && pair <= 26 {
      next = next + previous
    }
    previous = current
    current = next
  }
  return current
}

main() {
  printLine(numDecodings("226"))
  expectedOutputLine("3")
}
