Integer search(Array<Integer> values, Integer target) {
  Integer left = 0
  Integer right = values.size() - 1
  for left <= right {
    Integer middle = left + (right - left) / 2
    if values[middle] == target { return middle }
    if values[left] <= values[middle] {
      if values[left] <= target && target < values[middle] { right = middle - 1 } else { left = middle + 1 }
    } else {
      if values[middle] < target && target <= values[right] { left = middle + 1 } else { right = middle - 1 }
    }
  }
  return -1
}

Void main() {
  printLine(search(values: [4, 5, 6, 7, 0, 1, 2], target: 0))
  expectedOutputLine("4")
}
