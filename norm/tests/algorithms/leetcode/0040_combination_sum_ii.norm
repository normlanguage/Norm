import std.collections.sort

class UniqueCombinations {
  Set<List<Integer>> seen
}

Void collect(Array<Integer> candidates, Integer target, Integer start, List<Integer> current, UniqueCombinations result) {
  if target == 0 {
    result.seen.add(current)
    return
  }
  for index : range(start: start, end: candidates.size()) {
    if candidates[index] <= target {
      List<Integer> next = current
      next.add(candidates[index])
      collect(candidates, target: target - candidates[index], start: index + 1, current: next, result)
    }
  }
}

Integer combinationSum2(Array<Integer> candidates, Integer target) {
  candidates = sort(candidates)
  UniqueCombinations result = UniqueCombinations(seen: Set<>())
  collect(candidates, target, start: 0, current: List<>(), result)
  return result.seen.size()
}

Void main() {
  printLine(combinationSum2(candidates: [10, 1, 2, 7, 6, 1, 5], target: 8))
  expectedOutputLine("4")
}
