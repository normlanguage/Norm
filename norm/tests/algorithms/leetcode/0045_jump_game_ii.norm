Integer jump(Array<Integer> values) {
  Integer jumps = 0
  Integer end = 0
  Integer farthest = 0
  for index : range(start: 0, end: values.size() - 1) {
    if index + values[index] > farthest { farthest = index + values[index] }
    if index == end {
      jumps = jumps + 1
      end = farthest
    }
  }
  return jumps
}

Void main() {
  printLine(jump([2, 3, 1, 1, 4]))
  expectedOutputLine("2")
}
