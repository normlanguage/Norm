Array<CodePoint> signature(String word) {
  Array<CodePoint> sorted = word.codePoints()
  for pass : range(start: 0, end: sorted.size()) {
    for index : range(start: 0, end: sorted.size() - 1) {
      if sorted[index].scalarValue() > sorted[index + 1].scalarValue() {
        CodePoint temporary = sorted[index]
        sorted[index] = sorted[index + 1]
        sorted[index + 1] = temporary
      }
    }
  }
  return sorted
}

Integer groupAnagrams(List<String> words) {
  Set<Array<CodePoint>> groups = Set<Array<CodePoint>>()
  for String word : words { groups.add(signature(word)) }
  return groups.size()
}

Void main() {
  List<String> words = List<String>()
  words.add("eat")
  words.add("tea")
  words.add("tan")
  words.add("ate")
  words.add("nat")
  words.add("bat")
  printLine(groupAnagrams(words))
  expectedOutputLine("3")
}
