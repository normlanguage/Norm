import std.math.abs

Integer threeSumClosest(Array<Integer> values, Integer target) {
  Integer best = values[0] + values[1] + values[2]
  for first : range(start: 0, end: values.size()) {
    for second : range(start: first + 1, end: values.size()) {
      for third : range(start: second + 1, end: values.size()) {
        Integer sum = values[first] + values[second] + values[third]
        if abs(sum - target) < abs(best - target) {
          best = sum
        }
      }
    }
  }
  return best
}

main() {
  printLine(threeSumClosest(values: [-1, 2, 1, -4], target: 1))
  expectedOutputLine("2")
}
