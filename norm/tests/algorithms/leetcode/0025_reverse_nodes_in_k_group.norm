import std.testing.expectedOutputLines

Array<Integer> reverseKGroup(Array<Integer> values, Integer groupSize) {
  for group : range(start: 0, end: values.size() / groupSize) {
    Integer start = group * groupSize
    for offset : range(start: 0, end: groupSize / 2) {
      Integer right = start + groupSize - 1 - offset
      Integer temporary = values[start + offset]
      values[start + offset] = values[right]
      values[right] = temporary
    }
  }
  return values
}

main() {
  for Integer value : reverseKGroup(values: [1, 2, 3, 4, 5], groupSize: 2) {
    printLine(value)
  }
  expectedOutputLines(["2", "1", "4", "3", "5"])
}
