import std.io.printLines
import std.testing.expectedOutputLines

Boolean validNumber(String value) {
  Array<CodePoint> tokens = value.codePoints()
  Boolean digit = false
  Boolean exponent = false
  Boolean decimal = false
  for index : range(start: 0, end: tokens.size()) {
    CodePoint token = tokens[index]
    Integer scalar = token.scalarValue()
    if scalar >= '0'.scalarValue() && scalar <= '9'.scalarValue() {
      digit = true
    } else if token == '.' {
      if decimal || exponent {
        return false
      }
      decimal = true
    } else if token == 'e' || token == 'E' {
      if exponent || !digit {
        return false
      }
      exponent = true
      digit = false
    } else if token == '-' || token == '+' {
      if index > 0 && tokens[index - 1] != 'e' && tokens[index - 1] != 'E' {
        return false
      }
    } else {
      return false
    }
  }
  return digit
}

main() {
  printLines([validNumber("2e10"), validNumber("99e2.5")])
  expectedOutputLines(["true", "false"])
}
