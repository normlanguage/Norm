import std.io.printLines
import std.testing.expectedOutputLines

Integer searchInsert(Array<Integer> values, Integer target) {
  Integer left = 0
  Integer right = values.size()
  for left < right {
    Integer middle = left + (right - left) / 2
    if values[middle] < target { left = middle + 1 } else { right = middle }
  }
  return left
}

Void main() {
  printLines([
    searchInsert(values: [1, 3, 5, 6], target: 5),
    searchInsert(values: [1, 3, 5, 6], target: 2)
  ])
  expectedOutputLines([
    "2",
    "1"
  ])
}
