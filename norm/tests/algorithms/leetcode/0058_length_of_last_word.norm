Integer lengthOfLastWord(String value) {
  Array<CodePoint> text = value.codePoints()
  Integer length = 0
  for offset : range(start: 0, end: text.size()) {
    CodePoint point = text[text.size() - 1 - offset]
    if point == ' ' {
      if length > 0 { break }
    } else {
      length = length + 1
    }
  }
  return length
}

Void main() {
  printLine(lengthOfLastWord("Hello World"))
  expectedOutputLine("5")
}
