Integer lengthOfLastWord(String value) {
  Array<CodePoint> text = value.codePoints()
  Integer length = 0
  for index : range(start: text.size() - 1, end: -1, step: -1) {
    CodePoint point = text[index]
    if point == ' ' {
      if length > 0 { break }
    } else {
      length = length + 1
    }
  }
  return length
}

Void main() {
  printLine(lengthOfLastWord("Hello World"))
  expectedOutputLine("5")
}
