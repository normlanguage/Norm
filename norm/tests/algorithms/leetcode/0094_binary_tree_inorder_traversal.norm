class Traversal {
  List<Integer> values
}

Void traverse(Array<Integer> values, Array<Integer> left, Array<Integer> right, Integer node, Traversal result) {
  if node == -1 { return }
  traverse(values, left, right, node: left[node], result: result)
  result.values.add(values[node])
  traverse(values, left, right, node: right[node], result: result)
}

List<Integer> inorderTraversal(Array<Integer> values, Array<Integer> left, Array<Integer> right) {
  List<Integer> result = List<Integer>()
  Traversal traversal = Traversal(values: result)
  traverse(values, left, right, node: 0, result: traversal)
  return traversal.values
}

Void main() {
  for Integer value : inorderTraversal(values: [1,2,3], left: [1,-1,-1], right: [2,-1,-1]) { printLine(value) }
  expectedOutputLine("2")
  expectedOutputLine("1")
  expectedOutputLine("3")
}
