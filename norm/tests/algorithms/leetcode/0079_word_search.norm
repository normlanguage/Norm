Boolean findWord(List<String> board, Array<CodePoint> word, Integer row, Integer column, Integer index, Set<Integer> used) {
  if index == word.size() { return true }
  if row < 0 || row >= board.size() || column < 0 || column >= board[0].codePointSize() { return false }
  Integer position = row * board[0].codePointSize() + column
  Array<CodePoint> line = board[row].codePoints()
  if used.contains(position) || line[column] != word[index] { return false }
  Set<Integer> next = used
  next.add(position)
  return findWord(board, word, row: row + 1, column, index: index + 1, used: next) ||
    findWord(board, word, row: row - 1, column, index: index + 1, used: next) ||
    findWord(board, word, row, column: column + 1, index: index + 1, used: next) ||
    findWord(board, word, row, column: column - 1, index: index + 1, used: next)
}

Boolean exist(List<String> board, String value) {
  Array<CodePoint> word = value.codePoints()
  for row : range(start: 0, end: board.size()) {
    for column : range(start: 0, end: board[0].codePointSize()) {
      if findWord(board, word, row, column, index: 0, used: Set<Integer>()) { return true }
    }
  }
  return false
}

Void main() {
  List<String> board = List<String>()
  board.add("ABCE")
  board.add("SFCS")
  board.add("ADEE")
  printLine(exist(board, value: "ABCCED"))
  expectedOutputLine("true")
}
