Pair<Integer, Integer> expand(Array<CodePoint> text, Integer left, Integer right) {
  for left >= 0 && right < text.size() && text[left] == text[right] {
    left = left - 1
    right = right + 1
  }
  return Pair<Integer, Integer>(first: left + 1, second: right)
}

String longestPalindrome(String value) {
  Array<CodePoint> text = value.codePoints()
  Pair<Integer, Integer> best = Pair<Integer, Integer>(first: 0, second: 0)
  for center : range(start: 0, end: text.size()) {
    Pair<Integer, Integer> odd = expand(text, left: center, right: center)
    Pair<Integer, Integer> even = expand(text, left: center, right: center + 1)
    if odd.second - odd.first > best.second - best.first { best = odd }
    if even.second - even.first > best.second - best.first { best = even }
  }
  return value.sliceCodePoints(start: best.first, end: best.second)
}

Void main() {
  printLine(longestPalindrome("babad"))
  expectedOutputLine("bab")
}
