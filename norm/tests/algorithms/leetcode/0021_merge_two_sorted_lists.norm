List<Integer> mergeTwoLists(Array<Integer> left, Array<Integer> right) {
  List<Integer> result = List<Integer>()
  Integer i = 0
  Integer j = 0
  for step : range(start: 0, end: left.size() + right.size()) {
    if i < left.size() && (j >= right.size() || left[i] <= right[j]) {
      result.add(left[i])
      i = i + 1
    } else {
      result.add(right[j])
      j = j + 1
    }
  }
  return result
}

Void main() {
  for Integer value : mergeTwoLists(left: [1, 2, 4], right: [1, 3, 4]) { printLine(value) }
  expectedOutputLine("1")
  expectedOutputLine("1")
  expectedOutputLine("2")
  expectedOutputLine("3")
  expectedOutputLine("4")
  expectedOutputLine("4")
}
