List<Integer> removeDuplicates(Array<Integer> values) {
  List<Integer> unique = List<Integer>()
  for Integer value : values {
    if unique.isEmpty() || unique[unique.size() - 1] != value { unique.add(value) }
  }
  return unique
}

Void main() {
  for Integer value : removeDuplicates([0, 0, 1, 1, 1, 2, 2, 3, 3, 4]) { printLine(value) }
  expectedOutputLine("0")
  expectedOutputLine("1")
  expectedOutputLine("2")
  expectedOutputLine("3")
  expectedOutputLine("4")
}
