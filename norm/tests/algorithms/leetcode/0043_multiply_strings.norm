Integer digit(CodePoint value) {
  return value.scalarValue() - '0'.scalarValue()
}

String multiply(String leftValue, String rightValue) {
  Array<CodePoint> left = leftValue.codePoints()
  Array<CodePoint> right = rightValue.codePoints()
  List<Integer> digits = List<Integer>()
  for index : range(start: 0, end: left.size() + right.size()) { digits.add(0) }
  for i : range(start: 0, end: left.size()) {
    for j : range(start: 0, end: right.size()) {
      Integer position = i + j
      Integer sum = digits[position] + digit(left[left.size() - 1 - i]) * digit(right[right.size() - 1 - j])
      digits[position] = sum % 10
      digits[position + 1] = digits[position + 1] + sum / 10
    }
  }
  for step : range(start: 0, end: digits.size()) {
    if digits.size() <= 1 || digits[digits.size() - 1] != 0 { break }
    digits.removeAt(digits.size() - 1)
  }
  StringBuilder result = StringBuilder()
  for offset : range(start: 0, end: digits.size()) { result.append(digits[digits.size() - 1 - offset]) }
  return result.toString()
}

Void main() {
  printLine(multiply(leftValue: "123", rightValue: "456"))
  expectedOutputLine("56088")
}
