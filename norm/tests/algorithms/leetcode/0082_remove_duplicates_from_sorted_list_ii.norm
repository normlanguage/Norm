List<Integer> deleteDuplicatesAll(Array<Integer> values) {
  List<Integer> result = List<Integer>()
  Integer index = 0
  for index < values.size() {
    Integer end = index + 1
    for scan : range(start: index + 1, end: values.size()) {
      if values[scan] != values[index] { break }
      end = scan + 1
    }
    if end == index + 1 { result.add(values[index]) }
    index = end
  }
  return result
}

Void main() {
  for Integer value : deleteDuplicatesAll([1,2,3,3,4,4,5]) { printLine(value) }
  expectedOutputLine("1")
  expectedOutputLine("2")
  expectedOutputLine("5")
}
