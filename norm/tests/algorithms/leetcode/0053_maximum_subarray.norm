Integer maxSubArray(Array<Integer> values) {
  Integer current = values[0]
  Integer best = current
  for index : range(start: 1, end: values.size()) {
    if current < 0 { current = values[index] } else { current = current + values[index] }
    if current > best { best = current }
  }
  return best
}

Void main() {
  printLine(maxSubArray([-2,1,-3,4,-1,2,1,-5,4]))
  expectedOutputLine("6")
}
