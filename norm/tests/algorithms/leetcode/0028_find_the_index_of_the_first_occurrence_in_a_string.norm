import std.io.printLines
import std.testing.expectedOutputLines

Integer strStr(String textValue, String patternValue) {
  Array<CodePoint> text = textValue.codePoints()
  Array<CodePoint> pattern = patternValue.codePoints()
  if pattern.size() == 0 {
    return 0
  }
  for start : range(start: 0, end: text.size() - pattern.size() + 1) {
    Boolean equal = true
    for offset : range(start: 0, end: pattern.size()) {
      if text[start + offset] != pattern[offset] {
        equal = false
        break
      }
    }
    if equal {
      return start
    }
  }
  return -1
}

main() {
  printLines(
    [
      strStr(textValue: "sadbutsad", patternValue: "sad"),
      strStr(textValue: "leetcode", patternValue: "leeto")
    ]
  )
  expectedOutputLines(["0", "-1"])
}
