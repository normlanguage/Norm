Integer lengthOfLongestSubstring(String value) {
  Array<CodePoint> text = value.codePoints()
  Set<CodePoint> window = Set<CodePoint>()
  Integer left = 0
  Integer best = 0
  for right : range(start: 0, end: text.size()) {
    for window.contains(text[right]) {
      window.remove(text[left])
      left = left + 1
    }
    window.add(text[right])
    Integer length = right - left + 1
    if length > best { best = length }
  }
  return best
}

Void main() {
  printLine(lengthOfLongestSubstring("abcabcbb"))
  printLine(lengthOfLongestSubstring("bbbbb"))
  expectedOutputLine("3")
  expectedOutputLine("1")
}
