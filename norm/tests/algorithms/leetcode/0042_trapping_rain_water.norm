Integer trap(Array<Integer> height) {
  Integer left = 0
  Integer right = height.size() - 1
  Integer leftMaximum = 0
  Integer rightMaximum = 0
  Integer water = 0
  for left < right {
    if height[left] <= height[right] {
      if height[left] >= leftMaximum {
        leftMaximum = height[left]
      } else {
        water = water + leftMaximum - height[left]
      }
      left = left + 1
    } else {
      if height[right] >= rightMaximum {
        rightMaximum = height[right]
      } else {
        water = water + rightMaximum - height[right]
      }
      right = right - 1
    }
  }
  return water
}

main() {
  printLine(trap([0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]))
  expectedOutputLine("6")
}
