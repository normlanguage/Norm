String simplifyPath(String path) {
  Array<String> components = path.split(separator: "/")
  List<String> stack = List<String>()
  for String component : components {
    if component.isEmpty() || component == "." {
    } else if component == ".." {
      if !stack.isEmpty() { stack.removeAt(stack.size() - 1) }
    } else {
      stack.add(component)
    }
  }
  StringBuilder result = StringBuilder()
  for String component : stack {
    result.append("/")
    result.append(component)
  }
  if stack.isEmpty() { return "/" }
  return result.toString()
}

Void main() {
  printLine(simplifyPath("/home/user/../docs/"))
  expectedOutputLine("/home/docs")
}
