Pair<Integer, Integer> power(Integer base, Integer exponent) {
  Integer magnitude = exponent
  if magnitude < 0 { magnitude = -magnitude }
  Integer result = 1
  Integer factor = base
  for step : range(start: 0, end: 64) {
    if magnitude == 0 { break }
    if magnitude % 2 == 1 { result = result * factor }
    factor = factor * factor
    magnitude = magnitude / 2
  }
  if exponent < 0 { return Pair<Integer, Integer>(first: 1, second: result) }
  return Pair<Integer, Integer>(first: result, second: 1)
}

Void main() {
  Pair<Integer, Integer> positive = power(base: 2, exponent: 10)
  Pair<Integer, Integer> negative = power(base: 2, exponent: -2)
  printLine(positive.first)
  printLine(positive.second)
  printLine(negative.first)
  printLine(negative.second)
  expectedOutputLine("1024")
  expectedOutputLine("1")
  expectedOutputLine("1")
  expectedOutputLine("4")
}
