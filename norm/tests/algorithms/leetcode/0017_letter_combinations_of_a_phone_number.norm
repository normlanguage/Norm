List<List<Integer>> letterCombinations(Array<Integer> digits) {
  List<List<Integer>> combinations = List<List<Integer>>()
  combinations.add(List<Integer>())
  for Integer digit : digits {
    List<List<Integer>> next = List<List<Integer>>()
    Integer count = 3
    if digit == 7 || digit == 9 { count = 4 }
    Integer start = (digit - 2) * 3
    if digit == 8 || digit == 9 { start = start + 1 }
    for List<Integer> prefix : combinations {
      for offset : range(start: 0, end: count) {
        List<Integer> built = List<Integer>()
        for Integer value : prefix { built.add(value) }
        built.add(start + offset)
        next.add(built)
      }
    }
    combinations = next
  }
  return combinations
}

Void main() {
  List<List<Integer>> answer = letterCombinations([2, 3])
  printLine(answer.size())
  for Integer value : answer[0] { printLine(value) }
  expectedOutputLine("9")
  expectedOutputLine("0")
  expectedOutputLine("3")
}
