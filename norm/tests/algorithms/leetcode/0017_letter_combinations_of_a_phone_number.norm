import std.io.printLines
import std.testing.expectedOutputLines

String append(String prefix, CodePoint value) {
  StringBuilder result = StringBuilder()
  result.append(prefix)
  result.append(value)
  return result.toString()
}

List<String> letterCombinations(String digitsValue) {
  Array<CodePoint> digits = digitsValue.codePoints()
  Array<String> letters = ["", "", "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"]
  List<String> combinations = List<>()
  combinations.add("")
  for CodePoint digit : digits {
    String choices = letters[digit.asciiDigitValue()]
    Array<CodePoint> points = choices.codePoints()
    List<String> next = List<>()
    for String prefix : combinations {
      for CodePoint point : points {
        next.add(append(prefix: prefix, value: point))
      }
    }
    combinations = next
  }
  return combinations
}

main() {
  List<String> answer = letterCombinations("23")
  printLines([answer.size(), answer[0]])
  expectedOutputLines(["9", "ad"])
}
