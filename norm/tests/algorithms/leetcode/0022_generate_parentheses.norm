import std.io.printLines
import std.testing.expectedOutputLines

class Parentheses {
  List<String> values
}

String addToken(String value, String token) {
  StringBuilder result = StringBuilder()
  result.append(value)
  result.append(token)
  return result.toString()
}

Void buildParentheses(Parentheses result, String current, Integer open, Integer close, Integer pairs) {
  if current.codePointSize() == pairs * 2 {
    result.values.add(current)
    return
  }
  if open < pairs { buildParentheses(result, current: addToken(value: current, token: "("), open: open + 1, close, pairs) }
  if close < open { buildParentheses(result, current: addToken(value: current, token: ")"), open, close: close + 1, pairs) }
}

List<String> generateParenthesis(Integer pairs) {
  Parentheses result = Parentheses(values: List<>())
  buildParentheses(result, current: "", open: 0, close: 0, pairs)
  return result.values
}

Void main() {
  List<String> answer = generateParenthesis(3)
  printLines([
    answer.size(),
    answer[0]
  ])
  expectedOutputLines([
    "5",
    "((()))"
  ])
}
