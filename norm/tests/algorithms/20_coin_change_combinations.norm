import std.io.printLines
import std.testing.expectedOutputLines

Integer coinCombinations(Array<Integer> coins, Integer amount) {
  List<Integer> ways = List.filled(size: amount + 1, value: 0)
  ways[0] = 1
  for Integer coin : coins {
    for value : range(start: coin, end: amount + 1) {
      ways[value] = ways[value] + ways[value - coin]
    }
  }
  return ways[amount]
}

main() {
  printLines(
    [coinCombinations(coins: [1, 2, 5], amount: 5), coinCombinations(coins: [2], amount: 0)]
  )
  expectedOutputLines(["4", "1"])
}
