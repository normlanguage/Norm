Integer coinCombinations(Array<Integer> coins, Integer amount) {
  List<Integer> ways = List<Integer>()
  for value : range(start: 0, end: amount + 1) { ways.add(0) }
  ways[0] = 1
  for Integer coin : coins {
    for value : range(start: coin, end: amount + 1) {
      ways[value] = ways[value] + ways[value - coin]
    }
  }
  return ways[amount]
}

Void main() {
  printLine(coinCombinations(coins: [1, 2, 5], amount: 5))
  printLine(coinCombinations(coins: [2], amount: 0))
  expectedOutputLine("4")
  expectedOutputLine("1")
}
