List initialRow(int size) {
  List row = List()
  for value : range(start: 0, end: size + 1) { row.add(value) }
  return row
}

int editDistance(Array source, Array target) {
  List previous = initialRow(target.length)
  for i : range(start: 1, end: source.length + 1) {
    List current = List()
    current.add(i)
    for j : range(start: 1, end: target.length + 1) {
      if source[i - 1] == target[j - 1] {
        current.add(previous[j - 1])
      } else {
        current.add(1 + min(left: previous[j - 1], right: min(left: previous[j], right: current[j - 1])))
      }
    }
    previous = current
  }
  return previous[target.length]
}

void main() {
  print(editDistance(source: [1, 2, 3, 4, 5, 6], target: [1, 3, 4, 7, 8, 6]))
  print(editDistance(source: [1, 2, 3], target: [1, 2, 3]))
}
