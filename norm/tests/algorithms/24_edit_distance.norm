import std.math.min

List<Integer> initialRow(Integer size) {
  List<Integer> row = List<Integer>()
  for value : range(start: 0, end: size + 1) { row.add(value) }
  return row
}

Integer editDistance(Array<Integer> source, Array<Integer> target) {
  List<Integer> previous = initialRow(target.size())
  for i : range(start: 1, end: source.size() + 1) {
    List<Integer> current = List<Integer>()
    current.add(i)
    for j : range(start: 1, end: target.size() + 1) {
      if source[i - 1] == target[j - 1] {
        current.add(previous[j - 1])
      } else {
        current.add(1 + min(left: previous[j - 1], right: min(left: previous[j], right: current[j - 1])))
      }
    }
    previous = current
  }
  return previous[target.size()]
}

Void main() {
  printLine(editDistance(source: [1, 2, 3, 4, 5, 6], target: [1, 3, 4, 7, 8, 6]))
  printLine(editDistance(source: [1, 2, 3], target: [1, 2, 3]))
  expectedOutputLine("3")
  expectedOutputLine("0")
}
