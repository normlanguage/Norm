List<int> nextGreater(Array<int> values) {
  List<int> result = List<int>()
  for int value : values { result.add(-1) }
  Stack<int> indices = Stack<int>()
  for index : range(start: 0, end: values.size()) {
    for step : range(start: 0, end: values.size()) {
      if indices.isEmpty() { break }
      int previous = indices.peek()
      if values[previous] >= values[index] { break }
      indices.pop()
      result[previous] = values[index]
    }
    indices.push(index)
  }
  return result
}

void main() {
  for int value : nextGreater([2, 1, 2, 4, 3]) { print(value) }
}

private void expectedOutput() {
  print("4")
  print("2")
  print("4")
  print("-1")
  print("-1")
}
