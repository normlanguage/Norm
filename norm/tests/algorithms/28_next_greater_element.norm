List<Integer> nextGreater(Array<Integer> values) {
  List<Integer> result = List<Integer>()
  for Integer value : values { result.add(-1) }
  Stack<Integer> indices = Stack<Integer>()
  for index : range(start: 0, end: values.size()) {
    for step : range(start: 0, end: values.size()) {
      if indices.isEmpty() { break }
      Integer previous = indices.peek()
      if values[previous] >= values[index] { break }
      indices.pop()
      result[previous] = values[index]
    }
    indices.push(index)
  }
  return result
}

Void main() {
  for Integer value : nextGreater([2, 1, 2, 4, 3]) { printLine(value) }
  expectedOutputLine("4")
  expectedOutputLine("2")
  expectedOutputLine("4")
  expectedOutputLine("-1")
  expectedOutputLine("-1")
}
