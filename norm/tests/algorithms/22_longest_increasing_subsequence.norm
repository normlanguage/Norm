import std.math.max

Integer longestIncreasingSubsequence(Array<Integer> values) {
  List<Integer> lengths = List<Integer>()
  for Integer value : values { lengths.add(1) }
  Integer best = 1
  for right : range(start: 0, end: values.size()) {
    for left : range(start: 0, end: right) {
      if values[left] < values[right] {
        lengths[right] = max(left: lengths[right], right: lengths[left] + 1)
      }
    }
    best = max(left: best, right: lengths[right])
  }
  return best
}

Void main() {
  printLine(longestIncreasingSubsequence([10, 9, 2, 5, 3, 7, 101, 18]))
  printLine(longestIncreasingSubsequence([5, 4, 3, 2, 1]))
  expectedOutputLine("4")
  expectedOutputLine("1")
}
