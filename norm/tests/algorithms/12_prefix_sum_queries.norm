List<Integer> prefixSums(Array<Integer> values) {
  List<Integer> prefix = List<Integer>()
  prefix.add(0)
  for Integer value : values { prefix.add(prefix[prefix.size() - 1] + value) }
  return prefix
}

Integer rangeSum(List<Integer> prefix, Integer start, Integer end) {
  return prefix[end + 1] - prefix[start]
}

Void main() {
  List<Integer> prefix = prefixSums([3, 1, 4, 1, 5, 9])
  printLine(rangeSum(prefix, start: 0, end: 4))
  printLine(rangeSum(prefix, start: 3, end: 5))
  printLine(rangeSum(prefix, start: 1, end: 3))
  expectedOutputLine("14")
  expectedOutputLine("15")
  expectedOutputLine("6")
}
