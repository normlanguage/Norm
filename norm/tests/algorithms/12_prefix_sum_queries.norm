List prefixSums(Array values) {
  List prefix = List()
  prefix.add(0)
  for int value : values { prefix.add(prefix[prefix.length - 1] + value) }
  return prefix
}

int rangeSum(List prefix, int start, int end) {
  return prefix[end + 1] - prefix[start]
}

void main() {
  List prefix = prefixSums([3, 1, 4, 1, 5, 9])
  print(rangeSum(prefix, start: 0, end: 4))
  print(rangeSum(prefix, start: 3, end: 5))
  print(rangeSum(prefix, start: 1, end: 3))
}
