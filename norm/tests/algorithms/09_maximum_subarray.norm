class Subarray {
  int sum
  int start
  int end
}

Subarray maximumSubarray(Array values) {
  int bestSum = values[0]
  int currentSum = values[0]
  int bestStart = 0
  int bestEnd = 0
  int currentStart = 0
  for index : range(start: 1, end: values.length) {
    if currentSum + values[index] < values[index] {
      currentSum = values[index]
      currentStart = index
    } else {
      currentSum = currentSum + values[index]
    }
    if currentSum > bestSum {
      bestSum = currentSum
      bestStart = currentStart
      bestEnd = index
    }
  }
  return Subarray(sum: bestSum, start: bestStart, end: bestEnd)
}

void main() {
  Subarray result = maximumSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4])
  print(result.sum)
  print(result.start)
  print(result.end)
}
