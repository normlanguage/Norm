class Subarray {
  Integer sum
  Integer start
  Integer end
}

Subarray maximumSubarray(Array<Integer> values) {
  Integer bestSum = values[0]
  Integer currentSum = values[0]
  Integer bestStart = 0
  Integer bestEnd = 0
  Integer currentStart = 0
  for index : range(start: 1, end: values.size()) {
    if currentSum + values[index] < values[index] {
      currentSum = values[index]
      currentStart = index
    } else {
      currentSum = currentSum + values[index]
    }
    if currentSum > bestSum {
      bestSum = currentSum
      bestStart = currentStart
      bestEnd = index
    }
  }
  return Subarray(sum: bestSum, start: bestStart, end: bestEnd)
}

Void main() {
  Subarray result = maximumSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4])
  printLine(result.sum)
  printLine(result.start)
  printLine(result.end)
  expectedOutputLine("6")
  expectedOutputLine("3")
  expectedOutputLine("6")
}
