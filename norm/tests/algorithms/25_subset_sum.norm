Boolean subsetSum(Array<Integer> values, Integer target) {
  List<Boolean> possible = List.filled(size: target + 1, value: false)
  possible[0] = true
  for Integer value : values {
    for step : range(start: 0, end: target - value + 1) {
      Integer sum = target - step
      if possible[sum - value] { possible[sum] = true }
    }
  }
  return possible[target]
}

Void main() {
  printLine(subsetSum(values: [3, 34, 4, 12, 5, 2], target: 9))
  printLine(subsetSum(values: [3, 34, 4, 12, 5, 2], target: 30))
  expectedOutputLine("true")
  expectedOutputLine("false")
}
