import std.math.min

List<int> dijkstra(Array<Array<int>> graph, int source) {
  int infinity = 999999
  List<int> distance = List<int>()
  List<bool> visited = List<bool>()
  for vertex : range(start: 0, end: graph.size()) {
    distance.add(infinity)
    visited.add(false)
  }
  distance[source] = 0
  for step : range(start: 0, end: graph.size()) {
    int chosen = -1
    int smallest = infinity
    for vertex : range(start: 0, end: graph.size()) {
      if !visited[vertex] && distance[vertex] < smallest {
        chosen = vertex
        smallest = distance[vertex]
      }
    }
    if chosen == -1 { break }
    visited[chosen] = true
    Array<int> edges = graph[chosen]
    for next : range(start: 0, end: graph.size()) {
      if edges[next] > 0 && !visited[next] {
        distance[next] = min(left: distance[next], right: distance[chosen] + edges[next])
      }
    }
  }
  return distance
}

void main() {
  Array<Array<int>> graph = [
    [0, 10, 3, 0, 0],
    [0, 0, 0, 2, 0],
    [0, 4, 0, 8, 2],
    [0, 0, 0, 0, 0],
    [0, 0, 0, 9, 0]
  ]
  for int distance : dijkstra(graph, source: 0) { print(distance) }
}

private void expectedOutput() {
  print("0")
  print("7")
  print("3")
  print("9")
  print("5")
}
