List dijkstra(Array graph, int source) {
  int infinity = 999999
  List distance = List()
  List visited = List()
  for vertex : range(start: 0, end: graph.length) {
    distance.add(infinity)
    visited.add(false)
  }
  distance[source] = 0
  for step : range(start: 0, end: graph.length) {
    int chosen = -1
    int smallest = infinity
    for vertex : range(start: 0, end: graph.length) {
      if !visited[vertex] && distance[vertex] < smallest {
        chosen = vertex
        smallest = distance[vertex]
      }
    }
    if chosen == -1 { break }
    visited[chosen] = true
    Array edges = graph[chosen]
    for next : range(start: 0, end: graph.length) {
      if edges[next] > 0 && !visited[next] {
        distance[next] = min(left: distance[next], right: distance[chosen] + edges[next])
      }
    }
  }
  return distance
}

void main() {
  Array graph = [
    [0, 10, 3, 0, 0],
    [0, 0, 0, 2, 0],
    [0, 4, 0, 8, 2],
    [0, 0, 0, 0, 0],
    [0, 0, 0, 9, 0]
  ]
  for int distance : dijkstra(graph, source: 0) { print(distance) }
}
