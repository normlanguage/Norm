Pair sortAndCount(List values) {
  if values.length <= 1 { return Pair(first: values, second: 0) }
  int middle = values.length / 2
  List leftInput = List()
  List rightInput = List()
  for index : range(start: 0, end: values.length) {
    if index < middle { leftInput.add(values[index]) } else { rightInput.add(values[index]) }
  }
  Pair leftResult = sortAndCount(leftInput)
  Pair rightResult = sortAndCount(rightInput)
  List left = leftResult.first
  List right = rightResult.first
  int count = leftResult.second + rightResult.second
  List merged = List()
  int i = 0
  int j = 0
  for step : range(start: 0, end: left.length + right.length) {
    if i >= left.length {
      merged.add(right[j])
      j = j + 1
    } else if j >= right.length || left[i] <= right[j] {
      merged.add(left[i])
      i = i + 1
    } else {
      merged.add(right[j])
      count = count + left.length - i
      j = j + 1
    }
  }
  return Pair(first: merged, second: count)
}

int inversions(Array input) {
  List values = List()
  for int value : input { values.add(value) }
  Pair result = sortAndCount(values)
  return result.second
}

void main() {
  print(inversions([2, 4, 1, 3, 5]))
  print(inversions([1, 2, 3, 4]))
}
