Pair<List<Integer>, Integer> sortAndCount(List<Integer> values) {
  if values.size() <= 1 { return Pair<List<Integer>, Integer>(first: values, second: 0) }
  Integer middle = values.size() / 2
  List<Integer> leftInput = List<Integer>()
  List<Integer> rightInput = List<Integer>()
  for index : range(start: 0, end: values.size()) {
    if index < middle { leftInput.add(values[index]) } else { rightInput.add(values[index]) }
  }
  Pair<List<Integer>, Integer> leftResult = sortAndCount(leftInput)
  Pair<List<Integer>, Integer> rightResult = sortAndCount(rightInput)
  List<Integer> left = leftResult.first
  List<Integer> right = rightResult.first
  Integer count = leftResult.second + rightResult.second
  List<Integer> merged = List<Integer>()
  Integer i = 0
  Integer j = 0
  for step : range(start: 0, end: left.size() + right.size()) {
    if i >= left.size() {
      merged.add(right[j])
      j = j + 1
    } else if j >= right.size() || left[i] <= right[j] {
      merged.add(left[i])
      i = i + 1
    } else {
      merged.add(right[j])
      count = count + left.size() - i
      j = j + 1
    }
  }
  return Pair<List<Integer>, Integer>(first: merged, second: count)
}

Integer inversions(Array<Integer> input) {
  List<Integer> values = List<Integer>()
  for Integer value : input { values.add(value) }
  Pair<List<Integer>, Integer> result = sortAndCount(values)
  return result.second
}

Void main() {
  printLine(inversions([2, 4, 1, 3, 5]))
  printLine(inversions([1, 2, 3, 4]))
  expectedOutputLine("3")
  expectedOutputLine("0")
}
