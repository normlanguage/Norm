Pair<List<int>, int> sortAndCount(List<int> values) {
  if values.size() <= 1 { return Pair<List<int>, int>(first: values, second: 0) }
  int middle = values.size() / 2
  List<int> leftInput = List<int>()
  List<int> rightInput = List<int>()
  for index : range(start: 0, end: values.size()) {
    if index < middle { leftInput.add(values[index]) } else { rightInput.add(values[index]) }
  }
  Pair<List<int>, int> leftResult = sortAndCount(leftInput)
  Pair<List<int>, int> rightResult = sortAndCount(rightInput)
  List<int> left = leftResult.first
  List<int> right = rightResult.first
  int count = leftResult.second + rightResult.second
  List<int> merged = List<int>()
  int i = 0
  int j = 0
  for step : range(start: 0, end: left.size() + right.size()) {
    if i >= left.size() {
      merged.add(right[j])
      j = j + 1
    } else if j >= right.size() || left[i] <= right[j] {
      merged.add(left[i])
      i = i + 1
    } else {
      merged.add(right[j])
      count = count + left.size() - i
      j = j + 1
    }
  }
  return Pair<List<int>, int>(first: merged, second: count)
}

int inversions(Array<int> input) {
  List<int> values = List<int>()
  for int value : input { values.add(value) }
  Pair<List<int>, int> result = sortAndCount(values)
  return result.second
}

void main() {
  print(inversions([2, 4, 1, 3, 5]))
  print(inversions([1, 2, 3, 4]))
}

private void expectedOutput() {
  print("3")
  print("0")
}
