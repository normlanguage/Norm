import std.io.printLines
import std.math.abs
import std.testing.expectedOutputLines

Boolean safe(List<Integer> columns, Integer row, Integer column) {
  for previous : range(start: 0, end: row) {
    if columns[previous] == column { return false }
    if abs(columns[previous] - column) == row - previous { return false }
  }
  return true
}

Integer search(List<Integer> columns, Integer row, Integer size) {
  if row == size { return 1 }
  Integer solutions = 0
  for column : range(start: 0, end: size) {
    if safe(columns, row, column) {
      columns[row] = column
      solutions = solutions + search(columns, row: row + 1, size)
    }
  }
  return solutions
}

Integer nQueens(Integer size) {
  List<Integer> columns = List.filled(size: size, value: -1)
  return search(columns, row: 0, size)
}

Void main() {
  printLines([
    nQueens(4),
    nQueens(5)
  ])
  expectedOutputLines([
    "2",
    "10"
  ])
}
