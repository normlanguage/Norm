class Bezout {
  Integer gcd
  Integer x
  Integer y
}

Bezout extendedGcd(Integer a, Integer b) {
  if b == 0 { return Bezout(gcd: a, x: 1, y: 0) }
  Bezout next = extendedGcd(a: b, b: a % b)
  return Bezout(gcd: next.gcd, x: next.y, y: next.x - (a / b) * next.y)
}

Void main() {
  Bezout result = extendedGcd(a: 30, b: 18)
  printLine(result.gcd)
  printLine(result.x)
  printLine(result.y)
  expectedOutputLine("6")
  expectedOutputLine("-1")
  expectedOutputLine("2")
}
