import std.io.printLines
import std.math.min
import std.testing.expectedOutputLines

Integer minimumLength(Array<Integer> values, Integer target) {
  Integer left = 0
  Integer sum = 0
  Integer best = values.size() + 1
  for right : range(start: 0, end: values.size()) {
    sum = sum + values[right]
    for step : range(start: 0, end: right + 1) {
      if sum >= target {
        best = min(left: best, right: right - left + 1)
        sum = sum - values[left]
        left = left + 1
      } else {
        break
      }
    }
  }
  if best > values.size() { return 0 }
  return best
}

Void main() {
  printLines([
    minimumLength(values: [2, 3, 1, 2, 4, 3], target: 7),
    minimumLength(values: [1, 1, 1], target: 8)
  ])
  expectedOutputLines([
    "2",
    "0"
  ])
}
