Integer select(Array<Integer> values, Integer low, Integer high, Integer wanted) {
  if low == high { return values[low] }
  Integer pivot = values[high]
  Integer boundary = low
  for index : range(start: low, end: high) {
    if values[index] <= pivot {
      Integer temporary = values[boundary]
      values[boundary] = values[index]
      values[index] = temporary
      boundary = boundary + 1
    }
  }
  Integer temporary = values[boundary]
  values[boundary] = values[high]
  values[high] = temporary
  if wanted == boundary { return values[boundary] }
  if wanted < boundary { return select(values, low, high: boundary - 1, wanted) }
  return select(values, low: boundary + 1, high, wanted)
}

Integer kthSmallest(Array<Integer> values, Integer k) {
  return select(values, low: 0, high: values.size() - 1, wanted: k - 1)
}

Void main() {
  Array<Integer> values = [9, 1, 7, 3, 5]
  printLine(kthSmallest(values, k: 3))
  printLine(kthSmallest(values, k: 1))
  printLine(kthSmallest(values, k: 5))
  expectedOutputLine("5")
  expectedOutputLine("1")
  expectedOutputLine("9")
}
