Pair<int, int> twoSum(Array<int> values, int target) {
  Map<int, int> seen = Map<int, int>()
  for index : range(start: 0, end: values.size()) {
    int needed = target - values[index]
    if seen.containsKey(needed) { return Pair<int, int>(first: seen[needed], second: index) }
    seen.put(key: values[index], value: index)
  }
  return Pair<int, int>(first: -1, second: -1)
}

void main() {
  Pair<int, int> found = twoSum(values: [2, 7, 11, 15], target: 9)
  print(found.first)
  print(found.second)
  Pair<int, int> missing = twoSum(values: [1, 2, 3], target: 20)
  print(missing.first)
  print(missing.second)
}

private void expectedOutput() {
  print("0")
  print("1")
  print("-1")
  print("-1")
}
