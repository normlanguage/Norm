import std.math.max

int longestConsecutive(Array<int> values) {
  Set<int> numbers = Set<int>()
  for int value : values { numbers.add(value) }
  int best = 0
  for int value : values {
    if !numbers.contains(value - 1) {
      int length = 1
      for offset : range(start: 1, end: values.size() + 1) {
        if numbers.contains(value + offset) { length = length + 1 } else { break }
      }
      best = max(left: best, right: length)
    }
  }
  return best
}

void main() {
  print(longestConsecutive([100, 4, 200, 1, 3, 2]))
  print(longestConsecutive([9, 9, 9]))
}

private void expectedOutput() {
  print("4")
  print("1")
}
