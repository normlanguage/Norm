import std.math.max

Integer longestConsecutive(Array<Integer> values) {
  Set<Integer> numbers = Set<Integer>()
  for Integer value : values { numbers.add(value) }
  Integer best = 0
  for Integer value : values {
    if !numbers.contains(value - 1) {
      Integer length = 1
      for offset : range(start: 1, end: values.size() + 1) {
        if numbers.contains(value + offset) { length = length + 1 } else { break }
      }
      best = max(left: best, right: length)
    }
  }
  return best
}

Void main() {
  printLine(longestConsecutive([100, 4, 200, 1, 3, 2]))
  printLine(longestConsecutive([9, 9, 9]))
  expectedOutputLine("4")
  expectedOutputLine("1")
}
