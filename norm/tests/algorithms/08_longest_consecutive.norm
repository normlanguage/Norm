import std.io.printLines
import std.math.max
import std.testing.expectedOutputLines

Integer longestConsecutive(Array<Integer> values) {
  Set<Integer> numbers = Set<>()
  for Integer value : values { numbers.add(value) }
  Integer best = 0
  for Integer value : values {
    if !numbers.contains(value - 1) {
      Integer length = 1
      Integer offset = 1
      for numbers.contains(value + offset) {
        length = length + 1
        offset = offset + 1
      }
      best = max(left: best, right: length)
    }
  }
  return best
}

Void main() {
  printLines([
    longestConsecutive([100, 4, 200, 1, 3, 2]),
    longestConsecutive([9, 9, 9])
  ])
  expectedOutputLines([
    "4",
    "1"
  ])
}
