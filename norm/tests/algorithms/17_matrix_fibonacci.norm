import std.io.printLines
import std.testing.expectedOutputLines

class Matrix {
  Integer a
  Integer b
  Integer c
  Integer d
}

Matrix multiply(Matrix left, Matrix right) {
  return Matrix(
    a: left.a * right.a + left.b * right.c,
    b: left.a * right.b + left.b * right.d,
    c: left.c * right.a + left.d * right.c,
    d: left.c * right.b + left.d * right.d
  )
}

Integer fibonacci(Integer n) {
  if n == 0 { return 0 }
  Matrix result = Matrix(a: 1, b: 0, c: 0, d: 1)
  Matrix base = Matrix(a: 1, b: 1, c: 1, d: 0)
  Integer exponent = n
  for exponent != 0 {
    if exponent % 2 == 1 { result = multiply(left: result, right: base) }
    base = multiply(left: base, right: base)
    exponent = exponent / 2
  }
  return result.b
}

Void main() {
  printLines([
    fibonacci(10),
    fibonacci(20)
  ])
  expectedOutputLines([
    "55",
    "6765"
  ])
}
