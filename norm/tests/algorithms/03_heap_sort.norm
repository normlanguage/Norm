import std.testing.expectedOutputLines

Array<Integer> siftDown(Array<Integer> values, Integer size, Integer root) {
  Integer current = root
  for step : range(start: 0, end: size) {
    Integer largest = current
    Integer left = current * 2 + 1
    Integer right = left + 1
    if left < size && values[left] > values[largest] {
      largest = left
    }
    if right < size && values[right] > values[largest] {
      largest = right
    }
    if largest == current {
      break
    }
    Integer temporary = values[current]
    values[current] = values[largest]
    values[largest] = temporary
    current = largest
  }
  return values
}

Array<Integer> heapSort(Array<Integer> values) {
  Integer size = values.size()
  for step : range(start: 0, end: size / 2) {
    Integer root = size / 2 - 1 - step
    values = siftDown(values, size, root)
  }
  for step : range(start: 0, end: size - 1) {
    Integer end = size - 1 - step
    Integer temporary = values[0]
    values[0] = values[end]
    values[end] = temporary
    values = siftDown(values, size: end, root: 0)
  }
  return values
}

main() {
  for Integer value : heapSort([4, 1, 8, 2, 5]) {
    printLine(value)
  }
  expectedOutputLines(["1", "2", "4", "5", "8"])
}
