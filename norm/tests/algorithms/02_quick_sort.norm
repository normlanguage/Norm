import std.testing.expectedOutputLines

Array<Integer> quickSort(Array<Integer> values, Integer low, Integer high) {
  if low >= high {
    return values
  }
  Integer pivot = values[high]
  Integer boundary = low
  for index : range(start: low, end: high) {
    if values[index] <= pivot {
      Integer temporary = values[boundary]
      values[boundary] = values[index]
      values[index] = temporary
      boundary = boundary + 1
    }
  }
  Integer temporary = values[boundary]
  values[boundary] = values[high]
  values[high] = temporary
  values = quickSort(values, low, high: boundary - 1)
  values = quickSort(values, low: boundary + 1, high)
  return values
}

main() {
  Array<Integer> values = [-2, 8, 3, 0, 3, 1]
  values = quickSort(values, low: 0, high: values.size() - 1)
  for Integer value : values {
    printLine(value)
  }
  expectedOutputLines(["-2", "0", "1", "3", "3", "8"])
}
