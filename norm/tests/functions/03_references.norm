import std.io.printLines
import std.testing.expectedOutputLines

T identity<T>(T value) {
  return value
}

class Counter {
  Integer value

  Integer add(Integer amount) {
    value = value + amount
    return value
  }
}

main() {
  Function<String(String)> same = identity
  Counter counter = Counter(value: 10)
  Integer add(Integer amount) = counter.add
  printLines([same("seven"), add(5), counter.value])
  expectedOutputLines(["seven", "15", "15"])
}
