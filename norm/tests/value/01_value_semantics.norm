import std.testing.expectedOutputLines

interface Named {
  String name()
}

value Point implements Named {
  Integer x
  Integer y

  public String name() {
    return "point"
  }
}

value Bucket {
  List<Integer> values
}

String read(Named value) {
  return value.name()
}

main() {
  Point first = Point(x: 1, y: 2)
  Point second = first
  printLine(first == second)
  printLine(read(value: second))

  Map<Point, String> names = Map<>()
  names.put(key: first, value: "origin")
  printLine(names.get(key: second) ?? "missing")

  List<Integer> source = [1]
  Bucket bucket = Bucket(values: source)
  source.add(2)
  printLine(bucket.values.size())

  expectedOutputLines(["true", "point", "origin", "1"])
}
