import std.testing.expectedOutputLines

class Node {
  Integer id
}

value Holder {
  Node node
}

main() {
  Node shared = Node(id: 1)
  Holder first = Holder(node: shared)
  Holder second = Holder(node: shared)
  Holder copied = Holder(node: shared.copy())
  printLine(first == second)
  printLine(first == copied)
  expectedOutputLines(["true", "false"])
}

