import std.io.printLines
import std.testing.expectedOutputLines

Integer choose(Integer value) { return value + 1 }
String choose(String value) { return value + "!" }

Void main() {
  printLines([
    choose(value: 4),
    choose(value: "Norm")
  ])
  expectedOutputLines([
    "5",
    "Norm!"
  ])
}
