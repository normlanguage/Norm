import std.io.printLines
import std.testing.expectedOutputLines

String kind(CodePoint value) { return "codePoint" }
String kind(String value) { return "string" }

Void main() {
  printLines([
    kind(value: 'A'),
    kind(value: "A")
  ])
  expectedOutputLines([
    "codePoint",
    "string"
  ])
}
