import std.io.printLines
import std.testing.expectedOutputLines

class Formatter {
  String format(Integer value) { return "integer" }
  String format(String value) { return value }
}

Void main() {
  Formatter formatter = Formatter()
  printLines([
    formatter.format(value: 7),
    formatter.format(value: "text")
  ])
  expectedOutputLines([
    "integer",
    "text"
  ])
}
