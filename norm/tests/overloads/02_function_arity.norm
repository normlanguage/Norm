import std.io.printLines
import std.testing.expectedOutputLines

Integer total(Integer value) { return value }
Integer total(Integer left, Integer right) { return left + right }

Void main() {
  printLines([
    total(value: 3),
    total(left: 3, right: 4)
  ])
  expectedOutputLines([
    "3",
    "7"
  ])
}
