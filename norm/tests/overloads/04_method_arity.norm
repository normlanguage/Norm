import std.io.printLines
import std.testing.expectedOutputLines

class Counter {
  Integer add(Integer value) {
    return value
  }

  Integer add(Integer left, Integer right) {
    return left + right
  }
}

main() {
  Counter counter = Counter()
  printLines([counter.add(value: 2), counter.add(left: 2, right: 5)])
  expectedOutputLines(["2", "7"])
}
