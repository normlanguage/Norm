import std.io.printLines
import std.testing.expectedOutputLines

String label(String value) { return "present:" + value }
String label(String? value) { return value ?? "missing" }

Void main() {
  printLines([
    label(value: "x"),
    label(value: null)
  ])
  expectedOutputLines([
    "present:x",
    "missing"
  ])
}
