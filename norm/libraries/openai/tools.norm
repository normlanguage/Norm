package openai

import std.annotation.Document
import std.annotation.FunctionTarget
import std.annotation.ParameterTarget
import std.annotation.RuntimeRetention
import std.json.JsonValue
import std.json.JsonException
import std.json.functionSchema
import std.json.invokeJson

@Document(description: "Public API declaration Tool.")
public annotation Tool implements FunctionTarget, RuntimeRetention {
  @Document(description: "The tool or parameter description.") String description
  @Document(description: "The optional exposed tool name.") String? name
}

@Document(description: "Public API declaration ToolParameter.")
public annotation ToolParameter implements ParameterTarget, RuntimeRetention {
  @Document(description: "The tool or parameter description.") String description
}

@Document(description: "Public API declaration ToolCatalog.")
public class ToolCatalog {
  private ToolRegistry? accepted = null
  private String? failure = null

  @Document(description: "Public API declaration refresh.")
  public ToolRegistry refresh(@Document(description: "The tool functions.") List<Function<?>> tools) {
    try {
      var candidate = ToolRegistry(tools: tools)
      accepted = candidate
      failure = null
      return candidate
    } catch OpenAiException error {
      ToolRegistry? current = accepted
      if error.code != "OPENAI-INVALID-TOOL" || current == null { throw error }
      failure = "Tool catalog rejected: " + error.code + " " + error.message
      return current
    }
  }

  @Document(description: "Public API declaration rejection.")
  public String? rejection() { return failure }
}

@Document(description: "Public API declaration ToolRegistry.")
public class ToolRegistry {
  private Map<String, Function<?>> operations = Map<>()
  private List<ToolDefinition> descriptions = []

  @Document(description: "Creates a tool registry.") ToolRegistry(@Document(description: "The tool functions.") List<Function<?>> tools) {
    this.operations = Map<>()
    this.descriptions = []
    for Function<?> candidate : tools {
      Function<?> operation = candidate.snapshot()
      Tool? metadata = operation.annotation<Tool>()
      if metadata == null { throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: "Tool functions require @Tool") }
      String name = metadata.name ?? operation.name()
      if name.isBlank || metadata.description.isBlank || operations.containsKey(key: name) {
        throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: "Tool names must be unique and descriptions must not be empty: " + name)
      }
      JsonValue schema = JsonValue.Null
      try { schema = functionSchema(operation: operation) }
      catch JsonException error {
        Boolean contractFailure = error.code == "NORM-JSON-FUNCTION" || error.code == "NORM-JSON-UNSUPPORTED-TYPE"
          || error.code == "NORM-JSON-DUPLICATE-NAME" || error.code == "NORM-JSON-IGNORED-FIELD" || error.code == "NORM-JSON-NAME"
        if !contractFailure { throw error }
        throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: name + ": " + error.code + " " + error.message)
      }
      Map<String, JsonValue> fields = switch schema {
        case Object(Map<String, JsonValue> fields) { break fields }
        case _ { throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: "Expected an object schema") }
      }
      Map<String, JsonValue> properties = switch fields.get(key: "properties") ?? JsonValue.Null {
        case Object(Map<String, JsonValue> values) { break values }
        case _ { throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: "Expected parameter properties") }
      }
      for Parameter<?> parameter : operation.parameters() {
        ToolParameter? details = parameter.annotation<ToolParameter>()
        if details != null {
          Map<String, JsonValue> property = switch properties.get(key: parameter.name()) ?? JsonValue.Null {
            case Object(Map<String, JsonValue> values) { break values }
            case _ { throw OpenAiException(code: "OPENAI-INVALID-TOOL", message: "Missing parameter schema") }
          }
          property.put(key: "description", value: JsonValue.String(value: details.description))
          properties.put(key: parameter.name(), value: JsonValue.Object(fields: property))
        }
      }
      fields.put(key: "properties", value: JsonValue.Object(fields: properties))
      operations.put(key: name, value: operation)
      descriptions.add(ToolDefinition(name: name, description: metadata.description, parameters: JsonValue.Object(fields: fields)))
    }
  }

  @Document(description: "Public API declaration definitions.")
  public List<ToolDefinition> definitions() { return descriptions }

  @Document(description: "Public API declaration invoke.")
  public String invoke(@Document(description: "The tool call.") ToolCall call) {
    Function<?>? operation = operations.get(key: call.name)
    if operation == null { throw OpenAiException(code: "OPENAI-UNKNOWN-TOOL", message: "Unknown tool: " + call.name) }
    String arguments = if call.arguments.isBlank && operation.parameters().isEmpty() { "{}" } else { call.arguments }
    return invokeJson(operation: operation, arguments: arguments)
  }
}
