package openai

import std.core.Exception
import std.annotation.Document

@Document(description: "Public API declaration Message.")
public value Message {
  @Document(description: "The message identifier.") String id
  @Document(description: "The rendered message text.") String text
  @Document(description: "The refusal text, when present.") String? refusal = null
}
@Document(description: "Public API declaration ToolResult.")
public value ToolResult {
  @Document(description: "The completed tool call.") ToolCall call
  @Document(description: "The serialized tool result.") String output
}
@Document(description: "Public API declaration ToolFailure.")
public value ToolFailure {
  @Document(description: "The failed tool call.") ToolCall call
  @Document(description: "The tool failure.") Exception error
}

@Document(description: "Public API declaration GenerationEvent.")
public enum GenerationEvent {
  ResponseStarted(String id),
  MessageStarted(String id),
  Text(String text),
  MessageCompleted(Message message),
  ToolCallReceived(ToolCall call),
  ToolStarted(ToolCall call),
  ToolCompleted(ToolResult result),
  ToolFailed(ToolFailure failure),
  ResponseCompleted(Response response),
  Failed(Exception error),
  RunStarted(String input),
  RunCompleted(Response response)
}

@Document(description: "Public API declaration GenerationCallbacks.")
public class GenerationCallbacks {
  @Document(description: "Receives response start notifications.") Function<Void(String)>? onResponseStarted = null
  @Document(description: "Receives message start notifications.") Function<Void(String)>? onMessageStarted = null
  @Document(description: "Receives streamed text notifications.") Function<Void(String)>? onText = null
  @Document(description: "Receives completed message notifications.") Function<Void(Message)>? onMessageCompleted = null
  @Document(description: "Receives tool call notifications.") Function<Void(ToolCall)>? onToolCallReceived = null
  @Document(description: "Receives tool start notifications.") Function<Void(ToolCall)>? onToolStarted = null
  @Document(description: "Receives completed tool notifications.") Function<Void(ToolResult)>? onToolCompleted = null
  @Document(description: "Receives failed tool notifications.") Function<Void(ToolFailure)>? onToolFailed = null
  @Document(description: "Receives completed response notifications.") Function<Void(Response)>? onResponseCompleted = null
  @Document(description: "Receives generation failure notifications.") Function<Void(Exception)>? onFailed = null
  @Document(description: "Receives run start notifications.") Function<Void(String)>? onRunStarted = null
  @Document(description: "Receives run completion notifications.") Function<Void(Response)>? onRunCompleted = null
  @Document(description: "Receives generation event notifications.") Function<Void(GenerationEvent)>? onEvent = null

  @Document(description: "Public API declaration emit.")
  public Void emit(@Document(description: "The event to emit.") GenerationEvent event) {
    var all = onEvent
    if all != null { all(event) }
    switch event {
      case ResponseStarted(String id) { var callback = onResponseStarted if callback != null { callback(id) } }
      case MessageStarted(String id) { var callback = onMessageStarted if callback != null { callback(id) } }
      case Text(String text) { var callback = onText if callback != null { callback(text) } }
      case MessageCompleted(Message message) { var callback = onMessageCompleted if callback != null { callback(message) } }
      case ToolCallReceived(ToolCall call) { var callback = onToolCallReceived if callback != null { callback(call) } }
      case ToolStarted(ToolCall call) { var callback = onToolStarted if callback != null { callback(call) } }
      case ToolCompleted(ToolResult result) { var callback = onToolCompleted if callback != null { callback(result) } }
      case ToolFailed(ToolFailure failure) { var callback = onToolFailed if callback != null { callback(failure) } }
      case ResponseCompleted(Response response) { var callback = onResponseCompleted if callback != null { callback(response) } }
      case Failed(Exception error) { var callback = onFailed if callback != null { callback(error) } }
      case RunStarted(String input) { var callback = onRunStarted if callback != null { callback(input) } }
      case RunCompleted(Response response) { var callback = onRunCompleted if callback != null { callback(response) } }
    }
  }
}
