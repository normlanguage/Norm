package agent

import openai.OpenAiException
import std.http.HttpClient
import std.http.HttpResponse
import std.http.Uri
import std.http.get
import std.http.systemHttpClient
import std.io.TextEncoding
import std.io.decodeText
import std.io.readAll
import std.time.Duration
import std.time.duration

public value Skill {
  String name
  String content
}

public Skill loadSkill(
  String name,
  String url,
  HttpClient client = systemHttpClient(),
  Duration timeout = duration(seconds: 30, nanoseconds: 0)
) {
  HttpResponse response = client.send(request: get(uri: Uri(value: url)), timeout: timeout)
  try {
    Integer status = response.status().code
    if status < 200 || status >= 300 {
      throw OpenAiException(
        code: "OPENAI-SKILL-HTTP",
        message: "Skill '" + name + "' returned HTTP status " + status.toString()
      )
    }
    return Skill(
      name: name,
      content: decodeText(
        content: readAll(reader: response, maximumBytes: 1048576),
        encoding: TextEncoding.Utf8
      )
    )
  } finally {
    response.close()
  }
}
