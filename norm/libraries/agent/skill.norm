package agent

import std.annotation.Document

import openai.OpenAiException
import std.http.HttpClient
import std.http.HttpResponse
import std.http.Uri
import std.http.get
import std.http.systemHttpClient
import std.io.TextEncoding
import std.io.decodeText
import std.io.readAll
import std.time.Duration
import std.time.duration

@Document(description: "Public API declaration Skill.")
public class Skill {
  @Document(description: "Public API declaration name.")
  public String name
  @Document(description: "Public API declaration url.")
  public String url

  @Document(description: "Creates a Skill from a remote URL.") Skill(@Document(description: "The Skill URL.") String url) {
    if url.isBlank { throw OpenAiException(code: "OPENAI-SKILL-INVALID", message: "Skill URL must not be blank") }
    this.name = url
    this.url = url
  }

  @Document(description: "Creates a named Skill from a remote URL.") Skill(@Document(description: "The Skill name.") String name, @Document(description: "The Skill URL.") String url) {
    if name.isBlank { throw OpenAiException(code: "OPENAI-SKILL-INVALID", message: "Skill name must not be blank") }
    if url.isBlank { throw OpenAiException(code: "OPENAI-SKILL-INVALID", message: "Skill URL must not be blank") }
    this.name = name
    this.url = url
  }
}

@Document(description: "Loads Skills from remote URLs.")
class SkillLoader {
  @Document(description: "Fetches a Skill document from its URL.")
  String fetch(
    @Document(description: "The Skill to load.") Skill skill,
    @Document(description: "The HTTP client.") HttpClient client = systemHttpClient(),
    @Document(description: "The request timeout.") Duration timeout = duration(seconds: 30, nanoseconds: 0)
  ) {
    HttpResponse response = client.send(request: get(uri: Uri(value: skill.url)), timeout: timeout)
    try {
      Integer status = response.status().code
      if status < 200 || status >= 300 {
        throw OpenAiException(
          code: "OPENAI-SKILL-HTTP",
          message: "Skill '" + skill.name + "' returned HTTP status " + status.toString()
        )
      }
      return decodeText(
        content: readAll(reader: response, maximumBytes: 1048576),
        encoding: TextEncoding.Utf8
      )
    } finally {
      response.close()
    }
  }
}
