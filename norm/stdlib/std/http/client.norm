@Document(description: "Provides typed HTTP requests, responses, clients, headers, status values, and transport failures.")
package std.http

import std.annotation.Document
import std.io.ByteReader
import std.io.Bytes
import std.io.IOException
import std.io.ReadChunk
import std.io.Resource
import std.time.Duration

@Document(description: "Stores an absolute or relative URI string accepted by the HTTP transport.")
public value Uri {
  @Document(description: "The URI text passed to the transport.")
  String value
}

@Document(description: "Selects an HTTP request method: GET, HEAD, POST, PUT, PATCH, DELETE, or OPTIONS.")
public enum HttpMethod { Get, Head, Post, Put, Patch, Delete, Options }

@Document(description: "Represents one HTTP header name and value pair.")
public value HttpHeader {
  @Document(description: "The case-insensitive HTTP header name.")
  String name

  @Document(description: "The HTTP header value.")
  String value
}

@Document(description: "Preserves an ordered collection of HTTP headers, including repeated names.")
public value HeaderMap {
  @Document(description: "The headers in transport order.")
  Array<HttpHeader> values
}

@Document(description: "Represents a numeric HTTP response status code.")
public value Status {
  @Document(description: "The three-digit HTTP status code.")
  Integer code
}

@Document(description: "Describes an HTTP request before it is sent by a client.")
public value HttpRequest {
  @Document(description: "The HTTP request method.")
  HttpMethod method

  @Document(description: "The request target URI.")
  Uri uri

  @Document(description: "The ordered request headers.")
  HeaderMap headers

  @Document(description: "The optional request body bytes.")
  Bytes? body
}

@Document(description: "Identifies whether an HTTP failure occurred while sending, reading, or closing.")
public enum HttpOperation { Send, Read, Close }

@Document(description: "Classifies HTTP request, connection, timeout, cancellation, TLS, protocol, closure, and I/O failures.")
public enum HttpFailure {
  InvalidRequest,
  Connect,
  Timeout,
  Cancelled,
  Tls,
  Protocol,
  Closed,
  Io
}

@Document(description: "Reports a typed HTTP transport failure for a specific operation and URI.")
public class HttpException extends IOException {
  @Document(description: "The HTTP operation that failed.")
  HttpOperation operation

  @Document(description: "The transport failure category.")
  HttpFailure reason

  @Document(description: "The request URI associated with the failure.")
  Uri uri

  @Document(description: "Creates a typed HTTP transport failure.")
  HttpException(
    @Document(description: "The stable machine-readable failure code.") String code,
    @Document(description: "The human-readable failure explanation.") String message,
    @Document(description: "The HTTP operation that failed.") HttpOperation operation,
    @Document(description: "The transport failure category.") HttpFailure reason,
    @Document(description: "The request URI associated with the failure.") Uri uri
  ) {
    super(code: code, message: message)
    this.operation = operation
    this.reason = reason
    this.uri = uri
  }
}

@Document(description: "Streams an HTTP response body and exposes its status and headers.")
public interface HttpResponse extends ByteReader, Resource {
  @Document(description: "Returns the response status code.")
  Status status()

  @Document(description: "Returns the response headers in transport order.")
  HeaderMap headers()
}

@Document(description: "Sends HTTP requests with an explicit timeout.")
public interface HttpClient {
  @Document(description: "Sends one request and returns a streaming response.")
  HttpResponse send(
    @Document(description: "The request to send.") HttpRequest request,
    @Document(description: "The positive timeout for the complete send operation.") Duration timeout
  )
}

private class HttpResponseValue implements HttpResponse {
  public Status status() {
    return Status(code: __httpStatus(response: this))
  }

  public HeaderMap headers() {
    Array<String> encoded = __httpHeaders(response: this)
    Array<HttpHeader> values = Array.filled(
      size: encoded.size() / 2,
      value: HttpHeader(name: "", value: "")
    )
    for index : range(start: 0, end: values.size()) {
      values[index] = HttpHeader(
        name: encoded[index * 2],
        value: encoded[index * 2 + 1]
      )
    }
    return HeaderMap(values: values)
  }

  public ReadChunk read(Integer maximumBytes) {
    Bytes? content = __httpRead<Bytes>(response: this, maximumBytes: maximumBytes)
    if content == null {
      return ReadChunk.Eof
    }
    return ReadChunk.Data(bytes: content)
  }

  public Void close() {
    __httpClose(response: this)
  }
}

private value SystemHttpClient implements HttpClient {
  public HttpResponse send(HttpRequest request, Duration timeout) {
    if timeout.seconds() < 0 || timeout.seconds() == 0 && timeout.nanoseconds() == 0 {
      throw HttpException(
        code: "NORM-HTTP-INVALID-REQUEST",
        message: "HTTP timeout must be positive",
        operation: HttpOperation.Send,
        reason: HttpFailure.InvalidRequest,
        uri: request.uri
      )
    }
    String method = switch request.method {
      case Get { break "GET" }
      case Head { break "HEAD" }
      case Post { break "POST" }
      case Put { break "PUT" }
      case Patch { break "PATCH" }
      case Delete { break "DELETE" }
      case Options { break "OPTIONS" }
    }
    Array<String> headers = Array.filled(
      size: request.headers.values.size() * 2,
      value: ""
    )
    for HttpHeader header,index : request.headers.values {
      headers[index * 2] = header.name
      headers[index * 2 + 1] = header.value
    }
    return __httpSend<HttpResponseValue>(
      method: method,
      uri: request.uri.value,
      headers: headers,
      body: request.body,
      timeoutSeconds: timeout.seconds(),
      timeoutNanoseconds: timeout.nanoseconds()
    )
  }
}

@Document(description: "Returns the process-wide HTTP client backed by the host transport.")
public HttpClient systemHttpClient() {
  return SystemHttpClient()
}

@Document(description: "Creates an HTTP request from explicit method, URI, headers, and optional body values.")
public HttpRequest request(
  @Document(description: "The HTTP request method.") HttpMethod method,
  @Document(description: "The request target URI.") Uri uri,
  @Document(description: "The ordered request headers.") HeaderMap headers,
  @Document(description: "The optional request body bytes.") Bytes? body
) {
  return HttpRequest(method: method, uri: uri, headers: headers, body: body)
}

@Document(description: "Creates a GET request with no headers or body.")
public HttpRequest get(
  @Document(description: "The request target URI.") Uri uri
) {
  return HttpRequest(
    method: HttpMethod.Get,
    uri: uri,
    headers: HeaderMap(values: []),
    body: null
  )
}
