package std.http

import std.annotation.Document
import std.io.Bytes
import std.json.fromJsonBytes
import std.json.toJsonBytes

@Document(description: "Encodes a value as UTF-8 JSON request-body bytes.")
public Bytes jsonBody<T>(
  @Document(description: "The value to encode as JSON.") T value
) {
  return toJsonBytes(value: value)
}

@Document(description: "Creates an HTTP request with a JSON body and a canonical application/json content type.")
public HttpRequest jsonRequest<T>(
  @Document(description: "The HTTP request method.") HttpMethod method,
  @Document(description: "The request target URI.") Uri uri,
  @Document(description: "The request headers to preserve and normalize.") HeaderMap headers,
  @Document(description: "The value to encode as the JSON request body.") T body
) {
  Boolean hasContentType = false
  for HttpHeader header : headers.values {
    if header.name.equalsIgnoreCaseAscii(other: "Content-Type") {
      hasContentType = true
    }
  }
  Integer size = headers.values.size()
  if !hasContentType {
    size = size + 1
  }
  Array<HttpHeader> values = Array.filled(
    size: size,
    value: HttpHeader(name: "", value: "")
  )
  for HttpHeader header,index : headers.values {
    values[index] = header
    if header.name.equalsIgnoreCaseAscii(other: "Content-Type") {
      values[index] = HttpHeader(name: "Content-Type", value: "application/json")
    }
  }
  if !hasContentType {
    values[headers.values.size()] = HttpHeader(
      name: "Content-Type",
      value: "application/json"
    )
  }
  return HttpRequest(
    method: method,
    uri: uri,
    headers: HeaderMap(values: values),
    body: toJsonBytes(value: body)
  )
}

@Document(description: "Creates a POST request with a JSON body and no additional headers.")
public HttpRequest postJson<T>(
  @Document(description: "The request target URI.") Uri uri,
  @Document(description: "The value to encode as the JSON request body.") T body
) {
  return jsonRequest(
    method: HttpMethod.Post,
    uri: uri,
    headers: HeaderMap(values: []),
    body: body
  )
}

@Document(description: "Decodes UTF-8 JSON response-body bytes into a value of type T.")
public T decodeJson<T>(
  @Document(description: "The JSON response-body bytes to decode.") Bytes body
) {
  return body.fromJsonBytes<T>()
}
