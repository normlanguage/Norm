package std.text

import std.annotation.Document

@Document(description: "Selects NFC, NFD, NFKC, or NFKD Unicode normalization.")
enum Normalization { Nfc, Nfd, Nfkc, Nfkd }

@Document(description: "Returns a string normalized to the selected Unicode form.")
String normalize(
  @Document(description: "The string to normalize.") String value,
  @Document(description: "The normalization form to produce.") Normalization form
) {
  if form == Normalization.Nfc {
    return value.normalizeNfc()
  }
  if form == Normalization.Nfd {
    return value.normalizeNfd()
  }
  if form == Normalization.Nfkc {
    return value.normalizeNfkc()
  }
  return value.normalizeNfkd()
}

@Document(description: "Reports whether a string already has the selected Unicode normalization form.")
Boolean isNormalized(
  @Document(description: "The string to inspect.") String value,
  @Document(description: "The normalization form to test.") Normalization form
) {
  if form == Normalization.Nfc {
    return value.isNormalizedNfc()
  }
  if form == Normalization.Nfd {
    return value.isNormalizedNfd()
  }
  if form == Normalization.Nfkc {
    return value.isNormalizedNfkc()
  }
  return value.isNormalizedNfkd()
}
