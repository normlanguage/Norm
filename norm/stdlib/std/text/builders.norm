@Document(description: "Provides text construction and Unicode normalization operations.")
package std.text

import std.annotation.Document

@Document(description: "Concatenates a string with itself the requested number of times.")
String repeat(
  @Document(description: "The string to repeat.") String value,
  @Document(description: "The number of repetitions.") Integer count
) {
  StringBuilder result = StringBuilder()
  for index : range(start: 0, end: count) {
    result.append(value)
  }
  return result.toString()
}

@Document(description: "Joins strings in list order with a separator between adjacent values.")
String join(
  @Document(description: "The strings to join.") List<String> values,
  @Document(description: "The string inserted between adjacent values.") String separator
) {
  StringBuilder result = StringBuilder()
  for index : range(start: 0, end: values.size()) {
    if index > 0 {
      result.append(separator)
    }
    result.append(values[index])
  }
  return result.toString()
}

@Document(description: "Builds a string from Unicode code points in array order.")
String fromCodePoints(
  @Document(description: "The Unicode code points to append.") Array<CodePoint> values
) {
  StringBuilder result = StringBuilder()
  for CodePoint value : values {
    result.append(value)
  }
  return result.toString()
}
