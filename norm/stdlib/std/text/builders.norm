package std.text

String repeat(String value, Integer count) {
  StringBuilder result = StringBuilder()
  for index : range(start: 0, end: count) {
    result.append(value)
  }
  return result.toString()
}

String join(List<String> values, String separator) {
  StringBuilder result = StringBuilder()
  for index : range(start: 0, end: values.size()) {
    if index > 0 {
      result.append(separator)
    }
    result.append(values[index])
  }
  return result.toString()
}

String fromCodePoints(Array<CodePoint> values) {
  StringBuilder result = StringBuilder()
  for CodePoint value : values {
    result.append(value)
  }
  return result.toString()
}
