package std.core

interface Iterator<T> {
  Boolean hasNext()

  T next()
}

interface Iterable<T> {
  Iterator<T> iterator()

  List<R> map<R>(R transform(T value)) {
    List<R> result = List<>()
    for value : this {
      result.add(transform(value))
    }
    return result
  }
}

interface Sized {
  Integer size()
}

interface Comparable<T> {
  Integer compareTo(T other)
}

interface Equatable<T> {
  Boolean equals(T other)
}

interface Hashable {
  Integer hash()
}

interface Stringable {
  String toString()
}
