package std.math

Integer min(Integer left, Integer right) {
  if left < right {
    return left
  }
  return right
}

Integer max(Integer left, Integer right) {
  if left > right {
    return left
  }
  return right
}

Integer abs(Integer value) {
  if value < 0 {
    return -value
  }
  return value
}

Integer clamp(Integer value, Integer minimum, Integer maximum) {
  require(condition: minimum <= maximum, message: "clamp minimum must not exceed maximum")
  if value < minimum {
    return minimum
  }
  if value > maximum {
    return maximum
  }
  return value
}

Integer sign(Integer value) {
  if value < 0 {
    return -1
  }
  if value > 0 {
    return 1
  }
  return 0
}
