package std.test.collections.sort_code_point_list

import std.testing.Test
import std.collections.sort
import std.testing.expectedOutputLines

@Test
Void sortCodePointListTest() {
  List<CodePoint> source = List<>()
  source.add('😀')
  source.add('é')
  source.add('A')
  for value : sort(values: source) {
    printLine(value)
  }
  expectedOutputLines(["A", "é", "😀"])
}
