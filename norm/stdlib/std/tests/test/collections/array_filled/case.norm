package std.test.collections.array_filled

import std.testing.Test
import std.testing.expectedOutputLines

@Test
Void arrayFilledTest() {
  Array<Boolean> values = Array.filled(size: 3, value: false)
  values[2] = true
  for value : values {
    printLine(value)
  }
  expectedOutputLines(["false", "false", "true"])
}
