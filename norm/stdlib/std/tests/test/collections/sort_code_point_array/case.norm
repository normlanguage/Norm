package std.test.collections.sort_code_point_array

import std.testing.Test
import std.collections.sort
import std.testing.expectedOutputLines

@Test
Void sortCodePointArrayTest() {
  Array<CodePoint> values = sort(values: ['z', '中', 'A'])
  for value : values {
    printLine(value)
  }
  expectedOutputLines(["A", "z", "中"])
}
