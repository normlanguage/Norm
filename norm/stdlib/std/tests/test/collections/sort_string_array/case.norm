package std.test.collections.sort_string_array

import std.testing.Test
import std.collections.sort
import std.testing.expectedOutputLines

@Test
Void sortStringArrayTest() {
  Array<String> values = sort(values: ["β", "a", "aa", "A"])
  for value : values {
    printLine(value)
  }
  expectedOutputLines(["A", "a", "aa", "β"])
}
