package std.test.collections.array_reversed

import std.testing.Test
import std.testing.expectedOutputLines

@Test
Void arrayReversedTest() {
  Array<String> source = ["A", "B", "C"]
  Array<String> result = source.reversed()
  result[0] = "Z"
  printLine(source[0])
  for value : result {
    printLine(value)
  }
  expectedOutputLines(["A", "Z", "B", "A"])
}
