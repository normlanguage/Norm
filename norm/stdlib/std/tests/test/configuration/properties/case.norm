package std.test.configuration.properties

import std.testing.Test
import java.base.util.JavaMap
import std.configuration.ConfigurationKey
import std.configuration.ConfigurationValue
import std.configuration.configurationProperties
import std.serialization.SerialName
import std.serialization.Serializable
import std.testing.expectedOutputLines

@Serializable()
value Endpoint {
  @ConfigurationKey()
  String name
  String contextPath
}

@Serializable()
value Secret {
  @ConfigurationValue()
  String value
}

@Serializable()
value Service {
  List<Endpoint> endpoints
  Map<String, Endpoint> targets
  @SerialName(name: "api-key")
  Secret secret
  String? description
}

@Test(types: [JavaMap<String, Any>.class, ConfigurationKey.class, ConfigurationValue.class, SerialName.class, Serializable.class], functions: [configurationProperties.function])
Void propertiesTest() {
  Map<String, Endpoint> targets = Map<>()
  targets.put(
    key: "internal",
    value: Endpoint(name: "unused", contextPath: "/internal")
  )
  JavaMap<String, Any> properties = configurationProperties(value: Service(
    endpoints: [Endpoint(name: "public", contextPath: "/api")],
    targets: targets,
    secret: Secret(value: "norm"),
    description: null
  ))
  printLine(properties.get(arg0: "endpoints.public.context-path") ?? "missing")
  printLine(properties.get(arg0: "targets.internal.context-path") ?? "missing")
  printLine(properties.get(arg0: "api-key") ?? "missing")
  printLine(properties.containsKey(arg0: "description"))
  expectedOutputLines(["/api", "/internal", "norm", "false"])
}
