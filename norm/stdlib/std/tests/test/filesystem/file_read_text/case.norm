package std.test.filesystem.file_read_text

import std.testing.Test
import std.filesystem.Path
import std.filesystem.readText
import std.io.TextEncoding
import std.testing.expectedOutputLines

@Test(types: [Path.class, TextEncoding.class])
Void fileReadTextTest() {
  String text = readText(
    path: Path(value: "file_read_text.txt"),
    encoding: TextEncoding.Utf8,
    maximumBytes: 1024
  ).trim()
  printLine(text)
  printLine(readText("file_read_text.txt").trim())
  expectedOutputLines(["Norm filesystem", "Norm filesystem"])
}
