package std.collections

Boolean listContains<T>(List<T> values, T target) {
  for T value : values {
    if value == target {
      return true
    }
  }
  return false
}

Integer listCount<T>(List<T> values, T target) {
  Integer count = 0
  for T value : values {
    if value == target {
      count = count + 1
    }
  }
  return count
}

List<T> toList<T>(Array<T> values) {
  List<T> result = List<>()
  for T value : values {
    result.add(value)
  }
  return result
}

List<Integer> sort(List<Integer> values) {
  List<Integer> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1] > result[index] {
      Integer temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

Array<Integer> sort(Array<Integer> values) {
  Array<Integer> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1] > result[index] {
      Integer temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

List<CodePoint> sort(List<CodePoint> values) {
  List<CodePoint> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].scalarValue() > result[index].scalarValue() {
      CodePoint temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

Array<CodePoint> sort(Array<CodePoint> values) {
  Array<CodePoint> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].scalarValue() > result[index].scalarValue() {
      CodePoint temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

List<String> sort(List<String> values) {
  List<String> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].compareCodePoints(result[index]) > 0 {
      String temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

Array<String> sort(Array<String> values) {
  Array<String> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].compareCodePoints(result[index]) > 0 {
      String temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}
