@Document(description: "Provides reusable operations for List and Array sequences.")
package std.collections

import std.annotation.Document

@Document(description: "Reports whether a list contains a value equal to the target.")
Boolean listContains<T>(
  @Document(description: "The list to search.") List<T> values,
  @Document(description: "The value to find.") T target
) {
  for T value : values {
    if value == target {
      return true
    }
  }
  return false
}

@Document(description: "Counts values in a list that are equal to the target.")
Integer listCount<T>(
  @Document(description: "The list to search.") List<T> values,
  @Document(description: "The value to count.") T target
) {
  Integer count = 0
  for T value : values {
    if value == target {
      count = count + 1
    }
  }
  return count
}

@Document(description: "Copies an array into a mutable list while preserving order.")
List<T> toList<T>(
  @Document(description: "The array whose values are copied.") Array<T> values
) {
  List<T> result = List<>()
  for T value : values {
    result.add(value)
  }
  return result
}

@Document(description: "Returns the integer list values in ascending numeric order.")
List<Integer> sort(
  @Document(description: "The integer list to sort.") List<Integer> values
) {
  List<Integer> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1] > result[index] {
      Integer temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

@Document(description: "Returns the integer array values in ascending numeric order.")
Array<Integer> sort(
  @Document(description: "The integer array to sort.") Array<Integer> values
) {
  Array<Integer> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1] > result[index] {
      Integer temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

@Document(description: "Returns the code point list values in ascending scalar-value order.")
List<CodePoint> sort(
  @Document(description: "The code point list to sort.") List<CodePoint> values
) {
  List<CodePoint> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].scalarValue() > result[index].scalarValue() {
      CodePoint temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

@Document(description: "Returns the code point array values in ascending scalar-value order.")
Array<CodePoint> sort(
  @Document(description: "The code point array to sort.") Array<CodePoint> values
) {
  Array<CodePoint> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].scalarValue() > result[index].scalarValue() {
      CodePoint temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

@Document(description: "Returns the string list values in ascending code point order.")
List<String> sort(
  @Document(description: "The string list to sort.") List<String> values
) {
  List<String> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].compareCodePoints(result[index]) > 0 {
      String temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}

@Document(description: "Returns the string array values in ascending code point order.")
Array<String> sort(
  @Document(description: "The string array to sort.") Array<String> values
) {
  Array<String> result = values
  for end : range(start: 1, end: result.size()) {
    Integer index = end
    for index > 0 && result[index - 1].compareCodePoints(result[index]) > 0 {
      String temporary = result[index]
      result[index] = result[index - 1]
      result[index - 1] = temporary
      index = index - 1
    }
  }
  return result
}
