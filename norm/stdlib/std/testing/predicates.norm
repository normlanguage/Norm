package std.testing

import std.annotation.Document

@Document(description: "Reports whether an actual value equals the expected value.")
Boolean equal<T>(
  @Document(description: "The value produced by the test subject.") T actual,
  @Document(description: "The value required by the test.") T expected
) {
  return actual == expected
}

@Document(description: "Reports whether an actual value differs from the expected value.")
Boolean notEqual<T>(
  @Document(description: "The value produced by the test subject.") T actual,
  @Document(description: "The value that must not match.") T expected
) {
  return actual != expected
}

@Document(description: "Returns the supplied Boolean for a positive truth assertion.")
Boolean isTrue(
  @Document(description: "The Boolean value under test.") Boolean actual
) {
  return actual
}

@Document(description: "Reports whether the supplied Boolean is false.")
Boolean isFalse(
  @Document(description: "The Boolean value under test.") Boolean actual
) {
  return !actual
}
