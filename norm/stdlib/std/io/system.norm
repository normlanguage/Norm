package std.io

import std.annotation.Document
import std.system.SystemException

@Document(description: "Selects the text encoding used to convert between strings and bytes.")
public enum TextEncoding { Utf8 }

@Document(description: "Identifies text encoding and decoding operations.")
public enum TextOperation { Encode, Decode }

@Document(description: "Classifies text input that is invalid for the selected encoding operation.")
public enum TextFailure { InvalidInput }

@Document(description: "Provides the common typed base for standard-library I/O failures.")
public class IOException extends SystemException {
  @Document(description: "Creates an I/O failure with a stable code and readable explanation.")
  IOException(
    @Document(description: "The stable machine-readable failure code.") String code,
    @Document(description: "The human-readable failure explanation.") String message
  ) {
    super(code: code, message: message)
  }
}

@Document(description: "Reports invalid text or bytes for a selected encoding operation.")
public class TextException extends IOException {
  @Document(description: "The text conversion operation that failed.")
  TextOperation operation

  @Document(description: "The text conversion failure category.")
  TextFailure reason

  @Document(description: "Creates a typed text conversion failure.")
  TextException(
    @Document(description: "The stable machine-readable failure code.") String code,
    @Document(description: "The human-readable failure explanation.") String message,
    @Document(description: "The text conversion operation that failed.") TextOperation operation,
    @Document(description: "The text conversion failure category.") TextFailure reason
  ) {
    super(code: code, message: message)
    this.operation = operation
    this.reason = reason
  }
}

@Document(description: "Encodes valid Unicode text using the selected byte encoding.")
public Bytes encodeText(
  @Document(description: "The Unicode text to encode.") String text,
  @Document(description: "The byte encoding to apply.") TextEncoding encoding
) {
  Bytes? encoded = switch encoding {
    case Utf8 { break __textEncodeUtf8<BytesValue>(text: text) }
  }
  if encoded == null {
    throw TextException(
      code: "NORM-IO-INVALID-TEXT",
      message: "text is not valid Unicode",
      operation: TextOperation.Encode,
      reason: TextFailure.InvalidInput
    )
  }
  return encoded
}

@Document(description: "Decodes bytes into valid Unicode text using the selected encoding.")
public String decodeText(
  @Document(description: "The encoded bytes to decode.") Bytes content,
  @Document(description: "The byte encoding to apply.") TextEncoding encoding
) {
  String? decoded = switch encoding {
    case Utf8 { break __textDecodeUtf8(content: content) }
  }
  if decoded == null {
    throw TextException(
      code: "NORM-IO-INVALID-TEXT",
      message: "input is not valid for the selected text encoding",
      operation: TextOperation.Decode,
      reason: TextFailure.InvalidInput
    )
  }
  return decoded
}
