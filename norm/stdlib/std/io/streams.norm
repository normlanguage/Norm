package std.io

import std.annotation.Document

@Document(description: "Represents either a non-empty chunk of bytes or the end of a readable stream.")
public enum ReadChunk { Data(Bytes bytes), Eof }

@Document(description: "Identifies complete-stream read and write operations.")
public enum StreamOperation { ReadAll, WriteAll }

@Document(description: "Classifies stream limit, stalled progress, and invalid progress failures.")
public enum StreamFailure { LimitExceeded, NoProgress, InvalidProgress }

@Document(description: "Reports a complete-stream operation that violated its progress or size contract.")
public class StreamException extends IOException {
  @Document(description: "The complete-stream operation that failed.")
  StreamOperation operation

  @Document(description: "The stream failure category.")
  StreamFailure reason

  @Document(description: "Creates a typed complete-stream failure.")
  StreamException(
    @Document(description: "The stable machine-readable failure code.") String code,
    @Document(description: "The human-readable failure explanation.") String message,
    @Document(description: "The complete-stream operation that failed.") StreamOperation operation,
    @Document(description: "The stream failure category.") StreamFailure reason
  ) {
    super(code: code, message: message)
    this.operation = operation
    this.reason = reason
  }
}

@Document(description: "Reads bounded byte chunks from a resource.")
public interface ByteReader {
  @Document(description: "Reads at most the requested number of bytes or reports end of stream.")
  ReadChunk read(
    @Document(description: "The maximum number of bytes requested from this read.") Integer maximumBytes
  )
}

@Document(description: "Writes bytes and reports how many values were accepted.")
public interface ByteWriter {
  @Document(description: "Writes a prefix of the supplied bytes and returns the accepted byte count.")
  Integer write(
    @Document(description: "The bytes offered to the writer.") Bytes content
  )
}

@Document(description: "Flushes buffered output to its next destination.")
public interface Flushable {
  @Document(description: "Flushes all currently buffered output.")
  Void flush()
}

@Document(description: "Owns an external resource that requires deterministic closure.")
public interface Resource {
  @Document(description: "Closes the resource and releases its external ownership.")
  Void close()
}

@Document(description: "Adapts a hosted byte input stream to Norm byte I/O and resource ownership.")
public class InputStream implements ByteReader, Resource {
  @Document(description: "Reads at most the requested number of bytes or reports end of stream.")
  public ReadChunk read(
    @Document(description: "The maximum number of bytes requested from this read.") Integer maximumBytes
  ) {
    Bytes? content = __jarInputStreamRead<Bytes>(stream: this, maximumBytes: maximumBytes)
    if content == null {
      return ReadChunk.Eof
    }
    return ReadChunk.Data(bytes: content)
  }

  @Document(description: "Closes the input stream and releases its external ownership.")
  public Void close() {
    __jarStreamClose(stream: this)
  }
}

@Document(description: "Adapts a hosted byte output stream to Norm byte I/O and resource ownership.")
public class OutputStream implements ByteWriter, Flushable, Resource {
  @Document(description: "Writes the supplied bytes and returns the accepted byte count.")
  public Integer write(
    @Document(description: "The bytes offered to the output stream.") Bytes content
  ) {
    return __jarOutputStreamWrite(stream: this, content: content)
  }

  @Document(description: "Flushes buffered bytes to the next destination.")
  public Void flush() {
    __jarOutputStreamFlush(stream: this)
  }

  @Document(description: "Closes the output stream and releases its external ownership.")
  public Void close() {
    __jarStreamClose(stream: this)
  }
}

@Document(description: "Reads a complete byte stream without exceeding an explicit size limit.")
public Bytes readAll(
  @Document(description: "The reader supplying byte chunks.") ByteReader reader,
  @Document(description: "The maximum total number of bytes allowed in the result.") Integer maximumBytes
) {
  require(condition: maximumBytes >= 0, message: "maximumBytes must not be negative")
  List<Bytes> chunks = List<>()
  Integer size = 0
  Boolean reading = true
  for reading {
    Integer remaining = maximumBytes - size
    Integer request = 65536
    if remaining < request {
      request = remaining + 1
    }
    ReadChunk chunk = reader.read(maximumBytes: request)
    switch chunk {
      case Data(Bytes bytes) {
        if bytes.size() == 0 {
          throw streamFailure(
            operation: StreamOperation.ReadAll,
            reason: StreamFailure.NoProgress,
            message: "reader returned an empty data chunk"
          )
        }
        if bytes.size() > request {
          throw streamFailure(
            operation: StreamOperation.ReadAll,
            reason: StreamFailure.InvalidProgress,
            message: "reader exceeded the requested byte count"
          )
        }
        if bytes.size() > remaining {
          throw streamFailure(
            operation: StreamOperation.ReadAll,
            reason: StreamFailure.LimitExceeded,
            message: "stream exceeds maximumBytes"
          )
        }
        chunks.add(bytes)
        size = size + bytes.size()
      }
      case Eof {
        reading = false
      }
    }
  }
  return __bytesJoin<BytesValue>(values: chunks)
}

@Document(description: "Writes all bytes while enforcing forward progress from the writer.")
public Void writeAll(
  @Document(description: "The writer receiving the bytes.") ByteWriter writer,
  @Document(description: "The complete byte sequence to write.") Bytes content
) {
  Integer written = 0
  for written < content.size() {
    Bytes remaining = content.slice(start: written, length: content.size() - written)
    Integer count = writer.write(content: remaining)
    if count == 0 {
      throw streamFailure(
        operation: StreamOperation.WriteAll,
        reason: StreamFailure.NoProgress,
        message: "writer made no progress"
      )
    }
    if count < 0 || count > remaining.size() {
      throw streamFailure(
        operation: StreamOperation.WriteAll,
        reason: StreamFailure.InvalidProgress,
        message: "writer returned an invalid byte count"
      )
    }
    written = written + count
  }
}

@Document(description: "Runs a body and closes its resource when the body completes or fails.")
public T use<T>(
  @Document(description: "The resource closed after the body exits.") Resource resource,
  @Document(description: "The operation performed while the resource is open.") T body()
) {
  return __use<T>(
    close: () {
      resource.close()
    },
    body: body
  )
}

private StreamException streamFailure(
  StreamOperation operation,
  StreamFailure reason,
  String message
) {
  String code = switch reason {
    case LimitExceeded { break "NORM-IO-LIMIT-EXCEEDED" }
    case NoProgress { break "NORM-IO-NO-PROGRESS" }
    case InvalidProgress { break "NORM-IO-INVALID-PROGRESS" }
  }
  return StreamException(
    code: code,
    message: message,
    operation: operation,
    reason: reason
  )
}
