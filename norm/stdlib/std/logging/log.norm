package std.logging

import java.base.time.instantOfEpochSecond
import std.annotation.Document
import std.application.providers
import std.application.environmentVariable
import std.core.Exception
import std.context.currentContext
import std.context.withContext
import std.io.printError
import std.json.fromJson
import std.time.systemClock

import std.serialization.Serializable

@Serializable
private value Destination {
  String name
  String? level = null
  String? source = null
  Map<String, String>? options = null
}

private class Route {
  String name
  LogOutputer outputer
  Integer minimum
  String? source
  Boolean failed = false
}

private class Delivery {
  LogOutputer outputer
  Delivery? previous
  Boolean contains(LogOutputer target) {
    if outputer == target { return true }
    return previous?.contains(target: target) ?? false
  }
}

@Document(description: "Returns the stable output label for a log level.")
public String logLevelName(@Document(description: "The event severity.") LogLevel level) {
  return switch level {
    case Debug { break "DEBUG" }
    case Info { break "INFO" }
    case Warn { break "WARN" }
    case Error { break "ERROR" }
  }
}

private Integer threshold(String level) {
  return switch level {
    case "debug" { break 0 }
    case "info" { break 1 }
    case "warn" { break 2 }
    case "error" { break 3 }
    case "off" { break 4 }
    case _ { throw Exception(message: "Invalid log level: " + level) }
  }
}

@Document(description: "Writes timestamped application log events to standard error.")
public class ConsoleLogOutputer implements LogOutputer {
  @Document(description: "Initializes console output.")
  public Void open(@Document(description: "Console output options.") Map<String, String> configuration) {}
  @Document(description: "Writes an event to standard error.")
  public Void output(@Document(description: "The event to write.") LogEvent event) {
    var timestamp = instantOfEpochSecond(event.time.epochSecond())!!
    printError(text: timestamp.toString()!! + " [" + logLevelName(level: event.level) + "] " + event.source + " " + event.message + "\n")
  }
  @Document(description: "Completes pending console writes.")
  public Void flush() {}
  @Document(description: "Releases the output without closing the host stream.")
  public Void close() {}
}

private class ApplicationLogs {
  List<Route> routes = List<>()

  Void start() {
    var available = providers<LogOutputer>()
    String? override = if __applicationLogDebug() { "debug" } else { null }
    String base = override ?? environmentVariable(name: "NORM_LOG_LEVEL") ?? "info"
    threshold(level: base)
    var configured = environmentVariable(name: "NORM_LOG_OUTPUTS")
    var window = environmentVariable(name: "NORM_WINDOWED_LOG_DIRECTORY")
    List<Destination> targets = if configured != null { fromJson<List<Destination>>(value: configured) }
      else if window != null {
        Map<String, String> options = Map<>()
        options.put(key: "directory", value: window)
        break [Destination(name: "std.logging.FileLogOutputer", options: options)]
      } else { [Destination(name: "std.logging.ConsoleLogOutputer")] }
    for target : targets {
      Integer minimum = threshold(level: override ?? target.level ?? base)
      Boolean found = false
      for provider : available {
        if provider.name() == target.name {
          for route : routes {
            if route.name == provider.name() { throw Exception(message: "Duplicate log output: " + target.name) }
          }
          var outputer = provider.create()
          routes.add(Route(name: target.name, outputer: outputer, minimum: minimum, source: target.source))
          outputer.open(configuration: target.options ?? Map<String, String>())
          found = true
        }
      }
      if !found { throw Exception(message: "Unknown log output: " + target.name) }
    }
  }

  Void emit(LogLevel level, String source, String message) {
    Integer priority = switch level {
      case Debug { break 0 }
      case Info { break 1 }
      case Warn { break 2 }
      case Error { break 3 }
    }
    var active = currentContext<Delivery>()
    LogEvent? event = null
    for route : routes {
      var prefix = route.source
      if !route.failed && priority >= route.minimum && (prefix == null || source == prefix || source.startsWith(prefix: prefix + ".")) && !(active?.contains(target: route.outputer) ?? false) {
        if event == null { event = LogEvent(time: systemClock().now(), level: level, source: source, message: message) }
        LogEvent selected = event!!
        try {
          withContext<Delivery>(value: Delivery(outputer: route.outputer, previous: active), action: () { route.outputer.output(event: selected) })
        } catch Exception failure {
          route.failed = true
          printError(text: "Log output " + route.name + " failed: " + failure.message + "\n")
        }
      }
    }
  }

  Void close() {
    for route : routes {
      try {
        try { route.outputer.flush() } finally { route.outputer.close() }
      } catch Exception failure {
        printError(text: "Cannot close log output " + route.name + ": " + failure.message + "\n")
      }
    }
  }
}

private Void startApplicationLogs() {
  var logs = ApplicationLogs()
  Function<Void(LogLevel, String, String)> emit = logs.emit
  Function<Void()> close = logs.close
  __bindApplicationLogs(emit: emit, close: close)
  logs.start()
}

@Document(description: "Emits an application debug event.")
public Void logDebug(@Document(description: "The message to record.") String message) {
  Function<Void()> start = startApplicationLogs.function
  __emitApplicationLog(level: LogLevel.Debug, message: message, start: start)
}

@Document(description: "Emits an application info event.")
public Void logInfo(@Document(description: "The message to record.") String message) {
  Function<Void()> start = startApplicationLogs.function
  __emitApplicationLog(level: LogLevel.Info, message: message, start: start)
}

@Document(description: "Emits an application warn event.")
public Void logWarn(@Document(description: "The message to record.") String message) {
  Function<Void()> start = startApplicationLogs.function
  __emitApplicationLog(level: LogLevel.Warn, message: message, start: start)
}

@Document(description: "Emits an application error event.")
public Void logError(@Document(description: "The message to record.") String message) {
  Function<Void()> start = startApplicationLogs.function
  __emitApplicationLog(level: LogLevel.Error, message: message, start: start)
}
