package std.runtime

import std.annotation.Document
import std.core.Exception
import std.io.Resource

@Document(description: "Provides the current source execution's runtime update capability.")
public class Runtime {
  @Document(description: "Reports live source execution state.")
  public RuntimeStatus status() { __runtimeStatus<RuntimeStatus>() }

  @Document(description: "Returns the most recent automatic or requested compilation result, or null before any update completes.")
  public UpdateResult? latestUpdate() {
    var completion = __runtimeLatest<UpdateCompletion<RuntimeDiagnostic, RuntimeChange>>()
    if completion != null { return completeUpdate(completion) }
    return null
  }

  @Document(description: "Starts a publication batch for related source and dependency edits.")
  public UpdateBatch beginUpdate() { __runtimeBegin<UpdateBatch>() }

  @Document(description: "Requests compilation of current sources and waits only for publication, never for running activations to finish adopting it.")
  public UpdateResult publishUpdate() { completeUpdate(__runtimePublish<UpdateCompletion<RuntimeDiagnostic, RuntimeChange>>()) }

  @Document(description: "Compiles current sources and returns all before and after changes without publishing them.")
  public UpdatePreview previewUpdate() { completePreview(__runtimePreview<UpdateCompletion<RuntimeDiagnostic, RuntimeChange>>()) }

  @Document(description: "Subscribes a callback to runtime update transitions.")
  public UpdateSubscription onUpdate(@Document(description: "The callback receiving each runtime update transition.") Void callback(@Document(description: "The event delivered for each runtime update transition.") RuntimeUpdateEvent event)) {
    __runtimeOnUpdate<UpdateSubscription, RuntimeUpdateEvent>(callback: callback)
  }
}

@Document(description: "Distinguishes successful publication, unchanged sources, invalid code and host compilation failure.")
public enum UpdateOutcome { Published, Unchanged, Rejected, Failed }

@Document(description: "Distinguishes a reviewable preview from unchanged sources, invalid code and host compilation failure.")
public enum PreviewOutcome { Previewed, Unchanged, Rejected, Failed }

@Document(description: "Reports a compiler diagnostic without parsing formatted output.")
public value RuntimeDiagnostic {
  @Document(description: "The stable diagnostic code.")
  String code
  @Document(description: "The diagnostic severity.")
  String severity
  @Document(description: "The human-readable diagnostic message.")
  String message
  @Document(description: "The source URI or display name containing the diagnostic.")
  String source
  @Document(description: "The inclusive diagnostic start offset in the source.")
  Integer startOffset
  @Document(description: "The exclusive diagnostic end offset in the source.")
  Integer endOffset
}

@Document(description: "Reports the latest published revision and active locations awaiting adoption.")
public value RuntimeStatus {
  @Document(description: "The most recent revision published by the runtime.")
  Long publishedRevision
  @Document(description: "The revision currently active at the observing location.")
  Long activeRevision
  @Document(description: "Active locations that still need to adopt the published revision.")
  List<String> pendingLocations
}

@Document(description: "Describes one declaration changed by a source publication. Before and after contain the stable semantic shape of the declaration.")
public value RuntimeChange {
  @Document(description: "The change kind, such as added, removed, or modified.")
  String kind
  @Document(description: "The changed declaration category.")
  String declarationKind
  @Document(description: "The stable identity of the changed declaration.")
  String identity
  @Document(description: "The declaration shape before publication, when present.")
  String? before
  @Document(description: "The declaration shape after publication, when present.")
  String? after
  @Document(description: "The source URI or display name containing the declaration.")
  String source
  @Document(description: "The inclusive declaration start offset in the source.")
  Integer startOffset
  @Document(description: "The exclusive declaration end offset in the source.")
  Integer endOffset
}

@Document(description: "Reports publication independently from adoption by existing activations. Pending locations can remain after successful publication.")
public value UpdateResult {
  @Document(description: "The publication outcome.")
  UpdateOutcome outcome
  @Document(description: "The published revision, when one exists.")
  Long revision
  @Document(description: "Active locations that still need to adopt the published revision.")
  List<String> pendingLocations
  @Document(description: "Compiler diagnostics produced while preparing the publication.")
  List<RuntimeDiagnostic> diagnostics
  @Document(description: "Declarations changed by the publication.")
  List<RuntimeChange> changes
  @Document(description: "The host failure message, when publication failed.")
  String? failure
}

@Document(description: "Reports the complete before and after declaration changes without publishing them.")
public value UpdatePreview {
  @Document(description: "The preview outcome.")
  PreviewOutcome outcome
  @Document(description: "The candidate revision represented by this preview.")
  Long revision
  @Document(description: "Active locations that still need to adopt the candidate revision.")
  List<String> pendingLocations
  @Document(description: "Compiler diagnostics produced while preparing the preview.")
  List<RuntimeDiagnostic> diagnostics
  @Document(description: "All declarations changed by the candidate publication.")
  List<RuntimeChange> changes
  @Document(description: "The host failure message, when preview failed.")
  String? failure
}

private value UpdateCompletion<D, C> {
  String outcome
  Long revision
  List<String> pendingLocations
  List<D> diagnostics
  List<C> changes
  String? failure
}

private UpdateResult completeUpdate(UpdateCompletion<RuntimeDiagnostic, RuntimeChange> completion) {
  UpdateOutcome outcome = switch completion.outcome {
    case "PUBLISHED" { break UpdateOutcome.Published }
    case "UNCHANGED" { break UpdateOutcome.Unchanged }
    case "REJECTED" { break UpdateOutcome.Rejected }
    case "FAILED" { break UpdateOutcome.Failed }
    case _ { throw Exception(message: "Unknown runtime publication outcome") }
  }
  return UpdateResult(outcome: outcome, revision: completion.revision,
    pendingLocations: completion.pendingLocations, diagnostics: completion.diagnostics,
    changes: completion.changes, failure: completion.failure)
}

private UpdatePreview completePreview(UpdateCompletion<RuntimeDiagnostic, RuntimeChange> completion) {
  PreviewOutcome outcome = switch completion.outcome {
    case "PREVIEWED" { break PreviewOutcome.Previewed }
    case "UNCHANGED" { break PreviewOutcome.Unchanged }
    case "REJECTED" { break PreviewOutcome.Rejected }
    case "FAILED" { break PreviewOutcome.Failed }
    case _ { throw Exception(message: "Unknown runtime preview outcome") }
  }
  return UpdatePreview(outcome: outcome, revision: completion.revision,
    pendingLocations: completion.pendingLocations, diagnostics: completion.diagnostics,
    changes: completion.changes, failure: completion.failure)
}

@Document(description: "Suppresses automatic publication until commit or close. Closing without commit releases suppression; it does not undo filesystem writes.")
public class UpdateBatch implements Resource {
  @Document(description: "Compiles the complete source tree and returns all before and after changes without publishing them. The preview remains valid until the batch sources change or the batch closes.")
  public UpdatePreview preview() { completePreview(__runtimePreviewBatch<UpdateCompletion<RuntimeDiagnostic, RuntimeChange>>(batch: this)) }

  @Document(description: "Publishes the complete source tree when it changes. Unchanged sources preserve their previous outcome. Waits for compilation, while existing activations may still be pending.")
  public UpdateResult commit() { completeUpdate(__runtimeCommit<UpdateCompletion<RuntimeDiagnostic, RuntimeChange>>(batch: this)) }

  @Document(description: "Releases publication suppression. Closing an already completed batch has no effect.")
  public Void close() { __runtimeClose(batch: this) }
}
