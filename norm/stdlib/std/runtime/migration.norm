@Document(description: "Provides explicit converters for retained runtime state.")
package std.runtime

import std.annotation.Document
import std.annotation.TypeTarget
import std.annotation.RuntimeRetention

@Document(description: "Declares the converter used when this type adopts an incompatible stored-field schema.")
public annotation StateMigration implements TypeTarget, RuntimeRetention {
  @Document(description: "Converts one retained instance synchronously through its migration state. Failed conversion preserves its previous Norm state; external I/O is not rolled back. Same-thread host reentry is allowed, while cross-thread guest callbacks are rejected during conversion.")
  Function<Void(MigrationState)> convert
}

@Document(description: "Provides the previous instance schema and staged target fields during a converter invocation. Operations are invalid after that invocation returns.")
public class MigrationState {
  @Document(description: "Reports whether the previous schema declares this field. Ambiguous inherited names fail.")
  public Boolean contains(String field) { __stateMigrationContains(state: this, field: field) }
  @Document(description: "Reads a previous field snapshot after validating that its declared type is assignable to T.")
  public T read<T>(String field) { __stateMigrationRead<T>(state: this, field: field) }
  @Document(description: "Stages a value using a target field descriptor whose declared type matches T.")
  public Void write<T>(Field<?, T> field, T value) { __stateMigrationWrite<T>(state: this, field: field, value: value) }
  @Document(description: "Copies a previous field to a target field after validating their instance-specific declared types. Consuming a renamed source field requires remove.")
  public Void transfer(String source, String target) { __stateMigrationCopy(state: this, source: source, target: target) }
  @Document(description: "Explicitly consumes a previous field removed from the target schema. Retained compatible fields cannot be removed.")
  public Void remove(String field) { __stateMigrationRemove(state: this, field: field) }
}
