@Document(description: "Provides normalized durations, instants, clocks, and typed time failures.")
package std.time

import std.annotation.Document
import std.system.SystemException

@Document(description: "Identifies clock access and temporal value construction operations.")
public enum TimeOperation { Now, CreateDuration, CreateInstant }

@Document(description: "Classifies unavailable clocks and invalid duration or instant components.")
public enum TimeFailure { ClockUnavailable, InvalidDuration, InvalidInstant }

@Document(description: "Reports a typed clock or temporal value construction failure.")
public class TimeException extends SystemException {
  @Document(description: "The time operation that failed.")
  TimeOperation operation

  @Document(description: "The time failure category.")
  TimeFailure reason

  @Document(description: "Creates a typed time failure.")
  TimeException(
    @Document(description: "The stable machine-readable failure code.") String code,
    @Document(description: "The human-readable failure explanation.") String message,
    @Document(description: "The time operation that failed.") TimeOperation operation,
    @Document(description: "The time failure category.") TimeFailure reason
  ) {
    super(code: code, message: message)
    this.operation = operation
    this.reason = reason
  }
}

@Document(description: "Represents a normalized signed duration using seconds and a non-negative nanosecond fraction.")
public interface Duration {
  @Document(description: "Returns the whole signed seconds component.")
  Long seconds()

  @Document(description: "Returns the nanosecond fraction in the range 0 through 999999999.")
  Integer nanoseconds()
}

private value DurationValue implements Duration {
  private Long secondsValue
  private Integer nanosecondsValue

  public Long seconds() {
    return secondsValue
  }

  public Integer nanoseconds() {
    return nanosecondsValue
  }
}

@Document(description: "Represents an instant on the Unix time line using an epoch second and nanosecond fraction.")
public interface Instant {
  @Document(description: "Returns the whole seconds since the Unix epoch.")
  Long epochSecond()

  @Document(description: "Returns the nanosecond fraction in the range 0 through 999999999.")
  Integer nanosecond()
}

private value InstantValue implements Instant {
  private Long epochSecondValue
  private Integer nanosecondValue

  public Long epochSecond() {
    return epochSecondValue
  }

  public Integer nanosecond() {
    return nanosecondValue
  }
}

@Document(description: "Creates a normalized duration from a seconds component and nanosecond fraction.")
public Duration duration(
  @Document(description: "The whole signed seconds component.") Long seconds,
  @Document(description: "The nanosecond fraction from 0 through 999999999.") Integer nanoseconds
) {
  if nanoseconds < 0 || nanoseconds > 999999999 {
    throw TimeException(
      code: "NORM-TIME-INVALID-DURATION",
      message: "duration nanoseconds must be within 0..999999999",
      operation: TimeOperation.CreateDuration,
      reason: TimeFailure.InvalidDuration
    )
  }
  return DurationValue(secondsValue: seconds, nanosecondsValue: nanoseconds)
}

@Document(description: "Creates an instant from a Unix epoch second and nanosecond fraction.")
public Instant instant(
  @Document(description: "The whole seconds since the Unix epoch.") Long epochSecond,
  @Document(description: "The nanosecond fraction from 0 through 999999999.") Integer nanosecond
) {
  if nanosecond < 0 || nanosecond > 999999999 {
    throw TimeException(
      code: "NORM-TIME-INVALID-INSTANT",
      message: "instant nanosecond must be within 0..999999999",
      operation: TimeOperation.CreateInstant,
      reason: TimeFailure.InvalidInstant
    )
  }
  return InstantValue(epochSecondValue: epochSecond, nanosecondValue: nanosecond)
}

@Document(description: "Supplies the current instant from a time source.")
public interface Clock {
  @Document(description: "Returns the current instant from this clock.")
  Instant now()
}

private value SystemClock implements Clock {
  public Instant now() {
    return __clockNow<InstantValue>(clock: this)
  }
}

@Document(description: "Returns a clock backed by the host system time source.")
public Clock systemClock() {
  return __systemClock<SystemClock>()
}
