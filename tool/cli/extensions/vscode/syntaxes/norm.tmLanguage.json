{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Norm",
  "scopeName": "source.norm",
  "patterns": [
    { "include": "#strings" },
    { "include": "#codePoints" },
    { "include": "#numbers" },
    { "include": "#modifiers" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#generics" },
    { "include": "#typeParameters" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.norm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.norm", "match": "\\\\[nrt\"\\\\]" }
      ]
    },
    "codePoints": {
      "name": "constant.character.norm",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.norm", "match": "\\\\[nrt'\\\\]" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.norm",
      "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(annotation|class|enum|interface|value)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.norm" },
            "2": { "name": "entity.name.type.norm" }
          }
        }
      ]
    },
    "types": {
      "name": "entity.name.type.norm",
      "match": "\\b[A-Z][A-Za-z0-9_]+\\b"
    },
    "typeParameters": {
      "name": "entity.name.type.parameter.norm",
      "match": "\\b[A-Z]\\b"
    },
    "generics": {
      "patterns": [
        {
          "begin": "(?<=[A-Za-z0-9_>])<(?=\\s*(?:>|[A-Z_]))",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.norm" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.norm" }
          },
          "patterns": [
            { "include": "#generics" },
            { "include": "#types" },
            {
              "name": "entity.name.type.parameter.norm",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "name": "punctuation.separator.comma.norm", "match": "," }
          ]
        }
      ]
    },
    "modifiers": {
      "name": "storage.modifier.norm",
      "match": "\\b(?:public|private|extension)\\b"
    },
    "annotations": {
      "name": "meta.annotation.norm",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "name": "keyword.control.norm",
      "match": "\\b(?:package|import|as|class|enum|interface|implements|extends|if|else|switch|case|for|try|catch|finally|throw|return|break|continue|super|ref|var)\\b"
    },
    "constants": {
      "name": "constant.language.norm",
      "match": "\\b(?:true|false|null)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.norm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*<[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*>\\s*\\()"
        },
        {
          "name": "entity.name.function.norm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.norm",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.norm",
      "match": "::|\\?\\.|\\?\\?|==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!?&]"
    }
  }
}
