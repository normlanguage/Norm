{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Norm",
  "scopeName": "source.norm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#codePoints" },
    { "include": "#numbers" },
    { "include": "#modifiers" },
    { "include": "#declarations" },
    { "include": "#generics" },
    { "include": "#typeParameters" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.norm", "begin": "//", "end": "$" },
        { "name": "comment.block.norm", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] }
      ]
    },
    "strings": {
      "name": "string.quoted.double.norm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.norm", "match": "\\\\[nrt\"\\\\]" }
      ]
    },
    "codePoints": {
      "name": "constant.character.norm",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.norm", "match": "\\\\[nrt'\\\\]" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.norm",
      "match": "\\b[0-9](?:_?[0-9])*\\b"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.norm" },
            "2": { "name": "entity.name.type.norm" }
          }
        }
      ]
    },
    "types": {
      "name": "support.type.norm",
      "match": "\\b(?:Integer|Boolean|String|Void|CodePoint|Array|List|Map|Set|Stack|Queue|Deque|Pair|Range|StringBuilder|Module)\\b"
    },
    "typeParameters": {
      "name": "entity.name.type.parameter.norm",
      "match": "\\b[A-Z]\\b"
    },
    "generics": {
      "patterns": [
        {
          "begin": "(?<=[A-Za-z0-9_>])<(?=\\s*(?:[A-Z_]|Integer\\b|Boolean\\b|String\\b|Void\\b|CodePoint\\b|Array\\b|List\\b|Map\\b|Set\\b|Stack\\b|Queue\\b|Deque\\b|Pair\\b))",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.norm" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.norm" }
          },
          "patterns": [
            { "include": "#generics" },
            { "include": "#types" },
            {
              "name": "entity.name.type.parameter.norm",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "name": "punctuation.separator.comma.norm", "match": "," }
          ]
        }
      ]
    },
    "modifiers": {
      "name": "storage.modifier.norm",
      "match": "\\b(?:public|private)\\b"
    },
    "keywords": {
      "name": "keyword.control.norm",
      "match": "\\b(?:package|import|as|class|enum|if|else|for|return|break|continue)\\b"
    },
    "constants": {
      "name": "constant.language.norm",
      "match": "\\b(?:true|false|null)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.norm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*<[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*>\\s*\\()"
        },
        {
          "name": "entity.name.function.norm",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.norm",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.norm",
      "match": "\\?\\.|\\?\\?|==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!?]"
    }
  }
}
