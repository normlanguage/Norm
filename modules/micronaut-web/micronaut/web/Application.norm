package micronaut.web

import micronaut.inject.context.applicationContextRun
import micronaut.inject.javaStringArrayNew
import micronaut.runtime.runtime.server.EmbeddedServer
import std.application.Application
import std.collections.MutableMap
import std.concurrent.awaitCancellation
import std.configuration.ConfigurationKey
import std.configuration.configurationProperties
import std.core.Exception
import std.serialization.SerialName
import std.serialization.Serializable

@Serializable()
public value Server {
  String host = "127.0.0.1"
  Integer port = 8080
}

@Serializable()
public value StaticResource {
  @ConfigurationKey()
  String name
  String mapping = "/**"
  List<String> paths = ["classpath:public"]
}

@Serializable()
public value Router {
  List<StaticResource> staticResources = []
}

public enum SecurityAccess { Anonymous, Authenticated }

@Serializable()
public value SecurityRule {
  String pattern
  private List<String> access
}

public SecurityRule securityRule(String pattern, SecurityAccess access) {
  String expression = switch access {
    case Anonymous { break "isAnonymous()" }
    case Authenticated { break "isAuthenticated()" }
  }
  return SecurityRule(pattern: pattern, access: [expression])
}

@Serializable()
public value Security {
  Boolean enabled = false
  @SerialName(name: "intercept-url-map")
  List<SecurityRule> rules = []
}

@Serializable()
public value Micronaut {
  Server server = Server()
  Router router = Router()
  Security security = Security()
}

@Serializable()
public value DataSource {
  private String url
  @SerialName(name: "driver-class-name")
  private String driver
  private String dialect
  private String username
  private String password
}

public enum H2Storage { File, Memory }

public DataSource h2DataSource(
  String database,
  H2Storage storage = H2Storage.File,
  String username = "sa",
  String password = ""
) {
  String url = switch storage {
    case File { break "jdbc:h2:file:" + database }
    case Memory { break "jdbc:h2:mem:" + database + ";DB_CLOSE_DELAY=-1" }
  }
  return DataSource(
    url: url,
    driver: "org.h2.Driver",
    dialect: "H2",
    username: username,
    password: password
  )
}

@Serializable()
public value DataSources {
  @SerialName(name: "default")
  DataSource defaultSource
}

public enum SchemaMode { CreateDrop, Create, Update, Validate, None }

@Serializable()
public value EntityScan {
  List<String> packages
}

@Serializable()
public value HibernateDdl {
  SchemaMode auto = SchemaMode.Validate
}

@Serializable()
public value Hibernate {
  HibernateDdl hbm2ddl = HibernateDdl()
}

@Serializable()
public value JpaProperties {
  Hibernate hibernate = Hibernate()
}

@Serializable()
public value JpaContext {
  EntityScan entityScan
  JpaProperties properties = JpaProperties()
}

@Serializable()
public value Jpa {
  @SerialName(name: "default")
  JpaContext defaultContext
}

public Jpa hibernateJpa(
  List<String> entityPackages,
  SchemaMode schema = SchemaMode.Validate
) {
  return Jpa(defaultContext: JpaContext(
    entityScan: EntityScan(packages: entityPackages),
    properties: JpaProperties(hibernate: Hibernate(
      hbm2ddl: HibernateDdl(auto: schema)
    ))
  ))
}

public enum HealthDetails { Never, Anonymous, Authenticated }

@Serializable()
public value Health {
  Boolean enabled = false
  Boolean sensitive = true
  HealthDetails detailsVisible = HealthDetails.Never
}

@Serializable()
public value Endpoints {
  Health health = Health()
}

@Serializable()
public value MicronautConfig {
  Micronaut micronaut = Micronaut()
  DataSources? datasources = null
  Jpa? jpa = null
  Endpoints endpoints = Endpoints()
}

public class RunningMicronautApplication {
  private EmbeddedServer server

  public String uri() {
    return server.getURI()?.value ?? ""
  }

  public Void close() {
    server.close()
  }
}

public class MicronautApplication implements Application {
  MicronautConfig config

  public RunningMicronautApplication start() {
    MutableMap<String?, Any?> properties = configurationProperties(value: config)
    EmbeddedServer? server = applicationContextRun<EmbeddedServer>(
      arg0: EmbeddedServer.class,
      arg1: properties,
      arg2: javaStringArrayNew(size: 0)
    )
    if server == null {
      throw Exception(message: "Micronaut did not create an embedded server")
    }
    return RunningMicronautApplication(server: server)
  }

  public Void run() {
    RunningMicronautApplication running = this.start()
    printLine("Micronaut: " + running.uri())
    try {
      awaitCancellation()
    } finally {
      running.close()
    }
  }
}
