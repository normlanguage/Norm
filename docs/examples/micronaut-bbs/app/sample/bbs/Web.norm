package sample.bbs

import jakarta.inject.Inject
import jakarta.validation.Valid
import jakarta.validation.constraints.NotBlank
import micronaut.core.annotation.Introspected
import micronaut.core.annotation.IntrospectedAccessKind
import micronaut.core.annotation.Nullable
import micronaut.http.HttpRequest
import micronaut.http.HttpResponse
import micronaut.http.annotation.Body
import micronaut.http.annotation.Controller
import micronaut.http.annotation.Get
import micronaut.http.annotation.Post
import micronaut.http.annotation.QueryValue
import micronaut.http.annotation.RequestFilter
import micronaut.http.annotation.ServerFilter
import micronaut.http.httpResponseUnauthorized
import micronaut.security.annotation.Secured
import micronaut.serde.api.annotation.Serdeable
import micronaut.validation.Validated
import sample.bbs.service.AccountService
import sample.bbs.service.ForumService
import std.collections.MutableList

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class CreateBoardRequest {
  @NotBlank() String name
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class CreateTopicRequest {
  Long boardId
  @NotBlank() String title
  @NotBlank() String content
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class CreateReplyRequest {
  Long topicId
  @NotBlank() String content
}

@ServerFilter(value: ["/bbs/session/**"])
class BbsSessionFilter {
  AccountService accounts

  @Inject()
  BbsSessionFilter(AccountService accounts) {
    this.accounts = accounts
  }

  @RequestFilter()
  @Nullable()
  HttpResponse<Any?>? filter(HttpRequest<Any?> request) {
    String? token = request.getHeaders()?.findFirst("X-Session")
    if token != null && !accounts.usernameForToken(token).isEmpty() {
      return null
    }
    return httpResponseUnauthorized<Any>()
  }
}

@Validated()
@Secured(value: ["isAnonymous()"])
@Controller(value: "/bbs")
class BbsController {
  AccountService accountService
  ForumService forumService

  @Inject()
  BbsController(AccountService accountService, ForumService forumService) {
    this.accountService = accountService
    this.forumService = forumService
  }

  @Post(value: "/users")
  Registration register(@Body() @Valid() Credentials credentials) {
    return accountService.register(credentials)
  }

  @Post(value: "/sessions")
  String login(@Body() @Valid() Credentials credentials) {
    return accountService.login(credentials)
  }

  @Get(value: "/boards")
  MutableList<BoardEntity?>? boards() {
    return forumService.allBoards()
  }

  @Post(value: "/session/boards")
  BoardEntity createBoard(@Body() @Valid() CreateBoardRequest request) {
    return forumService.createBoard(request.name)
  }

  @Post(value: "/session/topics")
  TopicEntity createTopic(
    HttpRequest<Any?> httpRequest,
    @Body() @Valid() CreateTopicRequest request
  ) {
    return forumService.createTopic(
      boardId: request.boardId,
      author: this.sessionUsername(httpRequest),
      title: request.title,
      content: request.content
    )
  }

  @Post(value: "/session/replies")
  ReplyEntity createReply(
    HttpRequest<Any?> httpRequest,
    @Body() @Valid() CreateReplyRequest request
  ) {
    return forumService.createReply(
      topicId: request.topicId,
      author: this.sessionUsername(httpRequest),
      content: request.content
    )
  }

  @Get(value: "/topics")
  TopicPage topics(
    @QueryValue(value: "page") Integer page,
    @QueryValue(value: "size") Integer size
  ) {
    return forumService.topicPage(page, size)
  }

  @Get(value: "/topics/{id}")
  TopicEntity? topic(Long id) {
    return forumService.topic(id)
  }

  @Get(value: "/topics/{id}/replies")
  MutableList<ReplyEntity?>? replies(Long id) {
    return forumService.repliesForTopic(id)
  }

  @Get(value: "/session/profile")
  String sessionProfile(HttpRequest<Any?> request) {
    return this.sessionUsername(request)
  }

  private String sessionUsername(HttpRequest<Any?> request) {
    String? token = request.getHeaders()?.findFirst("X-Session")
    return accountService.usernameForToken(token ?? "")
  }
}
