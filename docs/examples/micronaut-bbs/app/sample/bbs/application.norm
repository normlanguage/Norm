package sample.bbs

import micronaut.web.DataSources
import micronaut.web.Endpoints
import micronaut.web.Health
import micronaut.web.HealthDetails
import micronaut.web.h2DataSource
import micronaut.web.hibernateJpa
import micronaut.web.Micronaut
import micronaut.web.MicronautApplication
import micronaut.web.MicronautConfig
import micronaut.web.Router
import micronaut.web.SchemaMode
import micronaut.web.Security
import micronaut.web.SecurityAccess
import micronaut.web.securityRule
import micronaut.web.StaticResource
import std.application.Application

public Application application() {
  return MicronautApplication(config: MicronautConfig(
    micronaut: Micronaut(
      router: Router(staticResources: [
        StaticResource(name: "bbs")
      ]),
      security: Security(enabled: true, rules: [
        securityRule(pattern: "/", access: SecurityAccess.Anonymous),
        securityRule(pattern: "/styles.css", access: SecurityAccess.Anonymous),
        securityRule(pattern: "/app.js", access: SecurityAccess.Anonymous)
      ])
    ),
    datasources: DataSources(
      defaultSource: h2DataSource(database: "./.tmp/micronaut-bbs/bbs")
    ),
    jpa: hibernateJpa(
      entityPackages: ["sample.bbs"],
      schema: SchemaMode.Update
    ),
    endpoints: Endpoints(
      health: Health(
        enabled: true,
        sensitive: false,
        detailsVisible: HealthDetails.Anonymous
      )
    )
  ))
}
