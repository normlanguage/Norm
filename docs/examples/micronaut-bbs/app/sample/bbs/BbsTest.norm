package sample.bbs

import jakarta.inject.Inject
import junit.jupiter.api.Test
import junit.jupiter.api.assertionsAssertFalse
import junit.jupiter.api.assertionsAssertNotNull
import junit.jupiter.api.assertionsAssertTrue
import micronaut.test.junit5.extensions.junit5.annotation.MicronautTest

@MicronautTest(startApplication: false, transactional: false)
class BbsTest {
  @Inject() CredentialPolicy? credentials

  @Test()
  Void acceptsMatchingCredentials() {
    CredentialPolicy? policy = credentials
    assertionsAssertNotNull(arg0: policy)
    if policy != null {
      UserEntity user = UserEntity(id: null, username: "norm", password: "password")
      assertionsAssertTrue(
        arg0: policy.accepts(user: user, username: "norm", password: "password")
      )
    }
  }

  @Test()
  Void rejectsWrongCredentials() {
    CredentialPolicy? policy = credentials
    assertionsAssertNotNull(arg0: policy)
    if policy != null {
      UserEntity user = UserEntity(id: null, username: "norm", password: "password")
      assertionsAssertFalse(
        arg0: policy.accepts(user: user, username: "norm", password: "wrong")
      )
    }
  }
}
