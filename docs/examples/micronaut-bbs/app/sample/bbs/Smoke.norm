package sample.bbs

import micronaut.http.client.httpClientCreate
import okhttp.client.mediaTypeGet
import okhttp.client.okHttpClientNew
import okhttp.client.requestBuilderNew
import okhttp.client.requestBodyCreate

public Void runBbsSmoke() {
  var server = startBbsServer()
  if server != null {
    String root = (server.getURI()?.value ?? "") + "/bbs"
    var micronautClient = httpClientCreate(arg0: server.getURI())
    var blockingClient = micronautClient?.toBlocking()
    printLine(blockingClient?.retrieve("/bbs/hello/Norm") ?? "")
    printLine(blockingClient?.retrieve("/bbs/audit") ?? "")
    String health = blockingClient?.retrieve("/health") ?? ""
    printLine(health.contains("\"status\":\"UP\""))
    var client = okHttpClientNew()
    var failureRequest = requestBuilderNew().url(root + "/failure")?.get()?.build()
    var failureResponse = client.newCall(failureRequest)?.execute()
    printLine(failureResponse?.code() ?? 0)
    printLine(failureResponse?.body()?.string() ?? "")
    failureResponse?.close()
    var dtoRequest = requestBuilderNew().url(root + "/dto")?.get()?.build()
    var dtoResponse = client.newCall(dtoRequest)?.execute()
    printLine(dtoResponse?.body()?.string() ?? "")
    dtoResponse?.close()
    var mediaType = mediaTypeGet(arg0: "application/json")
    var body = requestBodyCreate(arg0: "{\"message\":\"Request DTO\"}", arg1: mediaType)
    var postRequest = requestBuilderNew().url(root + "/dto")?.post(body)?.build()
    var postResponse = client.newCall(postRequest)?.execute()
    printLine(postResponse?.body()?.string() ?? "")
    postResponse?.close()
    var invalidBody = requestBodyCreate(arg0: "{\"message\":\" \"}", arg1: mediaType)
    var invalidRequest = requestBuilderNew().url(root + "/dto")?.post(invalidBody)?.build()
    var invalidResponse = client.newCall(invalidRequest)?.execute()
    printLine(invalidResponse?.code() ?? 0)
    invalidResponse?.close()
    var credentialsBody = requestBodyCreate(
      arg0: "{\"username\":\"norm\",\"password\":\"password\"}",
      arg1: mediaType
    )
    var registerRequest = requestBuilderNew().url(root + "/users")?.post(credentialsBody)?.build()
    var registerResponse = client.newCall(registerRequest)?.execute()
    printLine(registerResponse?.code() ?? 0)
    printLine(registerResponse?.body()?.string() ?? "")
    registerResponse?.close()
    var loginBody = requestBodyCreate(
      arg0: "{\"username\":\"norm\",\"password\":\"password\"}",
      arg1: mediaType
    )
    var loginRequest = requestBuilderNew().url(root + "/sessions")?.post(loginBody)?.build()
    var loginResponse = client.newCall(loginRequest)?.execute()
    printLine(loginResponse?.body()?.string() ?? "")
    loginResponse?.close()
    var boardBody = requestBodyCreate(arg0: "{\"name\":\"General\"}", arg1: mediaType)
    var boardRequest = requestBuilderNew()
      .url(root + "/session/boards")
      ?.header(arg0: "X-Session", arg1: "session-norm")
      ?.post(boardBody)
      ?.build()
    var boardResponse = client.newCall(boardRequest)?.execute()
    printLine(boardResponse?.code() ?? 0)
    boardResponse?.close()
    var topicBody = requestBodyCreate(
      arg0: "{\"boardId\":1,\"title\":\"Welcome\",\"content\":\"First topic\"}",
      arg1: mediaType
    )
    var topicRequest = requestBuilderNew()
      .url(root + "/session/topics")
      ?.header(arg0: "X-Session", arg1: "session-norm")
      ?.post(topicBody)
      ?.build()
    var topicResponse = client.newCall(topicRequest)?.execute()
    printLine(topicResponse?.code() ?? 0)
    topicResponse?.close()
    var replyBody = requestBodyCreate(
      arg0: "{\"topicId\":1,\"content\":\"First reply\"}",
      arg1: mediaType
    )
    var replyRequest = requestBuilderNew()
      .url(root + "/session/replies")
      ?.header(arg0: "X-Session", arg1: "session-norm")
      ?.post(replyBody)
      ?.build()
    var replyResponse = client.newCall(replyRequest)?.execute()
    printLine(replyResponse?.code() ?? 0)
    replyResponse?.close()
    var topicCountRequest = requestBuilderNew().url(root + "/topics/count")?.get()?.build()
    var topicCountResponse = client.newCall(topicCountRequest)?.execute()
    printLine(topicCountResponse?.body()?.string() ?? "")
    topicCountResponse?.close()
    var topicPageRequest = requestBuilderNew().url(root + "/topics?page=0&size=10")?.get()?.build()
    var topicPageResponse = client.newCall(topicPageRequest)?.execute()
    printLine(topicPageResponse?.code() ?? 0)
    printLine(topicPageResponse?.body()?.string() ?? "")
    topicPageResponse?.close()
    var replyCountRequest = requestBuilderNew().url(root + "/replies/count")?.get()?.build()
    var replyCountResponse = client.newCall(replyCountRequest)?.execute()
    printLine(replyCountResponse?.body()?.string() ?? "")
    replyCountResponse?.close()
    var eventRequest = requestBuilderNew()
      .url(root + "/events")
      ?.header(arg0: "Accept", arg1: "text/event-stream")
      ?.get()
      ?.build()
    var eventResponse = client.newCall(eventRequest)?.execute()
    printLine(eventResponse?.code() ?? 0)
    printLine((eventResponse?.body()?.string() ?? "").trim())
    eventResponse?.close()
    var anonymousSecureRequest = requestBuilderNew().url(root + "/secure")?.get()?.build()
    var anonymousSecureResponse = client.newCall(anonymousSecureRequest)?.execute()
    printLine(anonymousSecureResponse?.code() ?? 0)
    anonymousSecureResponse?.close()
    var secureRequest = requestBuilderNew()
      .url(root + "/secure")
      ?.header(arg0: "Authorization", arg1: "Basic bm9ybTpwYXNzd29yZA==")
      ?.get()
      ?.build()
    var secureResponse = client.newCall(secureRequest)?.execute()
    printLine(secureResponse?.code() ?? 0)
    printLine(secureResponse?.body()?.string() ?? "")
    secureResponse?.close()
    var filteredRequest = requestBuilderNew().url(root + "/filter-blocked")?.get()?.build()
    var filteredResponse = client.newCall(filteredRequest)?.execute()
    printLine(filteredResponse?.code() ?? 0)
    filteredResponse?.close()
    var anonymousSessionRequest = requestBuilderNew().url(root + "/session/profile")?.get()?.build()
    var anonymousSessionResponse = client.newCall(anonymousSessionRequest)?.execute()
    printLine(anonymousSessionResponse?.code() ?? 0)
    anonymousSessionResponse?.close()
    var sessionRequest = requestBuilderNew()
      .url(root + "/session/profile")
      ?.header(arg0: "X-Session", arg1: "session-norm")
      ?.get()
      ?.build()
    var sessionResponse = client.newCall(sessionRequest)?.execute()
    printLine(sessionResponse?.code() ?? 0)
    printLine(sessionResponse?.body()?.string() ?? "")
    sessionResponse?.close()
    micronautClient?.close()
    server.close()
  }
}
