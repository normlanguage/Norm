package sample.bbs.service

import jakarta.inject.Inject
import micronaut.inject.context.annotation.Prototype
import orm.micronaut.tx.Transactional
import sample.bbs.BoardEntity
import sample.bbs.ReplyEntity
import sample.bbs.TopicEntity
import sample.bbs.TopicPage
import sample.bbs.TopicPageable
import sample.bbs.TopicSort
import sample.bbs.repository.BoardRepository
import sample.bbs.repository.ReplyRepository
import sample.bbs.repository.TopicRepository
import std.collections.MutableList

@Prototype()
public class ForumService {
  BoardRepository boards
  TopicRepository topics
  ReplyRepository replies

  @Inject()
  ForumService(BoardRepository boards, TopicRepository topics, ReplyRepository replies) {
    this.boards = boards
    this.topics = topics
    this.replies = replies
  }

  @Transactional()
  public BoardEntity createBoard(String name) {
    return boards.save(BoardEntity(id: null, name: name))
  }

  @Transactional()
  public TopicEntity createTopic(Long boardId, String author, String title, String content) {
    return topics.save(TopicEntity(
      id: null,
      boardId: boardId,
      author: author,
      title: title,
      content: content
    ))
  }

  @Transactional()
  public ReplyEntity createReply(Long topicId, String author, String content) {
    return replies.save(ReplyEntity(
      id: null,
      topicId: topicId,
      author: author,
      content: content
    ))
  }

  @Transactional()
  public MutableList<BoardEntity?>? allBoards() {
    return boards.findAll()
  }

  @Transactional()
  public TopicEntity? topic(Long id) {
    return topics.find(id)
  }

  @Transactional()
  public MutableList<ReplyEntity?>? repliesForTopic(Long topicId) {
    return replies.findByTopic(topicId)
  }

  @Transactional()
  public TopicPage topicPage(Integer page, Integer size) {
    return TopicPage(
      content: topics.page(offset: page * size, limit: size),
      pageable: TopicPageable(size: size, number: page, sort: TopicSort(), mode: "OFFSET"),
      totalSize: topics.count()
    )
  }
}
