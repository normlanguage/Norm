package sample.bbs.service

import jakarta.inject.Inject
import micronaut.inject.context.annotation.Prototype
import orm.micronaut.tx.Transactional
import sample.bbs.Credentials
import sample.bbs.Registration
import sample.bbs.SessionEntity
import sample.bbs.UserEntity
import sample.bbs.repository.AccountRepository

@Prototype()
class CredentialPolicy {
  Boolean accepts(UserEntity user, String username, String password) {
    if user.username == username {
      return user.password == password
    }
    return false
  }
}

@Prototype()
public class AccountService {
  AccountRepository accounts
  CredentialPolicy credentialPolicy

  @Inject()
  AccountService(AccountRepository accounts, CredentialPolicy credentialPolicy) {
    this.accounts = accounts
    this.credentialPolicy = credentialPolicy
  }

  @Transactional()
  public Registration register(Credentials credentials) {
    UserEntity saved = accounts.saveUser(UserEntity(
      id: null,
      username: credentials.username,
      password: credentials.password
    ))
    return Registration(id: saved.id, username: saved.username)
  }

  @Transactional()
  public String login(Credentials credentials) {
    UserEntity? user = accounts.userByUsername(credentials.username)
    if user != null &&
      credentialPolicy.accepts(
        user: user,
        username: credentials.username,
        password: credentials.password
      ) {
      String token = "session-" + user.username
      accounts.saveSession(SessionEntity(id: null, token: token, username: user.username))
      return token
    }
    return ""
  }

  @Transactional()
  public String usernameForToken(String token) {
    SessionEntity? session = accounts.sessionByToken(token)
    if session != null {
      return session.username
    }
    return ""
  }
}
