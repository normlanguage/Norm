package sample.bbs

import okhttp.client.okHttpClientNew
import okhttp.client.requestBuilderNew

public String runBbsArchiveSmoke(String name) {
  var server = startBbsServer()
  if server != null {
    String root = (server.getURI()?.value ?? "") + "/bbs"
    var client = okHttpClientNew()
    var request = requestBuilderNew().url(root + "/hello/" + name)?.get()?.build()
    var response = client.newCall(request)?.execute()
    String body = response?.body()?.string() ?? ""
    response?.close()
    server.close()
    return body
  }
  return ""
}
