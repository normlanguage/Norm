package sample.bbs

import jakarta.inject.Inject
import jakarta.validation.constraints.NotBlank
import micronaut.core.annotation.Introspected
import micronaut.core.annotation.IntrospectedAccessKind
import micronaut.inject.context.annotation.Prototype
import micronaut.serde.api.annotation.Serdeable
import orm.Column
import orm.Context
import orm.Entity
import orm.Generated
import orm.GenerationStrategy
import orm.Id
import orm.Repository
import orm.Store
import orm.Table
import orm.micronaut.tx.Transactional
import std.collections.MutableList

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class Credentials {
  @NotBlank()
  String username

  @NotBlank()
  String password
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class Registration {
  Long? id

  String username
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "UserEntity")
@Table(name: "bbs_users")
class UserEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false, unique: true)
  @NotBlank()
  String username

  @Column(nullable: false)
  @NotBlank()
  String password

  UserEntity() {
    this.id = null
    this.username = ""
    this.password = ""
  }

  UserEntity(Long? id, String username, String password) {
    this.id = id
    this.username = username
    this.password = password
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "SessionEntity")
@Table(name: "bbs_sessions")
class SessionEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false, unique: true)
  @NotBlank()
  String token

  @Column(nullable: false)
  @NotBlank()
  String username

  SessionEntity() {
    this.id = null
    this.token = ""
    this.username = ""
  }

  SessionEntity(Long? id, String token, String username) {
    this.id = id
    this.token = token
    this.username = username
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "BoardEntity")
@Table(name: "bbs_boards")
class BoardEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  @NotBlank()
  String name

  BoardEntity() {
    this.id = null
    this.name = ""
  }

  BoardEntity(Long? id, String name) {
    this.id = id
    this.name = name
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "TopicEntity")
@Table(name: "bbs_topics")
class TopicEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  Long boardId

  @Column(nullable: false)
  @NotBlank()
  String author

  @Column(nullable: false)
  @NotBlank()
  String title

  @Column(nullable: false)
  @NotBlank()
  String content

  TopicEntity() {
    this.id = null
    this.boardId = 0
    this.author = ""
    this.title = ""
    this.content = ""
  }

  TopicEntity(Long? id, Long boardId, String author, String title, String content) {
    this.id = id
    this.boardId = boardId
    this.author = author
    this.title = title
    this.content = content
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "ReplyEntity")
@Table(name: "bbs_replies")
class ReplyEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  Long topicId

  @Column(nullable: false)
  @NotBlank()
  String author

  @Column(nullable: false)
  @NotBlank()
  String content

  ReplyEntity() {
    this.id = null
    this.topicId = 0
    this.author = ""
    this.content = ""
  }

  ReplyEntity(Long? id, Long topicId, String author, String content) {
    this.id = id
    this.topicId = topicId
    this.author = author
    this.content = content
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class TopicSort {}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class TopicPageable {
  Integer size

  Integer number

  TopicSort sort

  String mode
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class TopicPage {
  MutableList<TopicEntity?>? content

  TopicPageable pageable

  Long totalSize
}

@Prototype()
class CredentialPolicy {
  Boolean accepts(UserEntity user, String username, String password) {
    if user.username == username {
      return user.password == password
    }
    return false
  }
}

@Prototype()
class AccountService {
  CredentialPolicy credentialPolicy

  @Context()
  @Inject()
  Store? store

  @Inject()
  AccountService(CredentialPolicy credentialPolicy) {
    this.credentialPolicy = credentialPolicy
    this.store = null
  }

  @Transactional()
  Registration register(Credentials credentials) {
    UserEntity user = UserEntity(
      id: null,
      username: credentials.username,
      password: credentials.password
    )
    Store? active = store
    if active != null {
      UserEntity saved = Repository<UserEntity, Long>(store: active, entityType: UserEntity.class).save(
        user
      )
      return Registration(id: saved.id, username: saved.username)
    }
    return Registration(id: null, username: user.username)
  }

  @Transactional()
  String login(Credentials credentials) {
    UserEntity? user = this.userForUsername(credentials.username)
    if user != null &&
      credentialPolicy.accepts(
        user: user,
        username: credentials.username,
        password: credentials.password
      ) {
      String token = "session-" + user.username
      Store? active = store
      if active != null {
        Repository<SessionEntity, Long>(store: active, entityType: SessionEntity.class).save(
          SessionEntity(id: null, token: token, username: user.username)
        )
      }
      return token
    }
    return ""
  }

  @Transactional()
  UserEntity? userForUsername(String username) {
    Store? active = store
    if active != null {
      return Repository<UserEntity, Long>(
        store: active,
        entityType: UserEntity.class
      ).findFirstWhere<String>(field: UserEntity.username.field, value: username)
    }
    return null
  }

  @Transactional()
  String usernameForToken(String token) {
    Store? active = store
    if active != null {
      SessionEntity? session = Repository<SessionEntity, Long>(
        store: active,
        entityType: SessionEntity.class
      ).findFirstWhere<String>(field: SessionEntity.token.field, value: token)
      if session != null {
        return session.username
      }
    }
    return ""
  }
}

@Prototype()
class ForumService {
  @Context()
  @Inject()
  Store? store

  ForumService() {
    this.store = null
  }

  @Transactional()
  BoardEntity createBoard(BoardEntity board) {
    Store? active = store
    if active != null {
      return Repository<BoardEntity, Long>(store: active, entityType: BoardEntity.class).save(board)
    }
    return board
  }

  @Transactional()
  TopicEntity createTopic(TopicEntity topic) {
    Store? active = store
    if active != null {
      return Repository<TopicEntity, Long>(store: active, entityType: TopicEntity.class).save(topic)
    }
    return topic
  }

  @Transactional()
  ReplyEntity createReply(ReplyEntity reply) {
    Store? active = store
    if active != null {
      return Repository<ReplyEntity, Long>(store: active, entityType: ReplyEntity.class).save(reply)
    }
    return reply
  }

  @Transactional()
  Long topicCount() {
    Store? active = store
    if active != null {
      return Repository<TopicEntity, Long>(store: active, entityType: TopicEntity.class).count()
    }
    return 0
  }

  @Transactional()
  MutableList<BoardEntity?>? allBoards() {
    Store? active = store
    if active != null {
      return Repository<BoardEntity, Long>(store: active, entityType: BoardEntity.class).findAll()
    }
    return null
  }

  @Transactional()
  TopicEntity? topic(Long id) {
    Store? active = store
    if active != null {
      return Repository<TopicEntity, Long>(store: active, entityType: TopicEntity.class).find(id)
    }
    return null
  }

  @Transactional()
  MutableList<ReplyEntity?>? repliesForTopic(Long topicId) {
    Store? active = store
    if active != null {
      return Repository<ReplyEntity, Long>(store: active, entityType: ReplyEntity.class).findWhereOrdered<
        Long,
        Long?
      >(
        field: ReplyEntity.topicId.field,
        value: topicId,
        order: ReplyEntity.id.field,
        ascending: true
      )
    }
    return null
  }

  @Transactional()
  TopicPage topicPage(Integer page, Integer size) {
    MutableList<TopicEntity?>? content = null
    Long total = 0
    Store? active = store
    if active != null {
      Repository<TopicEntity, Long> topics = Repository<TopicEntity, Long>(
        store: active,
        entityType: TopicEntity.class
      )
      content = topics.page(offset: page * size, limit: size)
      total = topics.count()
    }
    return TopicPage(
      content: content,
      pageable: TopicPageable(size: size, number: page, sort: TopicSort(), mode: "OFFSET"),
      totalSize: total
    )
  }

  @Transactional()
  Long replyCount() {
    Store? active = store
    if active != null {
      return Repository<ReplyEntity, Long>(store: active, entityType: ReplyEntity.class).count()
    }
    return 0
  }
}
