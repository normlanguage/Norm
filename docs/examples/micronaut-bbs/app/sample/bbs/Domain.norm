package sample.bbs

import jakarta.validation.constraints.NotBlank
import micronaut.core.annotation.Introspected
import micronaut.core.annotation.IntrospectedAccessKind
import micronaut.serde.api.annotation.Serdeable
import orm.Column
import orm.Entity
import orm.Generated
import orm.GenerationStrategy
import orm.Id
import orm.Table
import std.collections.MutableList

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
public class Credentials {
  @NotBlank()
  String username

  @NotBlank()
  String password
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
public class Registration {
  Long? id

  String username
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "UserEntity")
@Table(name: "bbs_users")
public class UserEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false, unique: true)
  @NotBlank()
  String username

  @Column(nullable: false)
  @NotBlank()
  String password

  UserEntity() {
    this.id = null
    this.username = ""
    this.password = ""
  }

  UserEntity(Long? id, String username, String password) {
    this.id = id
    this.username = username
    this.password = password
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "SessionEntity")
@Table(name: "bbs_sessions")
public class SessionEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false, unique: true)
  @NotBlank()
  String token

  @Column(nullable: false)
  @NotBlank()
  String username

  SessionEntity() {
    this.id = null
    this.token = ""
    this.username = ""
  }

  SessionEntity(Long? id, String token, String username) {
    this.id = id
    this.token = token
    this.username = username
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "BoardEntity")
@Table(name: "bbs_boards")
public class BoardEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  @NotBlank()
  String name

  BoardEntity() {
    this.id = null
    this.name = ""
  }

  BoardEntity(Long? id, String name) {
    this.id = id
    this.name = name
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "TopicEntity")
@Table(name: "bbs_topics")
public class TopicEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  Long boardId

  @Column(nullable: false)
  @NotBlank()
  String author

  @Column(nullable: false)
  @NotBlank()
  String title

  @Column(nullable: false)
  @NotBlank()
  String content

  TopicEntity() {
    this.id = null
    this.boardId = 0
    this.author = ""
    this.title = ""
    this.content = ""
  }

  TopicEntity(Long? id, Long boardId, String author, String title, String content) {
    this.id = id
    this.boardId = boardId
    this.author = author
    this.title = title
    this.content = content
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
@Entity(name: "ReplyEntity")
@Table(name: "bbs_replies")
public class ReplyEntity {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  Long topicId

  @Column(nullable: false)
  @NotBlank()
  String author

  @Column(nullable: false)
  @NotBlank()
  String content

  ReplyEntity() {
    this.id = null
    this.topicId = 0
    this.author = ""
    this.content = ""
  }

  ReplyEntity(Long? id, Long topicId, String author, String content) {
    this.id = id
    this.topicId = topicId
    this.author = author
    this.content = content
  }
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
public class TopicSort {}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
public class TopicPageable {
  Integer size

  Integer number

  TopicSort sort

  String mode
}

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
public class TopicPage {
  MutableList<TopicEntity?>? content

  TopicPageable pageable

  Long totalSize
}
