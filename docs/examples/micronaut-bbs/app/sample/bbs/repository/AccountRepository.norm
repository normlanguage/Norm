package sample.bbs.repository

import jakarta.inject.Inject
import micronaut.inject.context.annotation.Prototype
import orm.Context
import orm.Repository
import orm.Store
import sample.bbs.SessionEntity
import sample.bbs.UserEntity
import std.core.Exception

@Prototype()
public class AccountRepository {
  @Context()
  @Inject()
  Store? store

  AccountRepository() {
    this.store = null
  }

  public UserEntity saveUser(UserEntity user) {
    return Repository<UserEntity, Long>(
      store: this.activeStore(),
      entityType: UserEntity.class
    ).save(user)
  }

  public UserEntity? userByUsername(String username) {
    return Repository<UserEntity, Long>(
      store: this.activeStore(),
      entityType: UserEntity.class
    ).findFirstWhere<String>(field: UserEntity.username.field, value: username)
  }

  public SessionEntity saveSession(SessionEntity session) {
    return Repository<SessionEntity, Long>(
      store: this.activeStore(),
      entityType: SessionEntity.class
    ).save(session)
  }

  public SessionEntity? sessionByToken(String token) {
    return Repository<SessionEntity, Long>(
      store: this.activeStore(),
      entityType: SessionEntity.class
    ).findFirstWhere<String>(field: SessionEntity.token.field, value: token)
  }

  private Store activeStore() {
    Store? active = store
    if active != null {
      return active
    }
    throw Exception(message: "persistence context is unavailable")
  }
}
