package sample.bbs.repository

import jakarta.inject.Inject
import micronaut.inject.context.annotation.Prototype
import orm.Repository
import orm.RepositoryContext
import sample.bbs.ReplyEntity
import std.collections.MutableList

@Prototype()
public class ReplyRepository extends Repository<ReplyEntity, Long> {
  @Inject()
  ReplyRepository(RepositoryContext context) {
    super(context)
  }

  public MutableList<ReplyEntity?>? findByTopic(Long topicId) {
    return this.findWhereOrdered<Long, Long?>(
      field: ReplyEntity.topicId.field,
      value: topicId,
      order: ReplyEntity.id.field,
      ascending: true
    )
  }
}
