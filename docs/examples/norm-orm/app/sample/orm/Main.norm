package sample.orm

import orm.Column
import orm.Entity
import orm.Fetch
import orm.Generated
import orm.GenerationStrategy
import orm.Id
import orm.JoinColumn
import orm.ManyToOne
import orm.Table
import orm.hibernate.Builder
import orm.hibernate.Provider
import orm.hibernate.Session
import orm.hibernate.Transaction
import orm.hibernate.builderNew

@Entity(name: "Account")
@Table(name: "accounts")
class Account {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false, unique: true)
  String username

  Account() {
    this.id = null
    this.username = ""
  }

  Account(Long? id, String username) {
    this.id = id
    this.username = username
  }
}

@Entity(name: "Post")
@Table(name: "posts")
class Post {
  @Id()
  @Generated(strategy: GenerationStrategy.IDENTITY)
  Long? id

  @Column(nullable: false)
  String title

  @ManyToOne(fetch: Fetch.LAZY, optional: false)
  @JoinColumn(name: "author_id", nullable: false)
  Account author

  Post() {
    this.id = null
    this.title = ""
    this.author = Account(id: null, username: "")
  }

  Post(Long? id, String title, Account author) {
    this.id = id
    this.title = title
    this.author = author
  }
}

Void main() {
  Builder builder = builderNew()
  builder.setProperty(arg0: "hibernate.connection.driver_class", arg1: "org.h2.Driver")
  builder.setProperty(
    arg0: "hibernate.connection.url",
    arg1: "jdbc:h2:mem:norm_orm;DB_CLOSE_DELAY=-1"
  )
  builder.setProperty(arg0: "hibernate.connection.username", arg1: "sa")
  builder.setProperty(arg0: "hibernate.connection.password", arg1: "")
  builder.setProperty(arg0: "hibernate.hbm2ddl.auto", arg1: "create-drop")
  builder.setProperty(arg0: "hibernate.show_sql", arg1: "false")
  builder.addAnnotatedClass(Account.class)
  builder.addAnnotatedClass(Post.class)

  Provider? provider = builder.buildSessionFactory()
  if provider != null {
    Session? writer = provider.openSession()
    if writer != null {
      Transaction? transaction = writer.beginTransaction()
      Account account = Account(id: null, username: "norm")
      writer.persist(account)
      Post post = Post(id: null, title: "first", author: account)
      writer.persist(post)
      if transaction != null {
        transaction.commit()
      }
      writer.close()

      Long? id = account.id
      Long? postId = post.id
      if id != null && postId != null {
        Session? reader = provider.openSession()
        if reader != null {
          Account? stored = reader.find<Account>(arg0: Account.class, arg1: id)
          Post? storedPost = reader.find<Post>(arg0: Post.class, arg1: postId)
          if stored != null && storedPost != null {
            printLine(
              stored.username
                + ":"
                + (stored.id ?? 0).toString()
                + ":"
                + storedPost.author.username
            )
          }
          reader.close()
        }
      }
    }
    provider.close()
  }
}
