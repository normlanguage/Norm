{
  "name": "norm-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "api:types": "node scripts/generate-api-types.mjs",
    "api:generate": "node scripts/generate-norm-api.mjs",
    "api:check": "node scripts/check-norm-api.mjs",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "site:check": "node scripts/check-site-config.mjs",
    "site:dist-check": "node scripts/check-site-config.mjs --dist",
    "site:generate": "node scripts/generate-site-manifest.mjs",
    "docs:dev": "npm run api:types && npm run api:generate && vitepress dev",
    "docs:build": "npm run api:types && npm run api:generate && npm run api:check && npm run site:check && npm run brand:check && vitepress build && npm run site:dist-check",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  }
}
