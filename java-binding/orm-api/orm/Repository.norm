package orm

import std.collections.MutableList

public class Repository<E, I> {
  private Store store
  private Class<E> entityType

  Repository(Store store, Class<E> entityType) {
    this.store = store
    this.entityType = entityType
  }

  public E save(E entity) {
    store.persist(entity)
    return entity
  }

  public E update(E entity) {
    return store.merge<E>(entity) ?? entity
  }

  public E? find(I id) {
    return store.find<E>(arg0: entityType, arg1: id)
  }

  public Void delete(E entity) {
    store.remove(entity)
  }

  public Boolean attached(E entity) {
    return store.contains(entity)
  }

  public Void flush() {
    store.flush()
  }

  public MutableList<E?>? findAll() {
    QueryExecution<E?>? query = store.createQuery<E>(
      arg0: "select entity from " + this.entityName() + " entity",
      arg1: entityType
    )
    return query?.getResultList()
  }

  public MutableList<E?>? findWhere<V>(Field<E, V> field, V value) {
    QueryExecution<E?>? query = store.createQuery<E>(
      arg0: "select entity from "
        + this.entityName()
        + " entity where entity."
        + field.name()
        + " = :value",
      arg1: entityType
    )
    query?.setParameter(arg0: "value", arg1: value)
    return query?.getResultList()
  }

  public MutableList<E?>? page(Integer offset, Integer limit) {
    QueryExecution<E?>? query = store.createQuery<E>(
      arg0: "select entity from " + this.entityName() + " entity",
      arg1: entityType
    )
    query?.setFirstResult(offset)
    query?.setMaxResults(limit)
    return query?.getResultList()
  }

  private String entityName() {
    Entity? mapping = entityType.annotation<Entity>()
    if mapping != null && !mapping.name.isEmpty() {
      return mapping.name
    }
    Array<String> names = entityType.name().split(separator: ".")
    return names[names.size() - 1]
  }
}
