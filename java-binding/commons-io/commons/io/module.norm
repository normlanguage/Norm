Module module() {
  return module(
    name: "commons.io",
    version: 1,
    binding: jarBinding(
      target: mavenJar(
        group: "commons-io",
        artifact: "commons-io",
        version: "2.22.0",
        resolution: sha256("2b9a7b1f726fb86216dbd2c8321eabe0221dbd5b1be81c18e1cb53811b104758")
      ),
      api: [
        jarType(
          name: "FileUtils",
          members: [
            "cleanDirectory", "contentEquals", "copyDirectoryToDirectory", "copyFileToDirectory",
            "copyToDirectory", "createParentDirectories", "delete", "deleteDirectory",
            "deleteQuietly", "directoryContains", "forceDelete", "forceMkdir",
            "forceMkdirParent", "getTempDirectory", "getTempDirectoryPath", "getUserDirectory",
            "getUserDirectoryPath", "isEmptyDirectory", "isSymlink", "moveDirectory",
            "moveDirectoryToDirectory", "moveFileToDirectory", "moveToDirectory",
            "readFileToByteArray", "readFileToString", "readLines", "sizeOf", "sizeOfDirectory",
            "touch", "write", "writeByteArrayToFile", "writeLines", "writeStringToFile"
          ]
        ),
        jarType(
          name: "FilenameUtils",
          members: [
            "concat", "directoryContains", "equals", "equalsNormalized", "equalsOnSystem",
            "getBaseName", "getExtension", "getFullPath", "getName", "getPath", "getPrefix",
            "indexOfExtension", "indexOfLastSeparator", "isExtension", "normalize",
            "removeExtension", "separatorsToSystem", "separatorsToUnix", "separatorsToWindows",
            "wildcardMatch"
          ]
        ),
        jarType(
          name: "IOUtils",
          members: ["toBufferedInputStream", "toInputStream"]
        )
      ]
    )
  )
}
