package sample.aop

import jakarta.inject.Singleton
import micronaut.aop.Around
import micronaut.aop.InterceptorBean
import micronaut.aop.MethodInterceptor
import micronaut.aop.MethodInvocationContext
import micronaut.inject.context.ApplicationContext
import micronaut.inject.context.annotation.Prototype
import micronaut.inject.context.applicationContextRun
import std.annotation.FunctionTarget
import std.annotation.RuntimeRetention
import std.annotation.TypeTarget

@Around()
annotation Audited implements TypeTarget, FunctionTarget, RuntimeRetention {
}

@Singleton()
@InterceptorBean(value: [Audited.class])
class AuditInterceptor implements MethodInterceptor<Any?, String> {
  String intercept(MethodInvocationContext<Any?, String> context) {
    return "AOP:" + (context.proceed() ?? "missing")
  }
}

@Prototype()
class AuditService {
  @Audited()
  String label() {
    return "Norm"
  }
}

Void main() {
  ApplicationContext? context = applicationContextRun()
  if context != null {
    AuditService? service = context.getBean(AuditService.class)
    if service != null {
      printLine(service.label())
    }
    context.close()
  }
}
