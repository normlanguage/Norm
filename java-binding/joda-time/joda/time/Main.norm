package joda.time

Void main() {
  DateTime? instant = dateTimeParse("2024-02-29T23:45:30.000Z")
  if instant != null {
    DateTimeZone? london = dateTimeZoneForID("Europe/London")
    DateTimeFormatter? formatter = dateTimeFormatForPattern("yyyy-MM-dd HH:mm ZZZ")
    if london != null && formatter != null {
      printLine(formatter.print(instant.withZone(london)) ?? "missing")
    }
    Interval? day = intervalNew(
      arg0: instant.getMillis(),
      arg1: instant.plusDays(1)?.getMillis() ?? 0
    )
    printLine(day?.toDurationMillis() ?? 0)
  }

  LocalDate? release = localDateParse("2024-02-29")
  if release != null {
    LocalDate? deadline = release.plusDays(10)
    if deadline != null {
      printLine(deadline.toString() ?? "missing")
      printLine(daysDaysBetween(arg0: release, arg1: deadline)?.getDays() ?? 0)
    }
  }

  printLine(durationStandardMinutes(90)?.getStandardSeconds() ?? 0)
  printLine(periodDays(3)?.plusHours(2)?.getHours() ?? 0)
}
