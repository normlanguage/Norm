Module module() {
  return module(
    name: "micronaut.management",
    version: 1,
    binding: jarBinding(
      target: mavenJar(
        group: "io.micronaut",
        artifact: "micronaut-management",
        version: "5.1.13", resolution: sha256("aaf8018dca89fff58eb574fb26d1500b6009c68ce57732150d6e1b98598cdfb7")
      ),
      api: [
        jarType(
          name: "endpoint.annotation.Endpoint",
          members: ["defaultConfigurationId", "defaultEnabled", "defaultSensitive", "id", "prefix", "value"]
        ),
        jarType(name: "endpoint.annotation.Read", members: ["description", "produces"]),
        jarType(name: "endpoint.annotation.Write", members: ["consumes", "description", "produces"]),
        jarType(name: "endpoint.annotation.Delete", members: ["description", "produces"]),
        jarType(name: "endpoint.annotation.Selector", members: []),
        jarType(name: "endpoint.annotation.Sensitive", members: ["defaultValue", "property", "value"]),
        jarType(name: "endpoint.health.DetailsVisibility", members: []),
        jarType(name: "health.indicator.HealthCheckType", members: [])
      ]
    )
  )
}
