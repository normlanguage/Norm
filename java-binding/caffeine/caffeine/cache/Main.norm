package caffeine.cache

import std.time.Duration
import std.time.duration

Void main() {
  Caffeine<Any?, Any?>? builder = caffeineNewBuilder()
  if builder != null {
    Duration ttl = duration(seconds: 60, nanoseconds: 0)
    Caffeine<Any?, Any?>? bounded = builder.maximumSize(100)
    if bounded != null {
      Caffeine<Any?, Any?>? configured = bounded.expireAfterWrite(ttl)
      if configured != null {
        Caffeine<Any?, Any?>? measured = configured.recordStats()
        if measured != null {
          Cache<String?, String?>? cache = measured.build<String, String>()
          if cache != null {
            cache.put(arg0: "language", arg1: "Norm")
            printLine(cache.getIfPresent("language") ?? "missing")
            Function<String?(String?)> loader = (key) { return (key ?? "") + "-loaded" }
            printLine(cache.get(arg0: "binding", arg1: loader) ?? "missing")
            printLine(cache.stats()?.loadSuccessCount() ?? 0)
          }
        }
      }
    }
  }
}
