        jarType(name: "api.Tag", members: ["value"]),
        jarType(name: "api.Nested", members: []),
        jarType(name: "api.RepeatedTest", members: ["failureThreshold", "name", "value"]),
        jarType(name: "api.TestInstance", members: ["value"]),
