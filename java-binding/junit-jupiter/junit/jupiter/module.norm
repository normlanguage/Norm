            jarOverload(name: "assertEquals", parameterTypes: ["int", "int"]),
            jarOverload(name: "assertEquals", parameterTypes: ["int", "int", "java.lang.String"]),
            jarOverload(name: "assertEquals", parameterTypes: ["long", "long"]),
            jarOverload(name: "assertEquals", parameterTypes: ["double", "double"]),
