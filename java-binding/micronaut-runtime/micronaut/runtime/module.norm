Module module() {
  return module(
    name: "micronaut.runtime",
    version: 1,
    binding: jarBinding(
      target: mavenJar(
        group: "io.micronaut",
        artifact: "micronaut-context",
        version: "5.1.13",
        resolution: sha256("8f19d657612a3bb7655fd86621d0f394b42a1e4534fa0a5f8182321b7f711cb8")
      ),
      api: [
        jarType(
          name: "runtime.server.EmbeddedServer",
          members: ["getHost", "getPort", "getURI", "isServer"]
        )
      ]
    )
  )
}
