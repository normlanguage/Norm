<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <AssemblyName>native-host</AssemblyName>
    <RootNamespace>Norm.Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Norm.Launcher/ApplicationPayload.cs" Link="ApplicationPayload.cs" />
    <Compile Include="../Norm.Launcher/NativeApplication.cs" Link="NativeApplication.cs" />
    <Compile Include="../Norm.Launcher/RuntimeExtractor.cs" Link="RuntimeExtractor.cs" />
    <Compile Include="../Norm.Launcher/ApplicationProcess.cs" Link="ApplicationProcess.cs" />
    <Compile Include="../Norm.Launcher/WindowsProcessJob.cs" Link="WindowsProcessJob.cs" />
  </ItemGroup>
</Project>
