<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <AssemblyName>norm</AssemblyName>
    <RootNamespace>Norm.Launcher</RootNamespace>
    <NormVersion Condition="'$(NormVersion)' == ''">0.0.0-dev</NormVersion>
    <Version>$(NormVersion)</Version>
    <ApplicationIcon Condition="'$(NormPayloadPath)' != ''">../../../docs/public/brand/norm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(NormPayloadPath)' != ''">
    <EmbeddedResource Include="$(NormPayloadPath)" LogicalName="Norm.Runtime.zip" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Norm.Launcher.Tests" />
  </ItemGroup>
</Project>
